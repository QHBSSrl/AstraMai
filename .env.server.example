# AstraMai 服务端环境变量示例
#
# 复制成 .env.server 再填真实值：
#   cp .env.server.example .env.server
#
# ⚠️ .env.server 里是真实密钥，已在 .gitignore 中忽略，不要提交。

# ── 必填 ────────────────────────────────────────────────────────────────

# 落雪查分器的开发者密钥。**只在服务端保存**，不会下发给浏览器或手表。
LXNS_API_KEY=

# ── 鉴权模式 ────────────────────────────────────────────────────────────

# key  —— 需要访问令牌（默认，适合私有部署）
# open —— 不校验令牌，面向**公开分发的 App**
#
# 为什么需要 open：令牌写进客户端包里就不再是秘密，谁拿到 App 都能解出来，
# 把它当门禁只是自欺欺人。公开分发时真正的约束是限流。
#
# ⚠️ open 模式下任何人都能用我们这台服务器查分，消耗的是我们的开发者密钥配额。
# 只在上游配额谈妥之后再切。切之前先确认下面两道限流都配好了。
AUTH_MODE=key

# ── 访问令牌（仅 AUTH_MODE=key 时有效）──────────────────────────────────

# 支持多个，逗号分隔：发给不同的人用不同的口令，某一个泄露了单独停掉即可。
# API_TOKEN（单数）是兼容写法。
#
# 生成一个：
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_TOKENS=

# ── 数据源 ──────────────────────────────────────────────────────────────

# auto：有密钥走真实接口，没有则降级为模拟数据
# live：强制真实接口（缺密钥直接启动失败，避免静默给出假数据）
# mock：强制模拟数据，方便离线开发
LXNS_MODE=auto

# ── 运行参数 ────────────────────────────────────────────────────────────

PORT=8787
HOST=0.0.0.0

# 是否允许客户端（浏览器/手表）递交自己的密钥。生产环境建议 false。
ALLOW_CLIENT_KEY=false

# 每个来源 IP 每分钟允许的请求数，0 表示不限流
RATE_LIMIT_PER_MINUTE=120

# 全局上游预算：每分钟最多向**每个数据源**发多少次请求，**与有多少客户端无关**。
#
# 存在的理由：公开分发的 App 里的令牌拦不住用量；万一有人写脚本刷，
# 烧的是我们自己的开发者密钥配额，上游会返回 429。
# 只统计真正打到上游的请求，命中曲库缓存的请求不消耗预算。
#
# 换算：一次 B50 查询 = 2 次上游调用，所以 150 ≈ 每分钟 75 次查询。
# 各源分别计数——不同上游的配额是各自的，共用一个会让彼此拖死。
# 设为 0 关闭。
UPSTREAM_LIMIT_PER_MINUTE=150

# 曲库缓存时长（秒）。落雪曲库变动很慢，调大能明显减少上游请求。
SONG_CACHE_TTL=21600
