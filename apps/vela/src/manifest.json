{
  "package": "com.astranexus.astramai",
  "name": "AstraMai",
  "icon": "/common/icon.png",
  "versionName": "0.1.3debug1",
  "versionCode": 10301,
  "minAPILevel": 2,
  "deviceTypeList": [
    "watch",
    "band"
  ],
  "features": [
    {
      "name": "system.fetch"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.file"
    },
    {
      "name": "system.vibrator"
    },
    {
      "name": "system.router"
    },
    {
      "name": "system.device"
    },
    {
      "name": "system.audio"
    },
    {
      "name": "system.crypto"
    },
    {
      "name": "system.interconnect"
    }
  ],
  "config": {
    "designWidth": 466,
    "logLevel": "log"
  },
  "display": {
    "backgroundColor": "#070b16"
  },
  "router": {
    "entry": "pages/Index",
    "pages": {
      "pages/Index": {
        "component": "index",
        "path": "/"
      },
      "pages/Qr": {
        "component": "qr",
        "path": "/qr"
      },
      "pages/B50": {
        "component": "b50",
        "path": "/b50"
      },
      "pages/Search": {
        "component": "search",
        "path": "/search"
      },
      "pages/Song": {
        "component": "song",
        "path": "/song"
      },
      "pages/Sync": {
        "component": "sync",
        "path": "/sync"
      },
      "pages/Settings": {
        "component": "settings",
        "path": "/settings"
      },
      "pages/PhigrosLogin": {
        "component": "phigros-login",
        "path": "/phigros-login"
      },
      "pages/Welcome": {
        "component": "welcome",
        "path": "/welcome"
      },
      "pages/Push": {
        "component": "push",
        "path": "/push"
      },
      "pages/Diff": {
        "component": "diff",
        "path": "/diff"
      },
      "pages/Plan": {
        "component": "plan",
        "path": "/plan"
      }
    }
  },
  "permissions": [
    {
      "name": "hapjs.permission.DEVICE_INFO"
    }
  ]
}
