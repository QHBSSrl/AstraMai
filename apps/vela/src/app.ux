<script>
  /**
   * 应用入口。
   *
   * ⚠️ 这里必须有 <script> 标签。
   *
   * 踩过的坑：曾经把本文件写成裸的 ES module（直接 `export default {...}`，
   * 没有 `<script>` 包裹）。构建照样成功，但整段脚本被静默丢弃，
   * 编译产物里 `$app_script$` 是空函数，随后 `$app_exports$.default.style`
   * 抛 `TypeError: cannot read property 'style' of undefined`，
   * 运行时直接 `Abort App` —— 表现就是**纯黑屏，且控制台没有任何应用日志**。
   *
   * `onError` 不是装饰：没有它的时候，应用初始化失败是静默的。
   * 现在它还负责把错误**打回服务端**——真机拿不到日志，
   * 这是唯一能看到「到底报了什么」的通道。
   */

  // 共享模块统一挂到 global（官方《内存优化》建议）。
  // 页面各自 import 会让每个页面都打一份，手表内存扛不住。
  import './common/global.js';

  const { diag, screenSize } = global.AstraMai;

  export default {
    onCreate() {
      /*
       * 把 console 的 warn/error 收进诊断缓冲。
       *
       * 只收不发 —— 真正上传要等报错时带上前后 3 分钟。
       * 放在最前面，这样初始化阶段的日志也能记下来。
       */
      diag.hookConsole();

      console.debug('[ORhythm] app onCreate');
      diag.mark('app:onCreate');

      /*
       * 探一次设备信息，结果缓存在 screenSize 里。
       *
       * 字号倍率要靠它算 —— designWidth 466 在 336 宽的手环上会被
       * 缩到 0.72，字比手表小 28%，这是「看着费劲」的真正原因。
       *
       * 异步接口，这里只发起；页面渲染时读缓存，读不到就按 1.0。
       * 成功时会打一行 device 日志，真机上能确认 screenWidth 的单位。
       */
      screenSize.probe();
    },

    onError(error) {
      // 不同版本传进来的东西形状不一样，尽量把能拿到的都打出来
      try {
        const message = error && (error.message || error.stack) ? error.message : String(error);
        console.error('[AstraMai] app onError:', message);
        if (error && error.stack) console.error(error.stack);
        if (error && error.name) console.error('name =', error.name);
      } catch (loggingError) {
        console.error('[AstraMai] app onError（打印失败）:', loggingError);
      }
      // 上报是 best-effort：真机上这是唯一能把错误带出来的途径
      diag.reportError('app:onError', error);
    },

    onDestroy() {
      console.debug('[AstraMai] app onDestroy');
      diag.mark('app:onDestroy');
    },
  };
</script>
