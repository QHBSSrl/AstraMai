<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="b50-page">
    <!--
      显式返回键。
      手表上没有可见的返回入口，用户得先知道「从边缘侧滑」这个隐藏手势才能回去；
      不知道的人会到处找按钮，找不到就只能大退应用重进。模拟器上更是没有侧滑手势。
    -->
    <div class="topbar">
      <div class="back" @click="onBack">
        <text class="back__text">‹ 返回</text>
      </div>
      <text class="topbar__title">Best 50</text>
    </div>

    <!-- ── 查询目标 ─────────────────────────────────────────────── -->
    <div class="kinds">
      <div class="kind {{ kind === 'friendCode' ? 'kind--on' : '' }}" @click="setKind('friendCode')">
        <text class="kind__text">好友码</text>
      </div>
      <div class="kind {{ kind === 'qq' ? 'kind--on' : '' }}" @click="setKind('qq')">
        <text class="kind__text">QQ 号</text>
      </div>
    </div>

    <div class="target">
      <text class="target__value">{{ displayValue }}</text>
      <text class="target__hint">{{ hint }}</text>
    </div>

    <div class="actions">
      <div class="action {{ canSubmit ? '' : 'action--disabled' }}" @click="query">
        <text class="action__text">查询</text>
      </div>
      <div class="action action--ghost" @click="toggleKeyboard">
        <text class="action__text">{{ keyboardHidden ? '输入' : '收起' }}</text>
      </div>
    </div>

    <text class="error" if="{{ errorText }}">{{ errorText }}</text>

    <!-- ── 结果 ─────────────────────────────────────────────────── -->
    <block if="{{ hasResult }}">
      <div class="summary">
        <div class="summary__main">
          <text class="rating">{{ ratingText }}</text>
          <text class="tier">{{ tierText }}</text>
        </div>
        <div class="summary__side">
          <text class="line">旧曲 B35　{{ b35Text }}</text>
          <text class="line">新曲 B15　{{ b15Text }}</text>
          <text class="line">平均定数　{{ avgLevelText }}</text>
          <text class="line">公式对拍　{{ selfCheckText }}</text>
        </div>
      </div>

      <!-- <list> 必须显式给高度，否则高度为 0、成绩一条都画不出来 -->
      <list class="list" onscrollbottom="onScrollBottom">
        <list-item class="row" type="item" for="{{ entries }}">
          <text class="row__rank">{{ $idx + 1 }}</text>
          <image class="row__cover" src="{{ $item.jacketUrl }}"></image>
          <div class="row__main">
            <text class="row__title">{{ $item.title }}</text>
            <text class="row__sub" style="color: {{ $item.diffColor }}">{{ $item.difficulty }} · 定数 {{ $item.levelValue }}</text>
            <text class="row__version">版本 {{ $item.versionTitle }}</text>
          </div>
          <div class="row__right">
            <text class="row__rating">{{ $item.rating }}</text>
            <text class="row__ach">{{ $item.achievements }}</text>
          </div>
        </list-item>
      </list>
    </block>

    <!--
      完整输入法。好友码是纯数字，用它的「123」数字键盘即可；
      这样全应用只有一套输入组件，不必为不同输入各写一个键盘。
    -->
    <input-method
      hide="{{ keyboardHidden }}"
      keyboardtype="QWERTY"
      screentype="rect"
      vibratemode="short"
      maxlength="5"
      @complete="onComplete"
      @delete="onDelete"
    ></input-method>
  </div>
</template>

<style>
  .b50-page {
    flex-direction: column;
    padding: 14px;
    background-color: #070b16;
  }

  /* 返回键。做够大，手表上要好点。 */
  .topbar {
    flex-direction: row;
    align-items: center;
    height: 56px;
    margin-bottom: 4px;
  }

  .back {
    padding: 8px 20px;
    border-radius: 22px;
    background-color: #1c2740;
  }

  .back__text {
    font-size: 22px;
    color: #e8eefc;
  }

  .topbar__title {
    font-size: 22px;
    color: #9bacd0;
    margin-left: 14px;
  }

  .kinds {
    flex-direction: row;
    justify-content: center;
  }

  .kind {
    padding: 10px 26px;
    margin: 0 6px;
    border-radius: 24px;
    background-color: #141d30;
  }

  .kind--on {
    background-color: #1c2740;
  }

  .kind__text {
    font-size: 22px;
    color: #9bacd0;
  }

  .kind--on .kind__text {
    color: #e8eefc;
  }

  .target {
    flex-direction: column;
    align-items: center;
    margin-top: 12px;
    padding: 14px;
    border-radius: 14px;
    background-color: #141d30;
  }

  .target__value {
    font-size: 32px;
    color: #e8eefc;
  }

  .target__hint {
    font-size: 17px;
    color: #6d7fa3;
    margin-top: 4px;
  }

  .actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
  }

  .action {
    height: 68px;
    padding: 0 34px;
    margin: 0 6px;
    border-radius: 34px;
    background-color: #ff5f9e;
    align-items: center;
    justify-content: center;
  }

  .action--ghost {
    background-color: #1c2740;
  }

  .action--disabled {
    background-color: #2a2f42;
  }

  .action__text {
    font-size: 26px;
    color: #1a0710;
  }

  .action--ghost .action__text {
    color: #e8eefc;
  }

  .action--disabled .action__text {
    color: #6d7fa3;
  }

  .error {
    font-size: 18px;
    color: #f87171;
    margin-top: 8px;
    text-align: center;
  }

  .summary {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    padding: 16px;
    border-radius: 14px;
    background-color: #141d30;
  }

  .summary__main {
    flex-direction: column;
    align-items: center;
    width: 150px;
  }

  .rating {
    font-size: 40px;
    font-weight: bold;
    color: #f5c542;
  }

  .tier {
    font-size: 18px;
    color: #f5c542;
  }

  .summary__side {
    flex-direction: column;
    flex: 1;
    margin-left: 12px;
  }

  .line {
    font-size: 18px;
    color: #9bacd0;
    margin-bottom: 4px;
  }

  .list {
    width: 100%;
    /* <list> 必须显式给高度，否则高度为 0，一条都画不出来 */
    height: 190px;
    margin-top: 12px;
  }

  .row {
    flex-direction: row;
    align-items: center;
    height: 96px;
    padding: 6px 8px;
  }

  /* 封面。定死尺寸，避免图片加载前后布局跳动。 */
  .row__cover {
    width: 58px;
    height: 58px;
    margin-left: 6px;
    background-color: #1c2740;
  }

  .row__rank {
    width: 40px;
    font-size: 18px;
    color: #6d7fa3;
  }

  .row__main {
    flex: 1;
    flex-direction: column;
  }

  .row__title {
    font-size: 20px;
    color: #e8eefc;
  }

  .row__sub {
    font-size: 16px;
    color: #6d7fa3;
  }

  /* 版本单独一行并带标签 */
  .row__version {
    font-size: 15px;
    color: #f2a33c;
    margin-top: 2px;
  }

  .row__right {
    flex-direction: column;
    align-items: flex-end;
    width: 110px;
  }

  .row__rating {
    font-size: 24px;
    font-weight: bold;
    color: #e8eefc;
  }

  .row__ach {
    font-size: 15px;
    color: #9bacd0;
  }
</style>

<script>
  // 共享模块从 global 取，不再 import（官方内存优化建议）。
  // 页面各自 import 会让每个页面都打一份，手表内存扛不住。
  const { api, core, diag, games, navigation, store, validate } = global.AstraMai;
  const { fetchB50, fetchB50ByQq, fetchChunithmBests, fetchChunithmBestsByQq } = api;
  const { chunithmDifficultyColor } = core;
  const { gameById, readCurrentGame } = games;
  const { mark } = diag;
  const { goBack } = navigation;
  const { readSetting, warmUp, writeSetting } = store;
  const { appendDigit, backspace, describeInput, isReadyToSubmit, normalizeDigits } = validate;

  /**
   * 每页条数。
   * 官方《常用业务优化》：list 内容超过 10 条建议分页渲染。
   */
  const PAGE_SIZE = 10;

  /**
   * 全部曲目成绩。放在脚本作用域而不是 viewModel：
   * 它是纯数据、不需要响应式，塞进 viewModel 只会多一层 observer
   * （官方《内存优化》第 1 条）。
   */
  let allEntries = [];
  let shownCount = 0;

  /** 难度配色，与游戏内一致：绿 / 黄 / 红 / 紫 / 白。 */
  const DIFFICULTY_COLOR = ['#7ee081', '#f5d547', '#f2564b', '#b06fe8', '#f2f2f2'];

  export default {
    private: {
      kind: 'friendCode',
      code: '',
      keyboardHidden: true,

      hint: '',
      canSubmit: false,
      errorText: '',
      saving: '',
      displayValue: '输入好友码',

      hasResult: false,
      ratingText: '',
      tierText: '',
      statLine1: '',
      statLine2: '',
      statLine3: '',
      statLine4: '',
      /** 当前游戏 id。决定请求哪个接口、以及统计行怎么写。 */
      gameId: 'maimai',
      entries: [],
    },

    /** 返回上一页。失败也不会把用户困住——goBack 内部会兜底跳首页。 */
    onBack() {
      goBack('/');
    },

    onReady() {
      mark('B50:onReady');
    },

    onInit() {
      mark('B50:onInit');
      console.debug('[AstraMai] B50 onInit');
      warmUp(['queryKind', 'queryValue', 'friendCode', 'currentGame'])
        .then(() => {
          // 当前游戏决定查哪个接口、统计行怎么写
          this.gameId = gameById(readCurrentGame(readSetting)).id;
          return this.restore();
        })
        .catch((error) => console.error('[AstraMai] B50 初始化失败：', error));
    },

    /**
     * 恢复上次保存的查询目标。
     *
     * 手表上输入 15 位数字很费劲，所以「存下来、下次直接用」不是锦上添花，
     * 而是这个页面能不能用的前提。
     */
    restore() {
      const savedKind = readSetting('queryKind', 'friendCode');
      this.kind = savedKind === 'qq' ? 'qq' : 'friendCode';

      // 兼容早期只存 friendCode 的版本
      const saved =
        normalizeDigits(readSetting('queryValue', '')) ||
        normalizeDigits(readSetting('friendCode', ''));

      this.code = saved;
      this.refreshInputState();

      if (saved) {
        this.keyboardHidden = true;
        this.query();
      }
    },

    setKind(kind) {
      if (this.kind === kind) return;
      this.kind = kind;
      // 两种方式的长度上限不同，切换时清空，避免留下不合法的残留
      this.code = '';
      this.errorText = '';
      this.hasResult = false;
      this.keyboardHidden = false;
      this.refreshInputState();
    },

    toggleKeyboard() {
      this.keyboardHidden = !this.keyboardHidden;
    },

    refreshInputState() {
      const described = describeInput(this.kind, this.code);
      this.hint = described.text + (this.saving ? ` · ${this.saving}` : '');
      this.canSubmit = isReadyToSubmit(this.kind, this.code);
      this.displayValue = this.code
        ? this.code
        : this.kind === 'qq'
          ? '输入 QQ 号'
          : '输入好友码';
    },

    /** 只监听 complete：keyDown 会在拼音模式下把字母也报上来，两个都听会重复输入。 */
    onComplete(evt) {
      const content = evt && evt.detail ? evt.detail.content : '';
      const before = this.code;
      this.code = appendDigit(this.kind, this.code, content);
      if (this.code === before && normalizeDigits(content) === '' ) {
        // 输入了非数字字符，提示一下而不是静默吞掉
        this.hint = this.kind === 'qq' ? 'QQ 号只能是数字' : '好友码只能是数字';
        return;
      }
      this.refreshInputState();
    },

    onDelete() {
      this.code = backspace(this.code);
      this.refreshInputState();
    },

    query() {
      const code = normalizeDigits(this.code);
      if (!isReadyToSubmit(this.kind, code)) {
        this.errorText = this.kind === 'qq' ? 'QQ 号应为 5–11 位数字' : '好友码应为 15 位数字';
        this.keyboardHidden = false;
        return;
      }

      this.errorText = '';
      this.keyboardHidden = true;

      // 落盘：下次打开直接可用
      writeSetting('queryKind', this.kind);
      writeSetting('queryValue', code);
      if (this.kind === 'friendCode') writeSetting('friendCode', code);

      const request =
        this.gameId === 'chunithm'
          ? this.kind === 'qq'
            ? fetchChunithmBestsByQq(code)
            : fetchChunithmBests(code)
          : this.kind === 'qq'
            ? fetchB50ByQq(code)
            : fetchB50(code);
      request
        .then((view) => {
          this.apply(view);
          this.saving = '';
          this.refreshInputState();
        })
        .catch((error) => {
          this.errorText = error && error.message ? error.message : '查询失败';
          this.hasResult = false;
          this.keyboardHidden = false;
        });
    },

    apply(view) {
      if (this.gameId === 'chunithm') {
        this.applyChunithm(view);
        return;
      }
      this.applyMaimai(view);
    },

    /** 舞萌：B35 + B15 合成 B50。 */
    applyMaimai(view) {
      const stats = view.stats;
      const player = view.player;

      this.ratingText = String(player.rating);
      this.tierText = player.tier ? player.tier.label : '';
      this.statLine1 = '旧曲 B35　' + stats.standardTotal;
      this.statLine2 = '新曲 B15　' + stats.dxTotal;
      this.statLine3 = '平均定数　' + stats.averageLevelValue.toFixed(2);
      this.statLine4 = '公式对拍　' + (stats.computedDelta === 0 ? '一致' : '差 ' + stats.computedDelta);

      // 官方《常用业务优化》：list 内容超过 10 条建议分页渲染，
      // 切勿初始化渲染大量数据，会造成页面渲染卡顿。
      // 所以先渲染一页，其余等触底再追加。
      allEntries = view.standard
        .concat(view.dx)
        .sort((a, b) => (b.rating || 0) - (a.rating || 0))
        .map((entry) => ({
          title: entry.title,
          difficulty: entry.difficultyShort,
          // 难度配色与游戏内一致：绿 / 黄 / 红 / 紫 / 白
          diffColor: DIFFICULTY_COLOR[entry.levelIndex] || '#9bacd0',
          levelValue: entry.levelValue === null ? '--' : entry.levelValue.toFixed(1),
          rating: entry.rating === null ? '--' : String(entry.rating),
          achievements: entry.achievements.toFixed(4) + '%',
          // 封面直链（已裁剪到列表尺寸），服务端组装 B50 视图时已经带上
          jacketUrl: entry.jacketUrl || '',
          // 版本名由 core 的 versionTitleOf 解析（曲目里是细粒度版本号，版本表是千位步长）
          versionTitle: entry.songVersionTitle || '未知',
        }));

      this.finishApply();
    },

    /**
     * 中二节奏：B30 + Selection10 + Recent10。
     *
     * **三组并列进同一个列表**，而不是像舞萌那样合成一个榜单：
     * 它们的意义不同（Best / 选拔 / 最近），合成会让玩家看不出哪条是 Best。
     * 排序按 Rating 降序，这样 Best 30 自然排在最前。
     */
    applyChunithm(view) {
      const stats = view.stats;
      const player = view.player;

      this.ratingText = String(player.rating);
      // 中二没有「段位」这种概念，玩家等级才是名片上的东西
      this.tierText = player.level ? '等级 ' + player.level : '';
      this.statLine1 = 'Best 30　' + stats.bestsCount;
      this.statLine2 = 'Selection 10　' + stats.selectionsCount;
      this.statLine3 = 'Recent 10　' + stats.recentsCount;
      this.statLine4 = 'B30 Rating 合计　' + stats.bestsRatingSum;

      allEntries = view.bests
        .concat(view.selections)
        .sort((a, b) => (b.rating || 0) - (a.rating || 0))
        .map((entry) => ({
          title: entry.title,
          difficulty: entry.difficultyShort,
          // 中二是六档下标，WE 用金色单独标出（它是特殊谱面，不是第六档难度）
          diffColor: chunithmDifficultyColor(entry.levelIndex),
          levelValue: entry.levelValue === null ? '--' : entry.levelValue.toFixed(1),
          // 中二的 Rating 由接口直接给出（浮点），保留两位
          rating: entry.rating ? entry.rating.toFixed(2) : '--',
          // 中二看的是分数而不是达成率
          achievements: String(entry.points),
          jacketUrl: entry.jacketUrl || '',
          // 中二视图没有逐条的版本名，显示难度全称更有用
          versionTitle: entry.difficultyName + (entry.isWorldsEnd ? ' · 特殊谱面' : ''),
        }));

      this.finishApply();
    },

    /** 两个游戏共用的收尾：分页渲染 + 标记有结果。 */
    finishApply() {
      // 原地清空再追加，避免整份重新赋值开辟新内存（官方《内存优化》第 2 条）
      this.entries.length = 0;
      shownCount = 0;
      this.appendPage();
      this.hasResult = true;
    },

    /** 追加一页。触底时也会调这里。 */
    appendPage() {
      const next = allEntries.slice(shownCount, shownCount + PAGE_SIZE);
      for (const item of next) this.entries.push(item);
      shownCount += next.length;
    },

    /** 触底加载下一页。 */
    onScrollBottom() {
      if (shownCount < allEntries.length) this.appendPage();
    },
  };
</script>
