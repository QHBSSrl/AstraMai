<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>
<import name="score-summary" src="../../components/ScoreSummary/ScoreSummary.ux"></import>

<template>
  <div class="page-root">
    <div class="b50-page">
    <!--
      显式返回键。
      手表上没有可见的返回入口，用户得先知道「从边缘侧滑」这个隐藏手势才能回去；
      不知道的人会到处找按钮，找不到就只能大退应用重进。模拟器上更是没有侧滑手势。
    -->
    <div class="topbar">
      <div class="back" @click="onBack">
        <text class="back__text">‹ 返回</text>
      </div>
      <text class="topbar__title">{{ pageTitle }}</text>
    </div>

    <!--
      查询目标。**Phigros 整块隐藏**——它靠 TapTap 扫码登录，查的是自己，
      根本没有「输入一个码」这回事。留着只占地方，还会让人以为要输好友码。
    -->
    <!--
      输入块按游戏声明的 `queryKinds` 渲染：
        舞萌/中二 → 好友码 / QQ 号 两个选项卡
        osu       → 只有「用户名」，选项卡不必显示
        Phigros   → 没有输入（扫码登录），整块不渲染
    -->
    <block if="{{ kinds.length > 0 }}">
      <div class="kinds" if="{{ kinds.length > 1 }}">
        <div class="kind {{ kind === $item.id ? 'kind--on' : '' }}" for="{{ kinds }}" @click="setKind($item.id)">
          <text class="kind__text{{ kind === $item.id ? ' kind__text--on' : '' }}">{{ $item.label }}</text>
        </div>
      </div>

      <div class="target">
        <text class="target__value">{{ displayValue }}</text>
        <text class="target__hint">{{ hint }}</text>
      </div>
    </block>

    <div class="actions">
      <div class="action {{ canSubmit || gameId === 'phigros' ? '' : 'action--disabled' }}" @click="query">
        <text class="action__text {{ canSubmit || gameId === 'phigros' ? 'action__text--filled' : 'action__text--disabled' }}">{{ gameId === 'phigros' ? '查询自己的成绩' : '查询' }}</text>
      </div>
      <!-- 输入按钮对 Phigros 也没意义（没有要输入的码） -->
      <div class="action action--ghost" if="{{ kinds.length > 0 }}" @click="toggleKeyboard">
        <text class="action__text action__text--ghost">{{ keyboardHidden ? '输入' : '收起' }}</text>
      </div>
    </div>

    <text class="error" if="{{ errorText }}">{{ errorText }}</text>

    <!-- ── 结果 ─────────────────────────────────────────────────── -->
    <block if="{{ hasResult }}">
      <!--
        成绩卡抽成组件了。

        **为什么要抽**：这张卡的高度以前由内容撑开，而三个游戏塞进来的
        行数不一样（Phigros 的大数字要拆整数/小数两段），
        所以切一次游戏整块卡片就变高变矮，**把下面的列表挤到看不见**。

        现在高度写在组件的样式里（固定 132px），页面只负责往固定的槽位
        填东西——**不管数据长什么样，布局都不会动**。

        页面这边的字段名没变（playerName / ratingInt / ratingDec /
        ratingText / tierText / statLine1..4），所以 apply* 那几个方法
        一行都不用改。
      -->
      <score-summary
        name="{{ playerName }}"
        value="{{ ratingInt || ratingText }}"
        valueDecimal="{{ ratingDec }}"
        caption="{{ tierText }}"
        line1="{{ statLine1 }}"
        line2="{{ statLine2 }}"
        line3="{{ statLine3 }}"
        line4="{{ statLine4 }}"
        line5="{{ statLine5 }}"
      ></score-summary>

      <!--
        成绩对比：这次和上次查的比。
        放在成绩卡和列表之间，**只在有变化时渲染**——
        显示"较上次持平"既占地方又没信息量。

        点它进「对比详情」（哪几首涨了/跌了）。
      -->
      <text class="diff" if="{{ diffLine }}" @click="openDiff">{{ diffLine }} ›</text>

      <!-- <list> 必须显式给高度，否则高度为 0、成绩一条都画不出来 -->
      <list class="list" onscrollbottom="onScrollBottom">
        <list-item class="row" type="item" for="{{ entries }}" @click="openPush($item)">
          <text class="row__rank">{{ $idx + 1 }}</text>
          <!-- 没有图就不渲染：Phigros 平台不提供曲绘，渲染空的 <image> 会显示成灰块 -->
          <image class="row__cover" if="{{ $item.jacketUrl }}" src="{{ $item.jacketUrl }}"></image>
          <div class="row__main">
            <text class="row__title">{{ $item.title }}</text>
            <text class="row__sub" style="color: {{ $item.diffColor }}">{{ $item.difficulty }} · {{ levelLabel }} {{ $item.levelValue }}</text>
            <text class="row__version">{{ versionPrefix }} {{ $item.versionTitle }}</text>
          </div>
          <div class="row__right">
            <text class="row__rating">{{ $item.rating }}</text>
            <text class="row__ach">{{ $item.achievements }}</text>
          </div>
        </list-item>
      </list>
    </block>

    <!--
      完整输入法。好友码是纯数字，用它的「123」数字键盘即可；
      这样全应用只有一套输入组件，不必为不同输入各写一个键盘。
    -->
    </div>

    <!-- 键盘提到根容器下：它靠 position:absolute 的 left:0/width:100% 定位，
         父容器一旦有 padding 就会缩进去，真机上右边留一条缝。 -->
    <input-method
      hide="{{ keyboardHidden }}"
      keyboardtype="QWERTY"
      screentype="rect"
      vibratemode="short"
      maxlength="5"
      @complete="onComplete"
      @delete="onDelete"
    ></input-method>
  </div>
</template>

<style lang="less">
  @import '../../common/theme-tokens.less';

  /*
   * 页面根容器：**全幅、零内边距**。
   * 输入法是它的直接子元素，靠 position:absolute 的 left:0/width:100% 定位，
   * 父容器有内边距的话键盘就会跟着缩进去——真机上右边会留一条缝。
   * 所以内边距放在内层的 .b50-page 上，这一层专门给键盘当定位基准。
   */
  .page-root {
    /*
     * ⚠️ **必须显式写 flex-direction: column。**
     * Vela 的 div 默认是 `flex-direction: row`（不是网页里的 block），
     * 不写就会把内层页面和键盘摆成横向一排——内层被压窄，
     * 而它内部是纵向布局，结果所有内容挤在一起重叠。
     */
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    background-color: @ui-surface;
  }

  .b50-page {
    /* 吃掉剩余高度、横轴拉满——键盘是 absolute，不占流式空间 */
    flex: 1;
    width: 100%;
    flex-direction: column;
    padding: 14px;
    background-color: @ui-surface;
  }

  /* 返回键。做够大，手表上要好点。 */
  .topbar {
    flex-direction: row;
    align-items: center;
    height: 56px;
    margin-bottom: 4px;
  }

  .back {
    padding: 8px 20px;
    border-radius: 22px;
    background-color: @ui-surface-container;
  }

  .back__text {
    font-size: 22px;
    color: @ui-on-surface;
  }

  .topbar__title {
    font-size: 22px;
    color: @ui-on-surface-variant;
    margin-left: 14px;
  }

  .kinds {
    flex-direction: row;
    justify-content: center;
  }

  .kind {
    padding: 10px 26px;
    margin: 0 6px;
    border-radius: 24px;
    background-color: @ui-surface-card;
  }

  .kind--on {
    background-color: @ui-surface-container;
  }

  .kind__text {
    /* 只留尺寸，颜色拆到变体上——和后按钮同一个理由 */
    font-size: 22px;
  }

  .kind__text--on {
    color: @ui-on-primary;
  }


  .target {
    flex-direction: column;
    align-items: center;
    margin-top: 12px;
    padding: 14px;
    border-radius: 14px;
    background-color: @ui-surface-card;
  }

  .target__value {
    font-size: 32px;
    color: @ui-on-surface;
  }

  .target__hint {
    font-size: 17px;
    color: @ui-on-surface-variant;
    margin-top: 4px;
  }

  .actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
  }

  .action {
    height: 68px;
    padding: 0 34px;
    margin: 0 6px;
    border-radius: 34px;
    background-color: @ui-primary;
    align-items: center;
    justify-content: center;
  }

  .action--ghost {
    background-color: @ui-surface-container;
  }

  .action--disabled {
    background-color: @ui-outline;
  }

  .action__text {
    /* 只留尺寸。**颜色必须拆到变体类上**——
       写在基类里会和变体规则打架，谁赢取决于编译顺序。 */
    font-size: 26px;
  }

  /* 主按钮上的文字：深色，压在粉色底上 */
  .action__text--filled {
    color: @ui-on-primary;
  }

  /* 次要按钮上的文字：浅色，压在深色底上 */
  .action__text--ghost {
    color: @ui-on-surface;
  }

  /* 禁用态：中间灰。**不再借用 opacity**，手表上小字号容易糊 */
  .action__text--disabled {
    color: @ui-on-surface-variant;
  }



  .error {
    font-size: 18px;
    color: @ui-error;
    margin-top: 8px;
    text-align: center;
  }





  /*
   * 玩家名。
   *
   * `.summary__main` 固定 150px，"CHUNITHM" 这种长名字在 20px 下放不下，
   * 会折成两行、把下面的评级挤下去——看起来就是「内容往里缩」。
   *
   * `lines: 1` + 省略号：宁可截断，也不要换行改变布局。
   */




  /*
   * 小数部分：和整数同一行、靠底对齐。
   *
   * 成绩类 UI 的常见做法——整数是主信息、要大；小数是细节、要小。
   * 两个都 40px 的话，"15.7888" 需要约 190px，150px 的列放不下。
   */










  /*
   * 成绩对比那一行。
   *
   * 只在有变化时才渲染（模板里 `if="{{ diffLine }}"`），所以这里不用考虑
   * "隐藏时占位"的问题 —— 没变化时它压根不存在。
   *
   * 高度固定 34px：它出现时列表会被 flex 压缩同样的高度，
   * 而不是把整个页面顶下去。
   */
  .diff {
    width: 100%;
    height: 34px;
    font-size: 15px;
    color: @ui-primary;
    text-align: center;
    lines: 1;
  }

  .list {
    width: 100%;
    /*
     * **用 flex: 1，不吃固定高度。**
     *
     * 成绩卡现在由 `<score-summary>` 组件负责，**高度固定 132px**，
     * 所以上面那一坨（顶栏 + 输入 + 按钮 + 成绩卡）的总高度是**稳定的**，
     * 列表拿到的「剩余高度」也就是稳定的——
     * **这才是「不管怎么查都不压缩」真正成立的原因**。
     *
     * `min-height` 是兜底：万一哪天上面的块又变回随内容撑开，
     * 至少保证列表还能看见一行，而不是被压成 0。
     */
    flex: 1;
    min-height: 110px;
    margin-top: 10px;
  }

  .row {
    flex-direction: row;
    align-items: center;
    /* 96 太高：一行只放三行文字（19 + 15 + 14），82 够了 */
    height: 82px;
    padding: 4px 8px;
  }

  /* 封面。定死尺寸，避免图片加载前后布局跳动。 */
  .row__cover {
    width: 58px;
    height: 58px;
    margin-left: 6px;
    background-color: @ui-surface-container;
  }

  .row__rank {
    width: 40px;
    font-size: 18px;
    color: @ui-on-surface-variant;
  }

  .row__main {
    flex: 1;
    flex-direction: column;
  }

  .row__title {
    font-size: 19px;
    color: @ui-on-surface;
    /*
     * 日文曲名很长。行的横向预算只剩 174px（432 − 28 页边距 − 40 排名
     * − 64 封面 − 110 右侧 − 16 内边距），不限制会换行把下面的定数压掉。
     */
    lines: 1;
    text-overflow: ellipsis;
  }

  .row__sub {
    font-size: 15px;
    color: @ui-on-surface-variant;
    lines: 1;
    text-overflow: ellipsis;
  }

  /* 版本单独一行并带标签 */
  .row__version {
    font-size: 14px;
    color: @ui-warning;
    margin-top: 1px;
    lines: 1;
    text-overflow: ellipsis;
  }

  .row__right {
    flex-direction: column;
    align-items: flex-end;
    /* 110 → 92：把横向预算让给曲名；评级字号也跟着降一点 */
    width: 92px;
  }

  .row__rating {
    font-size: 22px;
    font-weight: bold;
    color: @ui-on-surface;
  }

  .row__ach {
    font-size: 15px;
    color: @ui-on-surface-variant;
  }

  /*
   * ── 圆形屏适配 ─────────────────────────────────────────────────
   * 依据官方《多屏适配 · 页面标题栏》：
   *   「在圆屏、胶囊屏等存在边缘剪切的设备上，标题栏会使用多行设计，
   *     保证顶部的展示内容长度不会超出屏幕；而在矩形屏幕上则做单行左右布局。」
   *
   * 圆屏四角是物理裁掉的：466×466 的屏，顶栏中心 y≈44 处可用宽度只有约 272px，
   * 而「标题在左 + 设置在右」需要整幅 466px，两端必然被切。
   * 所以这里改竖排居中，并加左右内边距把内容压进圆内接矩形。
   *
   * **只影响 shape: circle**，矩形屏样式与行为完全不变。
   */
  @media (shape: circle) {
    .b50-page {
      padding-left: 40px;
      padding-right: 40px;
    }

    /* 顶栏改竖排居中：单行左右布局在圆屏上两端必被裁 */
    .topbar {
      flex-direction: column;
      align-items: center;
      height: auto;
    }

    /* 返回键/标题不再靠边，改为居中并留出上下间距 */
    .back {
      margin-bottom: 8px;
    }
  }
</style>

<script>
  // 共享模块从 global 取，不再 import（官方内存优化建议）。
  // 页面各自 import 会让每个页面都打一份，手表内存扛不住。
  const { api, core, diag, games, navigation, store, validate } = global.AstraMai;
  const {
    fetchB50,
    fetchB50ByQq,
    fetchChunithmBests,
    fetchChunithmBestsByQq,
    fetchOsuBests,
    fetchPhigrosBests,
  } = api;
  const { chunithmDifficultyColor } = core;
  const { gameById, readCurrentGame, queryKindsOf, b50TitleOf } = games;
  const { mark } = diag;
  const { goBack, push } = navigation;
  const { readSetting, warmUp, writeSetting } = store;
  const {
    KIND_LABELS,
    appendDigit,
    backspace,
    describeInput,
    isReadyToSubmit,
    isUsername,
    normalizeByKind,
  } = validate;

  /**
   * 每页条数。
   * 官方《常用业务优化》：list 内容超过 10 条建议分页渲染。
   */
  const PAGE_SIZE = 10;

  /**
   * 全部曲目成绩。放在脚本作用域而不是 viewModel：
   * 它是纯数据、不需要响应式，塞进 viewModel 只会多一层 observer
   * （官方《内存优化》第 1 条）。
   */
  let allEntries = [];
  let shownCount = 0;

  /** 难度配色，与游戏内一致：绿 / 黄 / 红 / 紫 / 白。 */
  const DIFFICULTY_COLOR = ['#7ee081', '#f5d547', '#f2564b', '#b06fe8', '#f2f2f2'];

  /** pp 的展示格式，和 core 里的 formatOsuPp 保持一致。 */
  function formatPp(value) {
    const pp = Number(value);
    if (!Number.isFinite(pp)) return '—';
    if (pp >= 10000) return String(Math.round(pp));
    if (pp >= 1000) return pp.toFixed(1);
    return pp.toFixed(2);
  }

  /**
   * 按星数给颜色。
   *
   * osu! 没有固定难度档位，所以用星数映射——
   * 玩家对星数的直观印象就是「越亮越难」。
   */
  function starColor(star) {
    const value = Number(star);
    if (!Number.isFinite(value) || value <= 0) return '#9bacd0';
    if (value >= 8) return '#f2564b';
    if (value >= 6.5) return '#b06fe8';
    if (value >= 5) return '#f5d547';
    if (value >= 3) return '#7ee081';
    return '#4fd6ff';
  }

  /**
   * 离线缓存最多保留几条。
   *
   * **跨游戏一起算** —— 它们共享同一份 storage 配额。
   * 定 6 是因为一份 B50 view 十几 KB，6 条约 100 KB，
   * 对穿戴设备的存储是个安全量级。
   */
  const CACHE_MAX = 6;

  /** 缓存索引的键。索引里记 `[{key, at}]`，按最近使用排序。 */
  const CACHE_INDEX_KEY = 'b50CacheIndex';

  /**
   * 最近一次对比结果的存储键。
   *
   * 只存**最后一次**，不分游戏、不分查询目标 ——
   * 对比详情页是"我刚才那次查询比上次多了什么"，
   * 用户不会回头翻三天前某个好友的对比。
   *
   * 每次查询都会先清空再写，所以不会残留旧数据。
   */
  const DIFF_KEY = 'b50LastDiff';

  /**
   * 把时间戳格式化成「10月18日 14:32」。
   *
   * 只用来标注「这是什么时候的数据」，不需要秒、不需要年份。
   *
   * ⚠️ 必须放在**模块作用域**，不能放在 `export default { ... }` 里面——
   * 那是对象字面量，里面只能有属性/方法，`function` 声明会直接语法错误
   * （构建报 `Parsing error: Unexpected keyword 'function'`）。
   */
  function formatCachedTime(timestamp) {
    const d = new Date(timestamp);
    if (Number.isNaN(d.getTime())) return '之前';
    const pad = (n) => (n < 10 ? '0' + n : String(n));
    return (
      d.getMonth() + 1 + '月' + d.getDate() + '日 ' + pad(d.getHours()) + ':' + pad(d.getMinutes())
    );
  }

  export default {
    private: {
      kind: 'friendCode',
      code: '',
      keyboardHidden: true,

      hint: '',
      canSubmit: false,
      errorText: '',
      saving: '',
      displayValue: '输入好友码',

      hasResult: false,
      ratingText: '',
      /** Phigros 专用：整数部分（放大显示）。 */
      ratingInt: '',
      /** Phigros 专用：小数部分（缩小显示），空字符串表示不走拆分分支。 */
      ratingDec: '',
      tierText: '',
      /** 玩家名。多号玩家靠它确认「看的是谁的」。 */
      playerName: '',
      statLine1: '',
      statLine2: '',
      statLine3: '',
      statLine4: '',
      statLine5: '',
      /** 成绩对比的一句话总结；空串表示不显示。 */
      diffLine: '',
      /** 当前游戏 id。决定请求哪个接口、以及统计行怎么写。 */
      gameId: 'maimai',
      /** 标题按游戏变：舞萌 Best 50 / 中二 B30 / Phigros RKS / osu Best Plays。 */
      pageTitle: 'Best 50',
      /**
       * 这个游戏支持哪些查询方式。
       *
       * 从 `gameById(...).queryKinds` 来，页面只负责渲染。
       * **不要在模板里写死「好友码 / QQ 号」**——osu 只有用户名，
       * 写死就会出现「切到 osu 还让你填好友码」。
       */
      kinds: [],
      /** 行的「定数」标签按游戏变：舞萌/中二用「定数」，osu 用「星数」。 */
      levelLabel: '定数',
      /** 行的版本标签：舞萌/中二用「版本」，osu 用「MOD」。 */
      versionPrefix: '版本',
      entries: [],
    },

    /** 返回上一页。失败也不会把用户困住——goBack 内部会兜底跳首页。 */
    onBack() {
      goBack('/');
    },

    /** 点对比那一行 → 看详情（哪几首涨了/跌了）。 */
    openDiff() {
      push('/diff');
    },

    /**
     * 点某条成绩 → 打开推分页。
     *
     * 跨页传数据走 **storage**，不用路由参数 —— 这个 App 一直是这么做的
     * （`Song` 页读 `songDetail` 也是这套）。路由参数要自己拼字符串、
     * 还得处理编码，而曲名里有空格和各种符号。
     *
     * 传的是**数值**（`raw*` 系列字段），不是模板里那些格式化过的字符串。
     */
    openPush(item) {
      if (!item) return;

      const level = typeof item.rawLevelValue === 'number' ? item.rawLevelValue : null;
      if (level === null || level <= 0) {
        // 曲库里查不到定数就没法推分 —— 直接不跳，免得打开一个空页面
        console.warn('[AstraMai] 这条成绩没有定数，无法推分');
        return;
      }

      const seed = {
        title: item.title || '',
        levelValue: level,
        achievement: typeof item.rawAchievement === 'number' ? item.rawAchievement : 0,
        rating: typeof item.rawRating === 'number' ? item.rawRating : 0,
      };

      try {
        writeSetting('pushSeed', JSON.stringify(seed));
      } catch (error) {
        console.warn('[AstraMai] 写推分种子失败：', error);
      }

      push('/push');
    },

    onReady() {
      mark('B50:onReady');
    },

    onInit() {
      mark('B50:onInit');
      console.debug('[AstraMai] B50 onInit');
      warmUp(['queryKind', 'queryValue', 'friendCode', 'currentGame', 'phigrosSession'])
        .then(() => {
          // 当前游戏决定查哪个接口、统计行怎么写
          this.gameId = gameById(readCurrentGame(readSetting)).id;
          this.applyGameProfile();
          // Phigros 没有要输入的码，键盘一律收起（也省掉一个组件的初始化开销）
          if (this.kinds.length === 0) this.keyboardHidden = true;
          return this.restore();
        })
        .catch((error) => console.error('[AstraMai] B50 初始化失败：', error));
    },

    /**
     * 按当前游戏把「标题 / 输入方式 / 行标签」一次配好。
     *
     * 集中在一处改：这三个东西都**跟着游戏变**，散在各处一定会漏。
     */
    applyGameProfile() {
      const game = gameById(this.gameId);

      this.pageTitle = b50TitleOf(game);
      this.kinds = queryKindsOf(game).map((id) => ({
        id,
        label: KIND_LABELS[id] ?? id,
      }));

      if (this.gameId === 'osu') {
        // osu! 的成绩行里：没有「定数」（是星数），没有「版本」（是 MOD）
        this.levelLabel = '★';
        this.versionPrefix = 'MOD';
      } else {
        this.levelLabel = '定数';
        this.versionPrefix = '版本';
      }
    },

    /**
     * 恢复上次保存的查询目标。
     *
     * 手表上输入 15 位数字很费劲，所以「存下来、下次直接用」不是锦上添花，
     * 而是这个页面能不能用的前提。
     */
    restore() {
      /*
       * 只能用**当前游戏支持**的查询方式。
       *
       * 上次可能是在舞萌页存的 'qq'，这次切到 osu 就不认了——
       * 不校验的话会出现「输入框让你填 QQ 号但其实在查 osu」。
       */
      const savedKind = readSetting('queryKind', '');
      const allowed = this.kinds.map((item) => item.id);
      this.kind = allowed.indexOf(savedKind) >= 0 ? savedKind : allowed.length > 0 ? allowed[0] : 'friendCode';

      // 兼容早期只存 friendCode 的版本
      const saved =
        normalizeByKind(this.kind, readSetting('queryValue', '')) ||
        normalizeByKind(this.kind, readSetting('friendCode', ''));

      this.code = saved;
      this.refreshInputState();

      if (saved) {
        this.keyboardHidden = true;
        this.query();
      }
    },

    setKind(kind) {
      if (this.kind === kind) return;
      this.kind = kind;
      // 两种方式的长度上限不同，切换时清空，避免留下不合法的残留
      this.code = '';
      this.errorText = '';
      this.hasResult = false;
      this.keyboardHidden = false;
      this.refreshInputState();
    },

    toggleKeyboard() {
      this.keyboardHidden = !this.keyboardHidden;
    },

    refreshInputState() {
      const described = describeInput(this.kind, this.code);
      this.hint = described.text + (this.saving ? ` · ${this.saving}` : '');
      this.canSubmit = isReadyToSubmit(this.kind, this.code);
      this.displayValue = this.code
        ? this.code
        : `输入${KIND_LABELS[this.kind] ?? '好友码'}`;
    },

    /** 只监听 complete：keyDown 会在拼音模式下把字母也报上来，两个都听会重复输入。 */
    onComplete(evt) {
      const content = evt && evt.detail ? evt.detail.content : '';
      const before = this.code;
      this.code = appendDigit(this.kind, this.code, content);
      if (this.code === before && normalizeByKind(this.kind, content) === '') {
        // 输入了不接受的字符，提示一下而不是静默吞掉
        this.hint =
          this.kind === 'username'
            ? '用户名只能是字母、数字、下划线、连字符、空格、方括号'
            : this.kind === 'qq'
              ? 'QQ 号只能是数字'
              : '好友码只能是数字';
        return;
      }
      this.refreshInputState();
    },

    onDelete() {
      this.code = backspace(this.code);
      this.refreshInputState();
    },

    query() {
      // Phigros 没有「输入好友码」这回事——凭证来自 TapTap 扫码，
      // 所以必须在校验输入框之前就分出去，否则会提示「好友码应为 15 位数字」
      if (this.gameId === 'phigros') {
        this.queryPhigros();
        return;
      }

      if (this.gameId === 'osu') {
        this.queryOsu();
        return;
      }

      const code = normalizeByKind(this.kind, this.code);
      if (!isReadyToSubmit(this.kind, code)) {
        this.errorText =
          this.kind === 'username'
            ? '用户名应为 2–15 个字符（字母、数字、下划线、连字符、空格、方括号）'
            : this.kind === 'qq'
              ? 'QQ 号应为 5–11 位数字'
              : '好友码应为 15 位数字';
        this.keyboardHidden = false;
        return;
      }

      this.errorText = '';
      this.keyboardHidden = true;

      // 落盘：下次打开直接可用
      writeSetting('queryKind', this.kind);
      writeSetting('queryValue', code);
      if (this.kind === 'friendCode') writeSetting('friendCode', code);

      const request =
        this.gameId === 'chunithm'
          ? this.kind === 'qq'
            ? fetchChunithmBestsByQq(code)
            : fetchChunithmBests(code)
          : this.kind === 'qq'
            ? fetchB50ByQq(code)
            : fetchB50(code);
      request
        .then((view) => {
          this.apply(view);
          this.saving = '';
          this.refreshInputState();
          // 先比上一次（此时 cache 里还是旧数据），再覆盖
          this.compareWithCache(view, code);
          // 成功就缓存一份，没网/服务器挂了还能看
          this.saveCache(view, code);
        })
        .catch((error) => {
          this.saving = '';
          this.refreshInputState();
          // 先试离线缓存；有缓存就不显示错误，改成"离线数据"的提示
          if (this.showCache(code, '查询失败。')) return;
          this.errorText = error && error.message ? error.message : '查询失败';
          this.hasResult = false;
          this.keyboardHidden = false;
        });
    },

    /*
     * ── 离线缓存 ────────────────────────────────────────────────────
     *
     * 为什么需要：**音游厅在地下** —— 没信号是常事，而恰恰是在机台前
     * 才想看成绩。服务器挂掉时同理。
     *
     * Phigros 早就有这套（`phigrosLastView`），但舞萌和中二没有 ——
     * 用户正好需要的那两个反而没有。所以这里补上。
     *
     * 按「游戏 + 查询目标」分开存：同一个人可能查自己、查朋友，
     * 用同一个键会互相覆盖，看到的是别人的成绩还以为是自己的。
     */

    /** 缓存的键。code 里可能有特殊字符，但 storage 的键是任意字符串，不用转义。 */
    cacheKey(code) {
      return `b50Cache:${this.gameId}:${code}`;
    },

    /**
     * 和上一次查到的比一比，把一句话总结放进 `diffLine`。
     *
     * ⚠️ **必须在 `saveCache` 之前调用** —— 那时缓存里还是上次的数据。
     * 顺序反了就是拿新数据和新数据比，永远是"没有变化"。
     *
     * 没有上次数据（第一次查）时 `diffB50` 返回 `comparable: false`，
     * `summarizeDiff` 给 `null`，`diffLine` 保持空串 → 模板不渲染任何东西。
     */
    compareWithCache(view, code) {
      // 只有舞萌有这个对比（中二/Phigros 的视图结构不同，先不做）
      if (this.gameId !== 'maimai') return;

      /*
       * 注意：`diffLine` 和 `DIFF_KEY` 的清理在 `apply()` 里做过了，
       * 这里不用重复。`apply()` 是所有渲染路径的入口，
       * 在它那里清一次就够 —— 写两处以后一定会有一处被忘掉。
       */

      let previous = null;
      try {
        const raw = readSetting(this.cacheKey(code), '');
        if (raw) previous = JSON.parse(raw);
      } catch (error) {
        console.warn('[AstraMai] 读旧缓存用于对比失败：', error);
        return;
      }

      if (!previous || typeof previous !== 'object') return;

      try {
        const diff = core.diffB50(previous, view);
        const text = core.summarizeDiff(diff);
        if (!text) return;

        this.diffLine = text;

        /*
         * 把完整对比也存下来，供「对比详情」页读。
         *
         * 为什么不存 `previous` 视图再让详情页自己算：
         * 那要多存十几 KB，而且详情页得再依赖一次 diffB50 的签名。
         * 存算好的结果，详情页只管渲染 —— 数据只算一次，两边不会不一致。
         */
        try {
          writeSetting(DIFF_KEY, JSON.stringify(diff));
        } catch (error) {
          console.warn('[AstraMai] 保存对比结果失败：', error);
        }
      } catch (error) {
        // 旧缓存是旧版本写的、结构对不上 —— 对比失败不影响看成绩
        console.warn('[AstraMai] 成绩对比失败：', error);
      }
    },

    /**
     * 查完存一份，并按 LRU 淘汰旧条目。
     *
     * ⚠️ **必须有淘汰。** 一份 B50 的 view 十几 KB，如果用户查过几十个好友码，
     * 缓存会无限增长，而手表存储是有上限的 —— 写满之后
     * `writeSetting` 会抛异常，那时候连正常设置都存不进去了。
     *
     * 只保留最近 `CACHE_MAX` 条（跨游戏一起算，因为共享同一份存储配额）。
     */
    saveCache(view, code) {
      const key = this.cacheKey(code);

      try {
        writeSetting(key, JSON.stringify(view));
        writeSetting(`${key}:at`, String(Date.now()));
      } catch (error) {
        // 存不下就算了 —— 绝不能因为缓存失败让用户看不到成绩
        console.warn('[AstraMai] 缓存成绩失败：', error);
        return;
      }

      try {
        const now = Date.now();
        let index = [];
        const raw = readSetting(CACHE_INDEX_KEY, '');
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) index = parsed;
        }

        // 去重 + 放到最前
        index = index.filter((item) => item && item.key !== key);
        index.unshift({ key, at: now });

        // 超出上限的老条目直接删
        while (index.length > CACHE_MAX) {
          const dropped = index.pop();
          if (dropped && dropped.key) {
            writeSetting(dropped.key, '');
            writeSetting(`${dropped.key}:at`, '');
          }
        }

        writeSetting(CACHE_INDEX_KEY, JSON.stringify(index));
      } catch (error) {
        // 索引坏了不影响已写入的缓存，下次查询会重建
        console.warn('[AstraMai] 更新缓存索引失败：', error);
      }
    },

    /**
     * 读缓存并渲染。
     *
     * @returns 有没有可用缓存（true 表示已经把缓存画出来了）
     */
    showCache(code, reason) {
      let cached = null;
      let at = 0;

      try {
        const raw = readSetting(this.cacheKey(code), '');
        if (raw) cached = JSON.parse(raw);
        at = Number(readSetting(`${this.cacheKey(code)}:at`, '0')) || 0;
      } catch (error) {
        console.warn('[AstraMai] 读缓存失败：', error);
        return false;
      }

      if (!cached || typeof cached !== 'object') return false;

      this.apply(cached);
      this.saving = '';
      this.refreshInputState();

      const when = at > 0 ? formatCachedTime(at) : '之前';
      this.errorText = `${reason}下面显示的是 ${when} 的数据（离线缓存）。`;
      return true;
    },

    apply(view) {
      /*
       * 第 5 行先清空。
       *
       * 只有舞萌会用这一行（「公式对拍」），而成绩卡是全游戏共用的组件 ——
       * 不清的话从舞萌切到中二，那一行会**残留着上一款游戏的内容**。
       * 这类残留最难发现，因为只有"切过游戏"的人才会看到。
       */
      this.statLine5 = '';

      /*
       * 对比行和对比数据也一起清。
       *
       * `apply` 是**所有**渲染路径的入口（正常查询、离线缓存、切游戏），
       * 所以在这里清一次就能覆盖全部：
       *
       *   · 查询失败读缓存 → 不该显示上一次查询的「+112」，
       *     那是**上一次**的对比结果，配着缓存里的旧成绩会误导人
       *   · 切到中二 → 不该还显示舞萌的对比，而且点进去看的是别的游戏的详情
       *
       * 正常查询时 `compareWithCache` 会在 `apply` 之后重新写回来。
       */
      this.diffLine = '';
      try {
        writeSetting(DIFF_KEY, '');
      } catch (error) {
        console.warn('[AstraMai] 清除对比数据失败：', error);
      }

      if (this.gameId === 'chunithm') {
        this.applyChunithm(view);
        return;
      }
      if (this.gameId === 'phigros') {
        this.applyPhigros(view);
        return;
      }
      this.applyMaimai(view);
    },

    /**
     * 「距下一档还差多少」那一行。
     *
     * 玩家最常问的两个问题之一是「我还差多少上虹」。
     * 已经是最高档（虹極）时换成一句别的，不要显示"还差 0 分"。
     */
    nextTierLine(rating) {
      const info = core.nextTier(Number(rating) || 0);
      if (!info.next) return `段位　${info.current.label}（最高档）`;
      return `距${info.next.label}　还差 ${info.gap}`;
    },

    /**
     * 查 Phigros 成绩。
     *
     * 没登录就直接引导去登录页，**不发请求**——
     * 发出去也是 401，不如省一次往返并告诉玩家该做什么。
     */
    /**
     * 查 osu! 成绩。
     *
     * ⚠️ **绝不自动重试**：osu! 上游限流是全应用共享的 60 次/分钟，
     * 我们一次查询花 2 次（资料 + 成绩）。超了就让玩家等，
     * 重试只会把所有人一起拖死，还可能被吊销 token。
     */
    queryOsu() {
      const username = normalizeByKind('username', this.code);
      if (!isUsername(username)) {
        this.errorText = '用户名不合法，请检查后重试';
        this.keyboardHidden = false;
        return;
      }

      this.keyboardHidden = true;
      this.errorText = '';
      this.saving = '查询中…';

      fetchOsuBests(username, { limit: 50 })
        .then((view) => {
          if (!view) throw new Error('查询失败');
          this.applyOsu(view);
          this.saving = '';
          this.refreshInputState();
        })
        .catch((error) => {
          this.errorText = error && error.message ? error.message : '查询失败';
          this.hasResult = false;
          this.saving = '';
        });
    },

    /**
     * osu! 成绩 → 行。
     *
     * 行的字段和舞萌同一套名字，但**含义不同**：
     *   rating       → 这一局的 pp（舞萌是单曲 rating）
     *   achievements → 准确率（舞萌是达成率）
     *   versionTitle → MOD（舞萌是所属版本）
     *   levelValue   → 星数（舞萌是定数）
     *
     * 两个标签在 `applyGameProfile` 里已经改成「★」和「MOD」。
     */
    applyOsu(view) {
      const player = view.player || {};
      const stats = view.stats || {};
      const scores = view.scores || [];

      /*
       * 主数字是**总 pp**，用服务端格式化好的文本。
       * pp 的小数在这个尺寸上没有价值，不分整数/小数两段。
       */
      const ppText = String(player.ppText ?? '—');
      this.ratingInt = ppText;
      this.ratingDec = '';
      this.ratingText = ppText;

      this.playerName = player.name || '';
      // osu! 没有「段位」，这里用全球排名替代——信息量更大
      this.tierText =
        player.globalRankText && player.globalRankText !== '—' ? player.globalRankText : '';

      this.statLine1 = '准确率　' + (player.accuracyText ?? '—');
      this.statLine2 = '游玩次数　' + (player.playCount ?? 0);
      this.statLine3 = '最佳单曲　' + formatPp(stats.topPp != null ? stats.topPp : 0) + 'pp';
      this.statLine4 = '列表合计　' + formatPp(stats.listedPpSum || 0) + 'pp';

      allEntries = scores.map((entry) => ({
        title: entry.songTitle || entry.title || '未知曲目',
        difficulty: entry.version || '—',
        // osu! 没有固定的难度配色，按星数映射（越亮越难）
        diffColor: starColor(entry.starRating),
        levelValue: entry.starRatingText || '—',
        // 主数字是这局的 pp
        rating: entry.ppText || '—',
        achievements: entry.accuracyText || '—',
        versionTitle: entry.modsText || '无',
        jacketUrl: entry.coverUrl || '',
      }));

      this.finishApply();
    },

    queryPhigros() {
      const session = readSetting('phigrosSession', '');
      if (!session) {
        // 没登录也要试一次缓存——过期之后凭证会被清掉，
        // 但上次的成绩还留着，别让用户对着空白页
        if (this.showCachedPhigros('还没登录 Phigros。')) return;
        this.errorText = '还没登录 Phigros。请到「设置 → Phigros 登录」用 TapTap 扫码。';
        this.hasResult = false;
        return;
      }

      this.keyboardHidden = true;
      this.errorText = '';
      this.saving = '查询中…';

      fetchPhigrosBests(session)
        .then((view) => {
          if (!view) throw new Error('查询失败');
          // 存一份：平台会话约 1 天就过期，但成绩本身不会变
          try {
            writeSetting('phigrosLastView', JSON.stringify(view));
            writeSetting('phigrosLastAt', String(Date.now()));
          } catch (error) {
            console.warn('[AstraMai] 缓存 Phigros 成绩失败：', error);
          }
          this.apply(view);
          this.saving = '';
        })
        .catch((error) => {
          this.saving = '';
          const status = error && error.status;

          if (status === 401) {
            /*
             * 会话过期。平台的有效期是对方定的，我们改不了——
             * 所以做三件事：
             *   1. 清掉本地凭证，免得每次查询都拿死 token 重试
             *   2. 把上次的结果显示出来并**标注时间**
             *   3. 明确告诉用户去哪儿重新扫码
             */
            try {
              writeSetting('phigrosSession', '');
            } catch (writeError) {
              console.warn('[AstraMai] 清除过期凭证失败：', writeError);
            }
            if (this.showCachedPhigros('登录已过期。')) return;

            this.errorText = '登录已过期，请到「设置 → Phigros 登录」重新扫码。';
            this.hasResult = false;
            return;
          }

          this.errorText = error && error.message ? error.message : '查询失败';
          this.hasResult = false;
        });
    },

    /**
     * 把缓存的成绩显示出来，并在顶部说明这是旧数据。
     *
     * **宁可显示带时间标注的旧数据，也不要一片空白**——
     * 成绩是玩家自己的历史记录，不会因为会话过期就失效。
     *
     * @returns 是否成功显示了缓存
     */
    showCachedPhigros(reason) {
      let cached = null;
      let at = 0;
      try {
        const raw = readSetting('phigrosLastView', '');
        if (raw) cached = JSON.parse(raw);
        at = Number(readSetting('phigrosLastAt', '0')) || 0;
      } catch (error) {
        console.warn('[AstraMai] 读取 Phigros 缓存失败：', error);
        return false;
      }
      if (!cached || typeof cached !== 'object') return false;

      this.apply(cached);
      this.errorText =
        reason +
        (at > 0 ? `下面显示的是 ${formatCachedTime(at)} 的数据，` : '') +
        '请到「设置 → Phigros 登录」重新扫码以获取最新成绩。';
      return true;
    },

    /** Phigros：RKS + B30。 */
    applyPhigros(view) {
      const stats = view.stats || {};
      const best30 = view.best30 || [];

      /*
       * RKS 是浮点数，原始值形如 15.7887875979519——
       * 这串精度对玩家没意义，而且 16 个字符会把 150px 的列撑爆（逐字折行）。
       *
       * 格式化到 4 位小数（Phigros 玩家熟悉的精度），并拆成两段：
       * 整数 40px、小数 22px。成绩类 UI 的常规做法。
       */
      const rks = Number(view.rks);
      if (Number.isFinite(rks)) {
        const fixed = rks.toFixed(4); // "15.7888"
        const dot = fixed.indexOf('.');
        this.ratingInt = fixed.slice(0, dot);
        this.ratingDec = fixed.slice(dot); // ".7888"，带小数点
        this.ratingText = fixed;
      } else {
        this.ratingInt = '';
        this.ratingDec = '';
        this.ratingText = String(view.rks);
      }

      /*
       * ⚠️ **不要给 tierText 塞昵称。**
       * 原来这里是 `this.tierText = view.nickname`，和 playerName 同一个值，
       * 模板里两处都渲染 → 屏幕上出现两个玩家名字。
       *
       * Phigros 没有「段位」概念，留空即可（模板有 `if` 判断）。
       */
      this.tierText = '';
      this.playerName = view.nickname || '';
      this.statLine1 = 'B30　' + (stats.best30Count ?? best30.length);
      this.statLine2 = '成绩总数　' + (stats.recordCount ?? 0);
      this.statLine3 = 'FC　' + (stats.fullComboCount ?? 0);
      this.statLine4 = '满分　' + (stats.phiCount ?? 0);

      allEntries = best30.map((entry) => ({
        title: entry.title,
        difficulty: entry.difficulty,
        diffColor: entry.color || '#9bacd0',
        levelValue:
          typeof entry.chartConstant === 'number' ? entry.chartConstant.toFixed(1) : '--',
        // B30 的每条自带它对 RKS 的贡献
        rating: typeof entry.rks === 'number' ? entry.rks.toFixed(2) : '--',
        achievements: String(entry.score ?? '--'),
        // Phigros 没有「版本」这种逐条信息，显示准确率更有用
        versionTitle:
          typeof entry.accuracy === 'number'
            ? 'ACC ' + entry.accuracy.toFixed(2) + '%'
            : 'ACC --',
        jacketUrl: '',
      }));

      this.finishApply();
    },

    /** 舞萌：B35 + B15 合成 B50。 */
    applyMaimai(view) {
      const stats = view.stats;
      const player = view.player;

      this.ratingText = String(player.rating);
      this.ratingInt = '';
      this.ratingDec = '';
      this.tierText = player.tier ? player.tier.label : '';
      this.playerName = player.name || '';
      this.statLine1 = '旧曲 B35　' + stats.standardTotal;
      this.statLine2 = '新曲 B15　' + stats.dxTotal;
      this.statLine3 = '平均定数　' + stats.averageLevelValue.toFixed(2);
      /*
       * 第 4 行留给「距下一档还差多少」—— 玩家最常问的两个问题之一
       * 就是「我还差多少上虹」。原来的「公式对拍」是开发用的自检，
       * 挪到第 5 行：它对排查数据问题有用，但不该占着玩家最想看的位置。
       */
      this.statLine4 = this.nextTierLine(player.rating);
      this.statLine5 = '公式对拍　' + (stats.computedDelta === 0 ? '一致' : '差 ' + stats.computedDelta);

      // 官方《常用业务优化》：list 内容超过 10 条建议分页渲染，
      // 切勿初始化渲染大量数据，会造成页面渲染卡顿。
      // 所以先渲染一页，其余等触底再追加。
      allEntries = view.standard
        .concat(view.dx)
        .sort((a, b) => (b.rating || 0) - (a.rating || 0))
        .map((entry) => ({
          title: entry.title,
          difficulty: entry.difficultyShort,
          // 难度配色与游戏内一致：绿 / 黄 / 红 / 紫 / 白
          diffColor: DIFFICULTY_COLOR[entry.levelIndex] || '#9bacd0',
          /*
           * ⚠️ 下面三个字段同时存**两种形态**：
           *   `levelValue` / `rating` / `achievements` 是给界面看的字符串
           *   `raw*` 是给推分页用的数值
           *
           * 不合并成一个字段的原因：模板里要的是"14.0"这种格式化结果，
           * 而推分要的是能参与计算的数字。把格式化结果反解回数字
           * （parseFloat('14.0')）在 `--` 时会变成 NaN，更容易出错。
           */
          levelValue: entry.levelValue === null ? '--' : entry.levelValue.toFixed(1),
          rating: entry.rating === null ? '--' : String(entry.rating),
          achievements: entry.achievements.toFixed(4) + '%',
          rawLevelValue: entry.levelValue,
          rawRating: entry.rating,
          rawAchievement: entry.achievements,
          // 封面直链（已裁剪到列表尺寸），服务端组装 B50 视图时已经带上
          jacketUrl: entry.jacketUrl || '',
          // 版本名由 core 的 versionTitleOf 解析（曲目里是细粒度版本号，版本表是千位步长）
          versionTitle: entry.songVersionTitle || '未知',
        }));

      this.finishApply();
    },

    /**
     * 中二节奏：B30 + Selection10 + Recent10。
     *
     * **三组并列进同一个列表**，而不是像舞萌那样合成一个榜单：
     * 它们的意义不同（Best / 选拔 / 最近），合成会让玩家看不出哪条是 Best。
     * 排序按 Rating 降序，这样 Best 30 自然排在最前。
     */
    applyChunithm(view) {
      const stats = view.stats;
      const player = view.player;

      this.ratingText = String(player.rating);
      this.ratingInt = '';
      this.ratingDec = '';
      // 中二没有「段位」这种概念，玩家等级才是名片上的东西
      this.tierText = player.level ? '等级 ' + player.level : '';
      // 中二的玩家名可能是全角（游戏内输入法打出来的），原样显示不转换
      this.playerName = player.name || '';
      this.statLine1 = 'Best 30　' + stats.bestsCount;
      this.statLine2 = 'Selection 10　' + stats.selectionsCount;
      this.statLine3 = 'Recent 10　' + stats.recentsCount;
      this.statLine4 = 'B30 Rating 合计　' + stats.bestsRatingSum;

      allEntries = view.bests
        .concat(view.selections)
        .sort((a, b) => (b.rating || 0) - (a.rating || 0))
        .map((entry) => ({
          title: entry.title,
          difficulty: entry.difficultyShort,
          // 中二是六档下标，WE 用金色单独标出（它是特殊谱面，不是第六档难度）
          diffColor: chunithmDifficultyColor(entry.levelIndex),
          levelValue: entry.levelValue === null ? '--' : entry.levelValue.toFixed(1),
          // 中二的 Rating 由接口直接给出（浮点），保留两位
          rating: entry.rating ? entry.rating.toFixed(2) : '--',
          // 中二看的是分数而不是达成率
          achievements: String(entry.points),
          jacketUrl: entry.jacketUrl || '',
          // 中二视图没有逐条的版本名，显示难度全称更有用
          versionTitle: entry.difficultyName + (entry.isWorldsEnd ? ' · 特殊谱面' : ''),
        }));

      this.finishApply();
    },

    /** 两个游戏共用的收尾：分页渲染 + 标记有结果。 */
    finishApply() {
      // 原地清空再追加，避免整份重新赋值开辟新内存（官方《内存优化》第 2 条）
      this.entries.length = 0;
      shownCount = 0;
      this.appendPage();
      this.hasResult = true;
    },

    /** 追加一页。触底时也会调这里。 */
    appendPage() {
      const next = allEntries.slice(shownCount, shownCount + PAGE_SIZE);
      for (const item of next) this.entries.push(item);
      shownCount += next.length;
    },

    /** 触底加载下一页。 */
    onScrollBottom() {
      if (shownCount < allEntries.length) this.appendPage();
    },
  };
</script>
