<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page-root">
    <div class="b50-page">
    <!--
      显式返回键。
      手表上没有可见的返回入口，用户得先知道「从边缘侧滑」这个隐藏手势才能回去；
      不知道的人会到处找按钮，找不到就只能大退应用重进。模拟器上更是没有侧滑手势。
    -->
    <div class="topbar">
      <div class="back" @click="onBack">
        <text class="back__text">‹ 返回</text>
      </div>
      <text class="topbar__title">{{ pageTitle }}</text>
    </div>

    <!--
      查询目标。**Phigros 整块隐藏**——它靠 TapTap 扫码登录，查的是自己，
      根本没有「输入一个码」这回事。留着只占地方，还会让人以为要输好友码。
    -->
    <block if="{{ gameId !== 'phigros' }}">
      <div class="kinds">
        <div class="kind {{ kind === 'friendCode' ? 'kind--on' : '' }}" @click="setKind('friendCode')">
          <text class="kind__text">好友码</text>
        </div>
        <div class="kind {{ kind === 'qq' ? 'kind--on' : '' }}" @click="setKind('qq')">
          <text class="kind__text">QQ 号</text>
        </div>
      </div>

      <div class="target">
        <text class="target__value">{{ displayValue }}</text>
        <text class="target__hint">{{ hint }}</text>
      </div>
    </block>

    <div class="actions">
      <div class="action {{ canSubmit || gameId === 'phigros' ? '' : 'action--disabled' }}" @click="query">
        <text class="action__text">{{ gameId === 'phigros' ? '查询自己的成绩' : '查询' }}</text>
      </div>
      <!-- 输入按钮对 Phigros 也没意义（没有要输入的码） -->
      <div class="action action--ghost" if="{{ gameId !== 'phigros' }}" @click="toggleKeyboard">
        <text class="action__text">{{ keyboardHidden ? '输入' : '收起' }}</text>
      </div>
    </div>

    <text class="error" if="{{ errorText }}">{{ errorText }}</text>

    <!-- ── 结果 ─────────────────────────────────────────────────── -->
    <block if="{{ hasResult }}">
      <div class="summary">
        <div class="summary__main">
          <!--
            玩家名要显示。多号玩家（国服一个、日服一个）需要一眼确认
            「我看的是谁的」，否则查出一堆成绩也不知道对不对。
          -->
          <text class="player" if="{{ playerName }}">{{ playerName }}</text>
          <text class="rating">{{ ratingText }}</text>
          <text class="tier">{{ tierText }}</text>
        </div>
        <div class="summary__side">
          <text class="line">{{ statLine1 }}</text>
          <text class="line">{{ statLine2 }}</text>
          <text class="line">{{ statLine3 }}</text>
          <text class="line">{{ statLine4 }}</text>
        </div>
      </div>

      <!-- <list> 必须显式给高度，否则高度为 0、成绩一条都画不出来 -->
      <list class="list" onscrollbottom="onScrollBottom">
        <list-item class="row" type="item" for="{{ entries }}">
          <text class="row__rank">{{ $idx + 1 }}</text>
          <!-- 没有图就不渲染：Phigros 平台不提供曲绘，渲染空的 <image> 会显示成灰块 -->
          <image class="row__cover" if="{{ $item.jacketUrl }}" src="{{ $item.jacketUrl }}"></image>
          <div class="row__main">
            <text class="row__title">{{ $item.title }}</text>
            <text class="row__sub" style="color: {{ $item.diffColor }}">{{ $item.difficulty }} · 定数 {{ $item.levelValue }}</text>
            <text class="row__version">版本 {{ $item.versionTitle }}</text>
          </div>
          <div class="row__right">
            <text class="row__rating">{{ $item.rating }}</text>
            <text class="row__ach">{{ $item.achievements }}</text>
          </div>
        </list-item>
      </list>
    </block>

    <!--
      完整输入法。好友码是纯数字，用它的「123」数字键盘即可；
      这样全应用只有一套输入组件，不必为不同输入各写一个键盘。
    -->
    </div>

    <!-- 键盘提到根容器下：它靠 position:absolute 的 left:0/width:100% 定位，
         父容器一旦有 padding 就会缩进去，真机上右边留一条缝。 -->
    <input-method
      hide="{{ keyboardHidden }}"
      keyboardtype="QWERTY"
      screentype="rect"
      vibratemode="short"
      maxlength="5"
      @complete="onComplete"
      @delete="onDelete"
    ></input-method>
  </div>
</template>

<style lang="less">
  @import '../../common/theme-tokens.less';

  /*
   * 页面根容器：**全幅、零内边距**。
   * 输入法是它的直接子元素，靠 position:absolute 的 left:0/width:100% 定位，
   * 父容器有内边距的话键盘就会跟着缩进去——真机上右边会留一条缝。
   * 所以内边距放在内层的 .b50-page 上，这一层专门给键盘当定位基准。
   */
  .page-root {
    /*
     * ⚠️ **必须显式写 flex-direction: column。**
     * Vela 的 div 默认是 `flex-direction: row`（不是网页里的 block），
     * 不写就会把内层页面和键盘摆成横向一排——内层被压窄，
     * 而它内部是纵向布局，结果所有内容挤在一起重叠。
     */
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    background-color: @ui-surface;
  }

  .b50-page {
    /* 吃掉剩余高度、横轴拉满——键盘是 absolute，不占流式空间 */
    flex: 1;
    width: 100%;
    flex-direction: column;
    padding: 14px;
    background-color: @ui-surface;
  }

  /* 返回键。做够大，手表上要好点。 */
  .topbar {
    flex-direction: row;
    align-items: center;
    height: 56px;
    margin-bottom: 4px;
  }

  .back {
    padding: 8px 20px;
    border-radius: 22px;
    background-color: @ui-surface-container;
  }

  .back__text {
    font-size: 22px;
    color: @ui-on-surface;
  }

  .topbar__title {
    font-size: 22px;
    color: @ui-on-surface-variant;
    margin-left: 14px;
  }

  .kinds {
    flex-direction: row;
    justify-content: center;
  }

  .kind {
    padding: 10px 26px;
    margin: 0 6px;
    border-radius: 24px;
    background-color: @ui-surface-card;
  }

  .kind--on {
    background-color: @ui-surface-container;
  }

  .kind__text {
    font-size: 22px;
    color: @ui-on-surface-variant;
  }

  .kind--on .kind__text {
    color: @ui-on-surface;
  }

  .target {
    flex-direction: column;
    align-items: center;
    margin-top: 12px;
    padding: 14px;
    border-radius: 14px;
    background-color: @ui-surface-card;
  }

  .target__value {
    font-size: 32px;
    color: @ui-on-surface;
  }

  .target__hint {
    font-size: 17px;
    color: @ui-on-surface-variant;
    margin-top: 4px;
  }

  .actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
  }

  .action {
    height: 68px;
    padding: 0 34px;
    margin: 0 6px;
    border-radius: 34px;
    background-color: @ui-primary;
    align-items: center;
    justify-content: center;
  }

  .action--ghost {
    background-color: @ui-surface-container;
  }

  .action--disabled {
    background-color: @ui-outline;
  }

  .action__text {
    font-size: 26px;
    color: @ui-on-primary;
  }

  .action--ghost .action__text {
    color: @ui-on-surface;
  }

  .action--disabled .action__text {
    color: @ui-on-surface-variant;
  }

  .error {
    font-size: 18px;
    color: @ui-error;
    margin-top: 8px;
    text-align: center;
  }

  .summary {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    padding: 16px;
    border-radius: 14px;
    background-color: @ui-surface-card;
  }

  .summary__main {
    flex-direction: column;
    align-items: center;
    width: 150px;
  }

  /* 玩家名：可能是全角，给它单独一行并适当限宽 */
  .player {
    font-size: 20px;
    color: #4fd6ff;
    margin-bottom: 4px;
    text-align: center;
  }

  .rating {
    font-size: 40px;
    font-weight: bold;
    color: #f5c542;
  }

  .tier {
    font-size: 18px;
    color: #f5c542;
  }

  .summary__side {
    flex-direction: column;
    flex: 1;
    margin-left: 12px;
  }

  .line {
    font-size: 18px;
    color: @ui-on-surface-variant;
    margin-bottom: 4px;
  }

  .list {
    width: 100%;
    /* <list> 必须显式给高度，否则高度为 0，一条都画不出来 */
    height: 190px;
    margin-top: 12px;
  }

  .row {
    flex-direction: row;
    align-items: center;
    height: 96px;
    padding: 6px 8px;
  }

  /* 封面。定死尺寸，避免图片加载前后布局跳动。 */
  .row__cover {
    width: 58px;
    height: 58px;
    margin-left: 6px;
    background-color: @ui-surface-container;
  }

  .row__rank {
    width: 40px;
    font-size: 18px;
    color: @ui-on-surface-variant;
  }

  .row__main {
    flex: 1;
    flex-direction: column;
  }

  .row__title {
    font-size: 20px;
    color: @ui-on-surface;
  }

  .row__sub {
    font-size: 16px;
    color: @ui-on-surface-variant;
  }

  /* 版本单独一行并带标签 */
  .row__version {
    font-size: 15px;
    color: @ui-warning;
    margin-top: 2px;
  }

  .row__right {
    flex-direction: column;
    align-items: flex-end;
    width: 110px;
  }

  .row__rating {
    font-size: 24px;
    font-weight: bold;
    color: @ui-on-surface;
  }

  .row__ach {
    font-size: 15px;
    color: @ui-on-surface-variant;
  }

  /*
   * ── 圆形屏适配 ─────────────────────────────────────────────────
   * 依据官方《多屏适配 · 页面标题栏》：
   *   「在圆屏、胶囊屏等存在边缘剪切的设备上，标题栏会使用多行设计，
   *     保证顶部的展示内容长度不会超出屏幕；而在矩形屏幕上则做单行左右布局。」
   *
   * 圆屏四角是物理裁掉的：466×466 的屏，顶栏中心 y≈44 处可用宽度只有约 272px，
   * 而「标题在左 + 设置在右」需要整幅 466px，两端必然被切。
   * 所以这里改竖排居中，并加左右内边距把内容压进圆内接矩形。
   *
   * **只影响 shape: circle**，矩形屏样式与行为完全不变。
   */
  @media (shape: circle) {
    .b50-page {
      padding-left: 40px;
      padding-right: 40px;
    }

    /* 顶栏改竖排居中：单行左右布局在圆屏上两端必被裁 */
    .topbar {
      flex-direction: column;
      align-items: center;
      height: auto;
    }

    /* 返回键/标题不再靠边，改为居中并留出上下间距 */
    .back {
      margin-bottom: 8px;
    }
  }
</style>

<script>
  // 共享模块从 global 取，不再 import（官方内存优化建议）。
  // 页面各自 import 会让每个页面都打一份，手表内存扛不住。
  const { api, core, diag, games, navigation, store, validate } = global.AstraMai;
  const {
    fetchB50,
    fetchB50ByQq,
    fetchChunithmBests,
    fetchChunithmBestsByQq,
    fetchPhigrosBests,
  } = api;
  const { chunithmDifficultyColor } = core;
  const { gameById, readCurrentGame } = games;
  const { mark } = diag;
  const { goBack } = navigation;
  const { readSetting, warmUp, writeSetting } = store;
  const { appendDigit, backspace, describeInput, isReadyToSubmit, normalizeDigits } = validate;

  /**
   * 每页条数。
   * 官方《常用业务优化》：list 内容超过 10 条建议分页渲染。
   */
  const PAGE_SIZE = 10;

  /**
   * 全部曲目成绩。放在脚本作用域而不是 viewModel：
   * 它是纯数据、不需要响应式，塞进 viewModel 只会多一层 observer
   * （官方《内存优化》第 1 条）。
   */
  let allEntries = [];
  let shownCount = 0;

  /** 难度配色，与游戏内一致：绿 / 黄 / 红 / 紫 / 白。 */
  const DIFFICULTY_COLOR = ['#7ee081', '#f5d547', '#f2564b', '#b06fe8', '#f2f2f2'];

  /**
   * 把时间戳格式化成「10月18日 14:32」。
   *
   * 只用来标注「这是什么时候的数据」，不需要秒、不需要年份。
   *
   * ⚠️ 必须放在**模块作用域**，不能放在 `export default { ... }` 里面——
   * 那是对象字面量，里面只能有属性/方法，`function` 声明会直接语法错误
   * （构建报 `Parsing error: Unexpected keyword 'function'`）。
   */
  function formatCachedTime(timestamp) {
    const d = new Date(timestamp);
    if (Number.isNaN(d.getTime())) return '之前';
    const pad = (n) => (n < 10 ? '0' + n : String(n));
    return (
      d.getMonth() + 1 + '月' + d.getDate() + '日 ' + pad(d.getHours()) + ':' + pad(d.getMinutes())
    );
  }

  export default {
    private: {
      kind: 'friendCode',
      code: '',
      keyboardHidden: true,

      hint: '',
      canSubmit: false,
      errorText: '',
      saving: '',
      displayValue: '输入好友码',

      hasResult: false,
      ratingText: '',
      tierText: '',
      /** 玩家名。多号玩家靠它确认「看的是谁的」。 */
      playerName: '',
      statLine1: '',
      statLine2: '',
      statLine3: '',
      statLine4: '',
      /** 当前游戏 id。决定请求哪个接口、以及统计行怎么写。 */
      gameId: 'maimai',
      /** 标题按游戏变：舞萌 Best 50 / 中二 B30 / Phigros RKS。 */
      pageTitle: 'Best 50',
      entries: [],
    },

    /** 返回上一页。失败也不会把用户困住——goBack 内部会兜底跳首页。 */
    onBack() {
      goBack('/');
    },

    onReady() {
      mark('B50:onReady');
    },

    onInit() {
      mark('B50:onInit');
      console.debug('[AstraMai] B50 onInit');
      warmUp(['queryKind', 'queryValue', 'friendCode', 'currentGame', 'phigrosSession'])
        .then(() => {
          // 当前游戏决定查哪个接口、统计行怎么写
          this.gameId = gameById(readCurrentGame(readSetting)).id;
          // 标题跟着游戏变——写死「Best 50」对中二和 Phigros 都是错的
          this.pageTitle =
            this.gameId === 'chunithm' ? 'Best 30' : this.gameId === 'phigros' ? 'RKS / B30' : 'Best 50';
          // Phigros 没有要输入的码，键盘一律收起（也省掉一个组件的初始化开销）
          if (this.gameId === 'phigros') this.keyboardHidden = true;
          return this.restore();
        })
        .catch((error) => console.error('[AstraMai] B50 初始化失败：', error));
    },

    /**
     * 恢复上次保存的查询目标。
     *
     * 手表上输入 15 位数字很费劲，所以「存下来、下次直接用」不是锦上添花，
     * 而是这个页面能不能用的前提。
     */
    restore() {
      const savedKind = readSetting('queryKind', 'friendCode');
      this.kind = savedKind === 'qq' ? 'qq' : 'friendCode';

      // 兼容早期只存 friendCode 的版本
      const saved =
        normalizeDigits(readSetting('queryValue', '')) ||
        normalizeDigits(readSetting('friendCode', ''));

      this.code = saved;
      this.refreshInputState();

      if (saved) {
        this.keyboardHidden = true;
        this.query();
      }
    },

    setKind(kind) {
      if (this.kind === kind) return;
      this.kind = kind;
      // 两种方式的长度上限不同，切换时清空，避免留下不合法的残留
      this.code = '';
      this.errorText = '';
      this.hasResult = false;
      this.keyboardHidden = false;
      this.refreshInputState();
    },

    toggleKeyboard() {
      this.keyboardHidden = !this.keyboardHidden;
    },

    refreshInputState() {
      const described = describeInput(this.kind, this.code);
      this.hint = described.text + (this.saving ? ` · ${this.saving}` : '');
      this.canSubmit = isReadyToSubmit(this.kind, this.code);
      this.displayValue = this.code
        ? this.code
        : this.kind === 'qq'
          ? '输入 QQ 号'
          : '输入好友码';
    },

    /** 只监听 complete：keyDown 会在拼音模式下把字母也报上来，两个都听会重复输入。 */
    onComplete(evt) {
      const content = evt && evt.detail ? evt.detail.content : '';
      const before = this.code;
      this.code = appendDigit(this.kind, this.code, content);
      if (this.code === before && normalizeDigits(content) === '' ) {
        // 输入了非数字字符，提示一下而不是静默吞掉
        this.hint = this.kind === 'qq' ? 'QQ 号只能是数字' : '好友码只能是数字';
        return;
      }
      this.refreshInputState();
    },

    onDelete() {
      this.code = backspace(this.code);
      this.refreshInputState();
    },

    query() {
      // Phigros 没有「输入好友码」这回事——凭证来自 TapTap 扫码，
      // 所以必须在校验输入框之前就分出去，否则会提示「好友码应为 15 位数字」
      if (this.gameId === 'phigros') {
        this.queryPhigros();
        return;
      }

      const code = normalizeDigits(this.code);
      if (!isReadyToSubmit(this.kind, code)) {
        this.errorText = this.kind === 'qq' ? 'QQ 号应为 5–11 位数字' : '好友码应为 15 位数字';
        this.keyboardHidden = false;
        return;
      }

      this.errorText = '';
      this.keyboardHidden = true;

      // 落盘：下次打开直接可用
      writeSetting('queryKind', this.kind);
      writeSetting('queryValue', code);
      if (this.kind === 'friendCode') writeSetting('friendCode', code);

      const request =
        this.gameId === 'chunithm'
          ? this.kind === 'qq'
            ? fetchChunithmBestsByQq(code)
            : fetchChunithmBests(code)
          : this.kind === 'qq'
            ? fetchB50ByQq(code)
            : fetchB50(code);
      request
        .then((view) => {
          this.apply(view);
          this.saving = '';
          this.refreshInputState();
        })
        .catch((error) => {
          this.errorText = error && error.message ? error.message : '查询失败';
          this.hasResult = false;
          this.keyboardHidden = false;
        });
    },

    apply(view) {
      if (this.gameId === 'chunithm') {
        this.applyChunithm(view);
        return;
      }
      if (this.gameId === 'phigros') {
        this.applyPhigros(view);
        return;
      }
      this.applyMaimai(view);
    },

    /**
     * 查 Phigros 成绩。
     *
     * 没登录就直接引导去登录页，**不发请求**——
     * 发出去也是 401，不如省一次往返并告诉玩家该做什么。
     */
    queryPhigros() {
      const session = readSetting('phigrosSession', '');
      if (!session) {
        // 没登录也要试一次缓存——过期之后凭证会被清掉，
        // 但上次的成绩还留着，别让用户对着空白页
        if (this.showCachedPhigros('还没登录 Phigros。')) return;
        this.errorText = '还没登录 Phigros。请到「设置 → Phigros 登录」用 TapTap 扫码。';
        this.hasResult = false;
        return;
      }

      this.keyboardHidden = true;
      this.errorText = '';
      this.saving = '查询中…';

      fetchPhigrosBests(session)
        .then((view) => {
          if (!view) throw new Error('查询失败');
          // 存一份：平台会话约 1 天就过期，但成绩本身不会变
          try {
            writeSetting('phigrosLastView', JSON.stringify(view));
            writeSetting('phigrosLastAt', String(Date.now()));
          } catch (error) {
            console.warn('[AstraMai] 缓存 Phigros 成绩失败：', error);
          }
          this.apply(view);
          this.saving = '';
        })
        .catch((error) => {
          this.saving = '';
          const status = error && error.status;

          if (status === 401) {
            /*
             * 会话过期。平台的有效期是对方定的，我们改不了——
             * 所以做三件事：
             *   1. 清掉本地凭证，免得每次查询都拿死 token 重试
             *   2. 把上次的结果显示出来并**标注时间**
             *   3. 明确告诉用户去哪儿重新扫码
             */
            try {
              writeSetting('phigrosSession', '');
            } catch (writeError) {
              console.warn('[AstraMai] 清除过期凭证失败：', writeError);
            }
            if (this.showCachedPhigros('登录已过期。')) return;

            this.errorText = '登录已过期，请到「设置 → Phigros 登录」重新扫码。';
            this.hasResult = false;
            return;
          }

          this.errorText = error && error.message ? error.message : '查询失败';
          this.hasResult = false;
        });
    },

    /**
     * 把缓存的成绩显示出来，并在顶部说明这是旧数据。
     *
     * **宁可显示带时间标注的旧数据，也不要一片空白**——
     * 成绩是玩家自己的历史记录，不会因为会话过期就失效。
     *
     * @returns 是否成功显示了缓存
     */
    showCachedPhigros(reason) {
      let cached = null;
      let at = 0;
      try {
        const raw = readSetting('phigrosLastView', '');
        if (raw) cached = JSON.parse(raw);
        at = Number(readSetting('phigrosLastAt', '0')) || 0;
      } catch (error) {
        console.warn('[AstraMai] 读取 Phigros 缓存失败：', error);
        return false;
      }
      if (!cached || typeof cached !== 'object') return false;

      this.apply(cached);
      this.errorText =
        reason +
        (at > 0 ? `下面显示的是 ${formatCachedTime(at)} 的数据，` : '') +
        '请到「设置 → Phigros 登录」重新扫码以获取最新成绩。';
      return true;
    },

    /** Phigros：RKS + B30。 */
    applyPhigros(view) {
      const stats = view.stats || {};
      const best30 = view.best30 || [];

      this.ratingText = String(view.rks);
      this.tierText = view.nickname || '';
      this.playerName = view.nickname || '';
      this.statLine1 = 'B30　' + (stats.best30Count ?? best30.length);
      this.statLine2 = '成绩总数　' + (stats.recordCount ?? 0);
      this.statLine3 = 'FC　' + (stats.fullComboCount ?? 0);
      this.statLine4 = '满分　' + (stats.phiCount ?? 0);

      allEntries = best30.map((entry) => ({
        title: entry.title,
        difficulty: entry.difficulty,
        diffColor: entry.color || '#9bacd0',
        levelValue:
          typeof entry.chartConstant === 'number' ? entry.chartConstant.toFixed(1) : '--',
        // B30 的每条自带它对 RKS 的贡献
        rating: typeof entry.rks === 'number' ? entry.rks.toFixed(2) : '--',
        achievements: String(entry.score ?? '--'),
        // Phigros 没有「版本」这种逐条信息，显示准确率更有用
        versionTitle:
          typeof entry.accuracy === 'number'
            ? 'ACC ' + entry.accuracy.toFixed(2) + '%'
            : 'ACC --',
        jacketUrl: '',
      }));

      this.finishApply();
    },

    /** 舞萌：B35 + B15 合成 B50。 */
    applyMaimai(view) {
      const stats = view.stats;
      const player = view.player;

      this.ratingText = String(player.rating);
      this.tierText = player.tier ? player.tier.label : '';
      this.playerName = player.name || '';
      this.statLine1 = '旧曲 B35　' + stats.standardTotal;
      this.statLine2 = '新曲 B15　' + stats.dxTotal;
      this.statLine3 = '平均定数　' + stats.averageLevelValue.toFixed(2);
      this.statLine4 = '公式对拍　' + (stats.computedDelta === 0 ? '一致' : '差 ' + stats.computedDelta);

      // 官方《常用业务优化》：list 内容超过 10 条建议分页渲染，
      // 切勿初始化渲染大量数据，会造成页面渲染卡顿。
      // 所以先渲染一页，其余等触底再追加。
      allEntries = view.standard
        .concat(view.dx)
        .sort((a, b) => (b.rating || 0) - (a.rating || 0))
        .map((entry) => ({
          title: entry.title,
          difficulty: entry.difficultyShort,
          // 难度配色与游戏内一致：绿 / 黄 / 红 / 紫 / 白
          diffColor: DIFFICULTY_COLOR[entry.levelIndex] || '#9bacd0',
          levelValue: entry.levelValue === null ? '--' : entry.levelValue.toFixed(1),
          rating: entry.rating === null ? '--' : String(entry.rating),
          achievements: entry.achievements.toFixed(4) + '%',
          // 封面直链（已裁剪到列表尺寸），服务端组装 B50 视图时已经带上
          jacketUrl: entry.jacketUrl || '',
          // 版本名由 core 的 versionTitleOf 解析（曲目里是细粒度版本号，版本表是千位步长）
          versionTitle: entry.songVersionTitle || '未知',
        }));

      this.finishApply();
    },

    /**
     * 中二节奏：B30 + Selection10 + Recent10。
     *
     * **三组并列进同一个列表**，而不是像舞萌那样合成一个榜单：
     * 它们的意义不同（Best / 选拔 / 最近），合成会让玩家看不出哪条是 Best。
     * 排序按 Rating 降序，这样 Best 30 自然排在最前。
     */
    applyChunithm(view) {
      const stats = view.stats;
      const player = view.player;

      this.ratingText = String(player.rating);
      // 中二没有「段位」这种概念，玩家等级才是名片上的东西
      this.tierText = player.level ? '等级 ' + player.level : '';
      // 中二的玩家名可能是全角（游戏内输入法打出来的），原样显示不转换
      this.playerName = player.name || '';
      this.statLine1 = 'Best 30　' + stats.bestsCount;
      this.statLine2 = 'Selection 10　' + stats.selectionsCount;
      this.statLine3 = 'Recent 10　' + stats.recentsCount;
      this.statLine4 = 'B30 Rating 合计　' + stats.bestsRatingSum;

      allEntries = view.bests
        .concat(view.selections)
        .sort((a, b) => (b.rating || 0) - (a.rating || 0))
        .map((entry) => ({
          title: entry.title,
          difficulty: entry.difficultyShort,
          // 中二是六档下标，WE 用金色单独标出（它是特殊谱面，不是第六档难度）
          diffColor: chunithmDifficultyColor(entry.levelIndex),
          levelValue: entry.levelValue === null ? '--' : entry.levelValue.toFixed(1),
          // 中二的 Rating 由接口直接给出（浮点），保留两位
          rating: entry.rating ? entry.rating.toFixed(2) : '--',
          // 中二看的是分数而不是达成率
          achievements: String(entry.points),
          jacketUrl: entry.jacketUrl || '',
          // 中二视图没有逐条的版本名，显示难度全称更有用
          versionTitle: entry.difficultyName + (entry.isWorldsEnd ? ' · 特殊谱面' : ''),
        }));

      this.finishApply();
    },

    /** 两个游戏共用的收尾：分页渲染 + 标记有结果。 */
    finishApply() {
      // 原地清空再追加，避免整份重新赋值开辟新内存（官方《内存优化》第 2 条）
      this.entries.length = 0;
      shownCount = 0;
      this.appendPage();
      this.hasResult = true;
    },

    /** 追加一页。触底时也会调这里。 */
    appendPage() {
      const next = allEntries.slice(shownCount, shownCount + PAGE_SIZE);
      for (const item of next) this.entries.push(item);
      shownCount += next.length;
    },

    /** 触底加载下一页。 */
    onScrollBottom() {
      if (shownCount < allEntries.length) this.appendPage();
    },
  };
</script>
