<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="sync-page">
    <!-- 返回键：手表上没有可见的返回入口，用户得知道「边缘侧滑」这个隐藏手势 -->
    <div class="topbar">
      <div class="back" @click="onBack">
        <text class="back__text">‹ 返回</text>
      </div>
    </div>

    <text class="title">同步</text>
    <text class="lead">{{ leadText }}</text>

    <!--
      配对码：抄到电脑上。
      上传成功后才出现 —— 没有码的时候显示一块空面板只会让人困惑。
    -->
    <div class="code-box" if="{{ code }}">
      <text class="code-box__label">配对码</text>
      <text class="code-box__value">{{ code }}</text>
      <text class="code-box__label">密码</text>
      <text class="code-box__value">{{ pin }}</text>
      <text class="code-box__ttl">10 分钟内有效</text>
    </div>

    <text class="status" style="color: {{ statusColor }}" if="{{ statusText }}">{{ statusText }}</text>

    <text class="hint" if="{{ hint }}">{{ hint }}</text>

    <!-- 输入中的配对码 -->
    <text class="entry" if="{{ entryText }}">{{ entryText }}</text>

    <div class="actions">
      <div class="action" if="{{ canUpload }}" @click="onUpload">
        <text class="action__text">{{ uploading ? '加密上传中…' : '上传成绩到电脑' }}</text>
      </div>

      <div class="action" if="{{ canPull }}" @click="toggleKeyboard">
        <text class="action__text">{{ keyboardHidden ? '输入配对码' : '收起键盘' }}</text>
      </div>
    </div>

    <!-- 键盘提到根容器下：它靠 position:absolute 定位，父容器有 padding 就会缩进去 -->
    <input-method
      hide="{{ keyboardHidden }}"
      keyboardtype="T9"
      screentype="rect"
      vibratemode="short"
      maxlength="12"
      @complete="onComplete"
      @delete="onDelete"
    ></input-method>
  </div>
</template>

<style lang="less">
  @import '../../common/theme-tokens.less';

  /*
   * 同步页（方案 B：Cloudflare Workers + 端到端加密）。
   *
   * Vela 的硬限制（都踩过，别改回去）：
   *   · 样式是**页面级**的 —— 别的页面的 .action 在这里不存在，必须重定义
   *   · 没有后代选择器隔离，同名 class 会互相影响
   *   · div 默认 flex-direction: row（不是 block）
   *   · margin-top: auto / align-self 都不生效
   *   · 不支持 var() / linear-gradient
   */

  .sync-page {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 14px 20px;
    background-color: @ui-surface;
  }

  .topbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 56px;
  }

  .back {
    padding: 8px 20px;
    border-radius: 22px;
    background-color: @ui-surface-container;
  }

  .back__text {
    font-size: 22px;
    color: @ui-on-surface;
  }

  .title {
    font-size: 30px;
    font-weight: bold;
    color: @ui-on-surface;
    margin-top: 4px;
    lines: 1;
  }

  .lead {
    font-size: 16px;
    color: @ui-on-surface-variant;
    margin-top: 8px;
    lines: 3;
  }

  /* 配对码要能一眼抄走：大、字距拉开、居中 */
  .code-box {
    width: 100%;
    flex-direction: column;
    align-items: center;
    margin-top: 12px;
    padding: 12px 0;
    border-radius: @ui-radius-card;
    background-color: @ui-surface-card;
  }

  .code-box__label {
    font-size: 14px;
    color: @ui-on-surface-muted;
    lines: 1;
  }

  .code-box__value {
    font-size: 34px;
    font-weight: bold;
    color: @ui-primary;
    letter-spacing: 4px;
    margin-bottom: 4px;
    lines: 1;
  }

  .code-box__ttl {
    font-size: 13px;
    color: @ui-on-surface-muted;
    lines: 1;
  }

  .status {
    width: 100%;
    font-size: 16px;
    margin-top: 12px;
    text-align: center;
    lines: 3;
  }

  .hint {
    width: 100%;
    font-size: 13px;
    color: @ui-on-surface-muted;
    margin-top: 8px;
    lines: 4;
  }

  /* 正在输入的配对码 */
  .entry {
    width: 100%;
    font-size: 26px;
    font-weight: bold;
    color: @ui-on-surface;
    letter-spacing: 6px;
    text-align: center;
    margin-top: 10px;
    lines: 1;
  }

  .actions {
    width: 100%;
    flex-direction: column;
    margin-top: 14px;
  }

  .action {
    width: 100%;
    height: 60px;
    border-radius: @ui-radius-full;
    background-color: @ui-surface-container;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
  }

  .action__text {
    font-size: 18px;
    color: @ui-on-surface;
    lines: 1;
  }
</style>

<script>
  const { core, keys, navigation, store, syncAes, syncClient } = global.AstraMai;
  const { goBack } = navigation;
  const { readSetting, warmUp } = store;
  const { deriveIvBase64, deriveKeyBase64, encodeSyncPayload, decodeSyncPayload } = core;
  const { isSyncCryptoAvailable, encryptSyncPayload, decryptSyncPayload } = syncAes;
  const { getSyncBase, createSyncCode, putSyncPayload, getSyncPayload } = syncClient;

  /**
   * 4 位密码。
   *
   * `@system.crypto` 没有随机数接口，所以用 `Math.random()`。
   * 这里的强度要求不高 —— 它只是**第二道门**，第一道是那 6 位配对码
   * （服务器随机生成），而且 10 分钟就过期。
   */
  function makePin() {
    const n = Math.floor(Math.random() * 10000);
    return String(n).padStart(4, '0');
  }

  export default {
    private: {
      leadText: '',
      code: '',
      pin: '',
      statusText: '',
      statusColor: '#9bacd0',
      hint: '',
      canUpload: false,
      canPull: false,
      uploading: false,
      keyboardHidden: true,
      /** 用户正在输入的「配对码+密码」，形如 `123456-7890`。 */
      entryText: '',
      base: '',
    },

    onInit() {
      console.debug('[AstraMai] Sync onInit');
      warmUp([
        keys.QUERY_VALUE_KEY,
        keys.CURRENT_GAME_KEY,
        keys.B50_CACHE_INDEX_KEY,
      ])
        .then(() => this.begin())
        .catch((error) => {
          console.error('[AstraMai] Sync 初始化失败：', error);
          this.leadText = '初始化失败';
          this.statusText = '存储不可用，无法同步';
          this.statusColor = '#f2564b';
        });
    },

    begin() {
      this.base = getSyncBase(readSetting);

      if (!isSyncCryptoAvailable()) {
        this.leadText = '这台设备不支持同步';
        this.statusText = '缺少 AES 加密能力';
        this.statusColor = '#f2564b';
        this.hint = '手环系列不支持 AES。Watch S3 及以后、REDMI Watch 5/6 才行。';
        return;
      }

      this.leadText = '在两个设备之间搬数据';
      this.canPull = true;
      this.canUpload = true;
      this.hint = '上传：把手表上的成绩加密送到电脑。拉取：输入电脑上显示的配对码和密码。';
    },

    /**
     * 上传当前成绩。
     *
     * 流程：建码 → 读缓存 → 加密 → 上传。
     * **顺序不能反** —— 密钥里含配对码，没有码就没法加密。
     */
    onUpload() {
      if (this.uploading) return;

      const game = readSetting(keys.CURRENT_GAME_KEY, 'maimai') || 'maimai';
      const target = readSetting(keys.QUERY_VALUE_KEY, '');

      let view = null;
      try {
        const raw = readSetting(keys.b50CacheKey(game, target), '');
        if (raw) view = JSON.parse(raw);
      } catch (error) {
        console.warn('[AstraMai] 读 B50 缓存失败：', error);
      }

      if (!view) {
        this.statusText = '还没有成绩可以上传';
        this.statusColor = '#ffb020';
        this.hint = '先在 B50 页查一次成绩，再回来上传。';
        return;
      }

      this.uploading = true;
      this.statusText = '正在加密上传…';
      this.statusColor = '#9bacd0';

      const pin = makePin();
      let issued = '';

      createSyncCode(this.base, pin)
        .then((created) => {
          issued = created.code;
          this.code = created.code;
          this.pin = pin;

          const plaintext = encodeSyncPayload(game, view);
          return encryptSyncPayload(
            plaintext,
            deriveKeyBase64(pin, issued),
            deriveIvBase64(issued),
          ).then((cipher) => putSyncPayload(this.base, issued, pin, cipher));
        })
        .then(() => {
          this.uploading = false;
          this.statusText = '已加密上传';
          this.statusColor = '#3ddc84';
          this.hint = '在网页「同步 → 从手表取」输入上面的配对码和密码。';
        })
        .catch((error) => {
          this.uploading = false;
          this.code = '';
          this.pin = '';
          this.statusText = error && error.message ? error.message : '上传失败';
          this.statusColor = '#f2564b';
        });
    },

    toggleKeyboard() {
      this.keyboardHidden = !this.keyboardHidden;
    },

    onDelete() {
      this.entryText = this.entryText.slice(0, -1);
    },

    /**
     * 输入完成 —— 期望 `配对码-密码`（6 位数字 + 4 位数字）。
     *
     * 为什么用 T9 数字键盘而不是两个输入框：
     * 手表屏幕太小，两个框来回切焦点的体验很差。
     * 连起来输、用一个分隔符识别，用户少点一次。
     */
    onComplete(value) {
      const digits = String(value || '').replace(/\D/g, '');
      this.entryText = digits;

      if (digits.length < 10) {
        this.statusText = '还差 ' + (10 - digits.length) + ' 位';
        this.statusColor = '#9bacd0';
        return;
      }

      const code = digits.slice(0, 6);
      const pin = digits.slice(6, 10);

      this.keyboardHidden = true;
      this.pullingCode(code, pin);
    },

    /**
     * 拉取并解密。
     *
     * 拉回来的数据存进 `syncInbox`，B50 页可以读它直接渲染 ——
     * 这样"在电脑上填好友码，手表取过来查"这条路才闭合。
     */
    pullingCode(code, pin) {
      this.statusText = '正在拉取…';
      this.statusColor = '#9bacd0';

      getSyncPayload(this.base, code, pin)
        .then((body) =>
          decryptSyncPayload(body.payload, deriveKeyBase64(pin, code), deriveIvBase64(code)),
        )
        .then((plaintext) => {
          const decoded = decodeSyncPayload(plaintext);
          this.statusText = '取到了：' + summarize(decoded.view);
          this.statusColor = '#3ddc84';
          this.hint = '回到 B50 页用这份数据查询。';
          this.entryText = '';

          try {
            store.writeSetting('syncInbox', JSON.stringify(decoded));
          } catch (error) {
            console.warn('[AstraMai] 保存同步数据失败：', error);
          }
        })
        .catch((error) => {
          this.statusText = error && error.message ? error.message : '拉取失败';
          this.statusColor = '#f2564b';
          this.hint = '密码错了，或者这组码已经过期。';
        });
    },

    onBack() {
      goBack('/');
    },
  };

  /** 给载荷生成一句摘要 —— 手表上放不下细节。 */
  function summarize(view) {
    if (!view || typeof view !== 'object') return '空数据';

    const record = view;
    if (typeof record.kind === 'string' && typeof record.value === 'string') {
      return record.kind === 'friendCode' ? '好友码 ' + record.value : String(record.value);
    }

    const standard = Array.isArray(record.standard) ? record.standard.length : 0;
    const dx = Array.isArray(record.dx) ? record.dx.length : 0;
    if (standard || dx) return 'Best 50（' + standard + ' + ' + dx + '）';

    return '数据';
  }
</script>
