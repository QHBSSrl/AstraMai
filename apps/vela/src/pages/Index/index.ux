<template>
  <div class="page">
    <text class="brand">AstraMai</text>
    <text class="brand__sub">街机音游工具</text>

    <div class="menu">
      <div class="entry" @click="go('b50')">
        <text class="entry__title">Best 50</text>
        <text class="entry__sub">{{ targetSummary }}</text>
      </div>

      <div class="entry" @click="go('search')">
        <text class="entry__title">曲目搜索</text>
        <text class="entry__sub">日文曲名 · 中文别名 · 罗马音</text>
      </div>

      <div class="entry" @click="go('qr')">
        <text class="entry__title">二维码</text>
        <text class="entry__sub">{{ qrSummary }}</text>
      </div>
    </div>

    <text class="foot">{{ serverSummary }}</text>
  </div>
</template>

<style>
  .page {
    flex-direction: column;
    align-items: center;
    padding: 22px 20px;
    background-color: #070b16;
  }

  .brand {
    font-size: 38px;
    font-weight: bold;
    color: #ff5f9e;
  }

  .brand__sub {
    font-size: 20px;
    color: #9bacd0;
    margin-top: 4px;
  }

  .menu {
    flex-direction: column;
    width: 100%;
    margin-top: 20px;
  }

  .entry {
    flex-direction: column;
    padding: 16px 20px;
    margin-bottom: 12px;
    border-radius: 16px;
    background-color: #141d30;
  }

  .entry__title {
    font-size: 28px;
    color: #e8eefc;
  }

  .entry__sub {
    font-size: 17px;
    color: #9bacd0;
    margin-top: 4px;
  }

  .foot {
    font-size: 15px;
    color: #6d7fa3;
    margin-top: 8px;
  }
</style>

<script>
  // 刻意**不** import api.js：首页不需要网络，
  // 而 api.js 会连上 @system.fetch，拖进来只会让首页多一个初始化失败的可能。
  import { mark } from '../../common/diag.js';
  import { describeValidity, parseWahlapQrPayload } from '../../common/astramai-core.js';
  import { getServerBase } from '../../common/config.js';
  import { readSetting, warmUp } from '../../common/store.js';
  import { summarizeTarget } from '../../common/validate.js';

  /** router 也延迟取，避免平台模块不可用时整页初始化失败。 */
  let routerModule;
  function getRouter() {
    if (routerModule !== undefined) return routerModule;
    try {
      // eslint-disable-next-line global-require
      routerModule = require('@system.router') || null;
    } catch (error) {
      console.warn('[AstraMai] @system.router 不可用：', error);
      routerModule = null;
    }
    return routerModule;
  }

  const ROUTES = {
    b50: '/b50',
    search: '/search',
    qr: '/qr',
  };

  export default {
    private: {
      qrSummary: '未导入',
      targetSummary: '未保存，点击输入',
      serverSummary: '',
    },

    onReady() {
      mark('Index:onReady');
    },

    onInit() {
      mark('Index:onInit');
      console.log('[AstraMai] Index onInit');
      warmUp(['qrInput', 'serverBase', 'queryKind', 'queryValue', 'friendCode'])
        .then(() => this.refresh())
        .catch((error) => console.error('[AstraMai] Index 初始化失败：', error));
    },

    // 从其它页面返回时刷新
    onShow() {
      this.refresh();
    },

    refresh() {
      try {
        // 已保存的查分目标——展示出来让用户知道不用再输一遍
        const kind = readSetting('queryKind', 'friendCode') === 'qq' ? 'qq' : 'friendCode';
        const value =
          readSetting('queryValue', '') || readSetting('friendCode', '');
        this.targetSummary = summarizeTarget(kind, value) || '未保存，点击输入';

        const saved = readSetting('qrInput', '');
        if (!saved) {
          this.qrSummary = '未导入';
        } else {
          const payload = parseWahlapQrPayload(saved);
          if (!payload || !payload.content) {
            this.qrSummary = '内容无法识别';
          } else if (!payload.recognized) {
            this.qrSummary = '已导入（非机台二维码）';
          } else {
            const validity = describeValidity(payload);
            this.qrSummary =
              validity.state === 'valid'
                ? '有效 · ' + validity.text
                : validity.state === 'expired'
                  ? '已过期，需重新导入'
                  : '已导入';
          }
        }

        this.serverSummary = '服务端 ' + getServerBase();
      } catch (error) {
        console.error('[AstraMai] Index refresh 失败：', error);
      }
    },

    go(name) {
      const router = getRouter();
      if (!router) return;
      router.push({ uri: ROUTES[name] });
    },
  };
</script>
