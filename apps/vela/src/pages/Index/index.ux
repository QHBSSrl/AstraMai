<template>
  <div class="page">
    <!--
      顶栏：标题在左、设置在右。
      之前标题是居中的大 logo，加游戏之后首页入口会变多，
      把「设置 / 切换游戏 / 同步」这些收进右上角，首页才留得下功能入口。
    -->
    <div class="topbar">
      <text class="brand">AstraMai</text>
      <div class="settings-btn" @click="goSettings">
        <text class="settings-btn__text">设置</text>
      </div>
    </div>

    <!-- 当前游戏。整块可点，点了也进设置（切换游戏在那里） -->
    <div class="game" @click="goSettings">
      <text class="game__name">{{ gameLabel }}</text>
      <text class="game__hint">当前游戏 · 点此切换</text>
    </div>

    <div class="menu">
      <div class="entry" if="{{ showB50 }}" @click="go('b50')">
        <text class="entry__title">Best 50</text>
        <text class="entry__sub">{{ targetSummary }}</text>
      </div>

      <div class="entry" if="{{ showSearch }}" @click="go('search')">
        <text class="entry__title">曲目搜索</text>
        <text class="entry__sub">日文曲名 · 中文别名 · 罗马音</text>
      </div>

      <div class="entry" if="{{ showQr }}" @click="go('qr')">
        <text class="entry__title">二维码</text>
        <text class="entry__sub">{{ qrSummary }}</text>
      </div>

      <text class="empty" if="{{ !showB50 && !showSearch && !showQr }}">
        这个游戏还没有可用功能
      </text>
    </div>

  </div>
</template>

<style>
  .page {
    flex-direction: column;
    padding: 16px 20px;
    background-color: #070b16;
  }

  .topbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 56px;
  }

  /* 标题占满剩余宽度，设置按钮固定 —— 比 space-between 稳妥 */
  .brand {
    flex: 1;
    font-size: 32px;
    font-weight: bold;
    color: #ff5f9e;
  }

  .settings-btn {
    padding: 8px 18px;
    border-radius: 20px;
    background-color: #1c2740;
  }

  .settings-btn__text {
    font-size: 20px;
    color: #e8eefc;
  }

  .game {
    flex-direction: column;
    width: 100%;
    padding: 14px 18px;
    margin-top: 8px;
    border-radius: 14px;
    background-color: #141d30;
  }

  .game__name {
    font-size: 24px;
    color: #4fd6ff;
  }

  .game__hint {
    font-size: 15px;
    color: #6d7fa3;
    margin-top: 2px;
  }

  .menu {
    flex-direction: column;
    width: 100%;
    margin-top: 14px;
  }

  .entry {
    flex-direction: column;
    padding: 16px 20px;
    margin-bottom: 12px;
    border-radius: 16px;
    background-color: #141d30;
  }

  .entry__title {
    font-size: 28px;
    color: #e8eefc;
  }

  .entry__sub {
    font-size: 16px;
    color: #9bacd0;
    margin-top: 4px;
  }

  .empty {
    font-size: 17px;
    color: #6d7fa3;
    text-align: center;
    margin-top: 20px;
  }

  .foot {
    font-size: 15px;
    color: #6d7fa3;
    margin-top: 8px;
  }

  /*
   * ── 圆形屏适配 ─────────────────────────────────────────────────
   * 依据官方《多屏适配 · 页面标题栏》：
   *   「在圆屏、胶囊屏等存在边缘剪切的设备上，标题栏会使用多行设计，
   *     保证顶部的展示内容长度不会超出屏幕；而在矩形屏幕上则做单行左右布局。」
   *
   * 圆屏四角是物理裁掉的：466×466 的屏，顶栏中心 y≈44 处可用宽度只有约 272px，
   * 而「标题在左 + 设置在右」需要整幅 466px，两端必然被切。
   * 所以这里改竖排居中，并加左右内边距把内容压进圆内接矩形。
   *
   * **只影响 shape: circle**，矩形屏样式与行为完全不变。
   */
  @media (shape: circle) {
    .page {
      padding-left: 40px;
      padding-right: 40px;
    }

    /* 顶栏改竖排居中：单行左右布局在圆屏上两端必被裁 */
    .topbar {
      flex-direction: column;
      align-items: center;
      height: auto;
    }

    /* 返回键/标题不再靠边，改为居中并留出上下间距 */
    .back {
      margin-bottom: 8px;
    }
  }
</style>

<script>
  // 刻意**不** import api.js：首页不需要网络，
  // 而 api.js 会连上 @system.fetch，拖进来只会让首页多一个初始化失败的可能。
  // 共享模块从 global 取，不再 import（官方内存优化建议）。
  const { core, diag, games, navigation, store, validate } = global.AstraMai;
  const { describeValidity, parseWahlapQrPayload } = core;
  const { mark } = diag;
  const { gameById, gameHasFeature, readCurrentGame } = games;
  const { push } = navigation;
  const { readSetting, warmUp } = store;
  const { summarizeTarget } = validate;

  export default {
    private: {
      qrSummary: '未导入',
      targetSummary: '未保存，点击输入',
      gameLabel: '',
      showB50: false,
      showSearch: false,
      showQr: false,
    },

    onReady() {
      mark('Index:onReady');
    },

    onInit() {
      mark('Index:onInit');
      console.debug('[AstraMai] Index onInit');
      warmUp(['qrInput', 'serverBase', 'queryKind', 'queryValue', 'friendCode', 'currentGame'])
        .then(() => this.refresh())
        .catch((error) => console.error('[AstraMai] Index 初始化失败：', error));
    },

    // 从设置或其它页面返回时刷新（切换游戏后菜单要跟着变）
    onShow() {
      this.refresh();
    },

    refresh() {
      try {
        // ── 当前游戏决定显示哪些入口 ──
        const game = gameById(readCurrentGame(readSetting));
        this.gameLabel = game.label;
        // 按游戏的能力开关入口：中二还没接查分，就不显示 Best 50，
        // **宁可少显示，也别让玩家点进去报错**
        this.showB50 = gameHasFeature(game, 'b50');
        this.showSearch = gameHasFeature(game, 'search');
        this.showQr = gameHasFeature(game, 'qr');

        // 已保存的查分目标——展示出来让用户知道不用再输一遍
        const kind = readSetting('queryKind', 'friendCode') === 'qq' ? 'qq' : 'friendCode';
        const value = readSetting('queryValue', '') || readSetting('friendCode', '');
        this.targetSummary = summarizeTarget(kind, value) || '未保存，点击输入';

        const saved = readSetting('qrInput', '');
        if (!saved) {
          this.qrSummary = '未导入';
        } else {
          const payload = parseWahlapQrPayload(saved);
          if (!payload || !payload.content) {
            this.qrSummary = '内容无法识别';
          } else if (!payload.recognized) {
            this.qrSummary = '已导入（非机台二维码）';
          } else {
            const validity = describeValidity(payload);
            this.qrSummary =
              validity.state === 'valid'
                ? '有效 · ' + validity.text
                : validity.state === 'expired'
                  ? '已过期，需重新导入'
                  : '已导入';
          }
        }

      } catch (error) {
        console.error('[AstraMai] Index refresh 失败：', error);
      }
    },

    go(name) {
      push('/' + name);
    },

    goSettings() {
      push('/settings');
    },
  };
</script>
