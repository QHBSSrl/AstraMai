<template>
  <div class="page">
    <!--
      顶栏：标题在左、设置在右。
      之前标题是居中的大 logo，加游戏之后首页入口会变多，
      把「设置 / 切换游戏 / 同步」这些收进右上角，首页才留得下功能入口。
    -->
    <div class="topbar">
      <text class="brand">AstraMai</text>
      <div class="settings-btn" @click="goSettings">
        <text class="settings-btn__text">设置</text>
      </div>
    </div>

    <!-- 当前游戏。整块可点，点了也进设置（切换游戏在那里） -->
    <div class="game" @click="goSettings">
      <text class="game__name">{{ gameLabel }}</text>
      <text class="game__hint">当前游戏 · 点此切换</text>
    </div>

    <div class="menu">
      <div class="entry" if="{{ showB50 }}" @click="go('b50')">
        <text class="entry__title">Best 50</text>
        <text class="entry__sub">{{ targetSummary }}</text>
      </div>

      <div class="entry" if="{{ showSearch }}" @click="go('search')">
        <text class="entry__title">曲目搜索</text>
        <text class="entry__sub">日文曲名 · 中文别名 · 罗马音</text>
      </div>

      <div class="entry" if="{{ showQr }}" @click="go('qr')">
        <text class="entry__title">二维码</text>
        <text class="entry__sub">{{ qrSummary }}</text>
      </div>

      <text class="empty" if="{{ !showB50 && !showSearch && !showQr }}">
        这个游戏还没有可用功能
      </text>
    </div>

  </div>
</template>

<style lang="less">
  @import '../../common/theme-tokens.less';

  /*
   * 首页 · MD3 参考实现
   *
   * 采用的三条 MD3 原则：
   *
   *   1. **色调海拔**（tonal elevation）——层级靠**表面亮度**表达，不靠阴影。
   *      surface → surface-container → surface-container-high 依次变亮。
   *      这在手表上尤其对：Vela 的 box-shadow 要 APILevel 3，而我们是 2。
   *
   *   2. **颜色角色**——不直接写色号，一律用 token。
   *      「当前游戏」用 primary-container（强强调），功能入口用 surface-container。
   *
   *   3. **型阶**——字号从 display 到 caption 有明确层级，不再随手取值。
   */

  .page {
    flex-direction: column;
    padding: @ui-space-4 @ui-space-5;
    background-color: @ui-surface;
  }

  /* MD3 小号顶栏（small top app bar）：标题 + 一个动作 */
  .topbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 56px;
  }

  /* 品牌字：display 型阶 + 主色 */
  .brand {
    flex: 1;
    font-size: @ui-font-display;
    font-weight: bold;
    color: @ui-primary;
  }

  /*
   * 设置按钮：**实心胶囊**。
   *
   * 上一版是 MD3 的描边按钮（透明底 + 1px 描边 + 主色文字）。
   * 那种做法在手机上是为了区分「主/次动作」，但在一块只有三个入口的手表上，
   * 一个描边按钮会让顶栏显得比内容还讲究——这就是「设计感过强」的一部分。
   *
   * 现在：实心胶囊 + 中性底，靠亮度差和标题分开，不靠描边。
   */
  .settings-btn {
    padding: @ui-space-2 @ui-space-4;
    border-radius: @ui-radius-full;
    background-color: @ui-surface-container;
  }

  .settings-btn__text {
    font-size: @ui-font-label;
    color: @ui-on-surface;
  }

  /*
   * MD3 **主色容器卡片** ——「当前游戏」是这页最重要的状态，
   * 用 primary-container 让它一眼跳出来。选中态用主色容器是 MD3 的标准做法。
   */
  .game {
    flex-direction: column;
    width: 100%;
    padding: @ui-space-3 @ui-space-4;
    margin-top: @ui-space-2;
    border-radius: @ui-radius-card;
    background-color: @ui-surface-emphasis;
  }

  .game__name {
    font-size: @ui-font-title;
    font-weight: bold;
    color: @ui-on-surface;
  }

  /* 次要信息用透明度降权——MD3 处理 supporting text 的常规手法 */
  .game__hint {
    font-size: @ui-font-label;
    color: @ui-on-surface;
    opacity: 0.72;
    margin-top: 2px;
  }

  .menu {
    flex-direction: column;
    width: 100%;
    margin-top: @ui-space-3;
  }

  /* MD3 filled card：比底色亮一档，靠亮度而不是边框分层 */
  .entry {
    flex-direction: column;
    padding: @ui-space-4;
    margin-bottom: @ui-space-3;
    border-radius: @ui-radius-card;
    background-color: @ui-surface-card;
  }

  .entry__title {
    font-size: @ui-font-headline;
    color: @ui-on-surface;
  }

  .entry__sub {
    font-size: @ui-font-label;
    color: @ui-on-surface-variant;
    margin-top: 2px;
  }

  .empty {
    font-size: @ui-font-body;
    color: @ui-on-surface-variant;
    text-align: center;
    margin-top: @ui-space-5;
  }

  .foot {
    font-size: @ui-font-caption;
    color: @ui-on-surface-variant;
    margin-top: @ui-space-2;
  }

  /*
   * ── 圆形屏适配 ─────────────────────────────────────────────────
   * 依据官方《多屏适配 · 页面标题栏》：
   *   「在圆屏、胶囊屏等存在边缘剪切的设备上，标题栏会使用多行设计，
   *     保证顶部的展示内容长度不会超出屏幕；而在矩形屏幕上则做单行左右布局。」
   *
   * 圆屏四角是物理裁掉的：466×466 的屏，顶栏中心 y≈44 处可用宽度只有约 272px，
   * 而「标题在左 + 设置在右」需要整幅 466px，两端必然被切。
   * 所以这里改竖排居中，并加左右内边距把内容压进圆内接矩形。
   *
   * **只影响 shape: circle**，矩形屏样式与行为完全不变。
   */
  @media (shape: circle) {
    .page {
      padding-left: 40px;
      padding-right: 40px;
    }

    /* 顶栏改竖排居中：单行左右布局在圆屏上两端必被裁 */
    .topbar {
      flex-direction: column;
      align-items: center;
      height: auto;
    }

    /* 返回键/标题不再靠边，改为居中并留出上下间距 */
    .back {
      margin-bottom: @ui-space-2;
    }
  }
</style>

<script>
  // 刻意**不** import api.js：首页不需要网络，
  // 而 api.js 会连上 @system.fetch，拖进来只会让首页多一个初始化失败的可能。
  // 共享模块从 global 取，不再 import（官方内存优化建议）。
  const { core, diag, games, navigation, store, validate } = global.AstraMai;
  const { describeValidity, parseWahlapQrPayload } = core;
  const { mark } = diag;
  const { gameById, gameHasFeature, readCurrentGame } = games;
  const { push } = navigation;
  const { readSetting, warmUp } = store;
  const { summarizeTarget } = validate;

  export default {
    private: {
      qrSummary: '未导入',
      targetSummary: '未保存，点击输入',
      gameLabel: '',
      showB50: false,
      showSearch: false,
      showQr: false,
    },

    onReady() {
      mark('Index:onReady');
    },

    onInit() {
      mark('Index:onInit');
      console.debug('[AstraMai] Index onInit');
      warmUp(['qrInput', 'serverBase', 'queryKind', 'queryValue', 'friendCode', 'currentGame', 'oobeShown'])
        .then(() => {
          this.refresh();
          /*
           * 首次启动进引导。
           *
           * ⚠️ 判断的是 **`oobeShown`（弹过没）**，不是「走完没」。
           * 上一版用的是 `oobeDone`，只在引导最后一步才写——
           * 用户中途退出就白写了，于是**每次启动都弹**。
           *
           * 现在引导页在 `onInit` 里一进来就写 `oobeShown`，
           * 所以这里判断一次就够，不会反复骚扰。
           *
           * 为什么放在 Index 而不是 app.ux：
           * `readSetting` 在存储预热之前会静默返回兜底值，
           * 那样会把「已看过」读成空——必须等 `warmUp` 完成再判断。
           */
          if (!readSetting('oobeShown', '')) push('/welcome');
        })
        .catch((error) => console.error('[AstraMai] Index 初始化失败：', error));
    },

    // 从设置或其它页面返回时刷新（切换游戏后菜单要跟着变）
    onShow() {
      this.refresh();
    },

    refresh() {
      try {
        // ── 当前游戏决定显示哪些入口 ──
        const game = gameById(readCurrentGame(readSetting));
        this.gameLabel = game.label;
        // 按游戏的能力开关入口：中二还没接查分，就不显示 Best 50，
        // **宁可少显示，也别让玩家点进去报错**
        this.showB50 = gameHasFeature(game, 'b50');
        this.showSearch = gameHasFeature(game, 'search');
        this.showQr = gameHasFeature(game, 'qr');

        // 已保存的查分目标——展示出来让用户知道不用再输一遍
        const kind = readSetting('queryKind', 'friendCode') === 'qq' ? 'qq' : 'friendCode';
        const value = readSetting('queryValue', '') || readSetting('friendCode', '');
        this.targetSummary = summarizeTarget(kind, value) || '未保存，点击输入';

        const saved = readSetting('qrInput', '');
        if (!saved) {
          this.qrSummary = '未导入';
        } else {
          const payload = parseWahlapQrPayload(saved);
          if (!payload || !payload.content) {
            this.qrSummary = '内容无法识别';
          } else if (!payload.recognized) {
            this.qrSummary = '已导入（非机台二维码）';
          } else {
            const validity = describeValidity(payload);
            this.qrSummary =
              validity.state === 'valid'
                ? '有效 · ' + validity.text
                : validity.state === 'expired'
                  ? '已过期，需重新导入'
                  : '已导入';
          }
        }

      } catch (error) {
        console.error('[AstraMai] Index refresh 失败：', error);
      }
    },

    go(name) {
      push('/' + name);
    },

    goSettings() {
      push('/settings');
    },
  };
</script>
