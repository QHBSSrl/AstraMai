<template>
  <div class="page">
    <!-- 返回键：手表上没有可见的返回入口，用户得知道「边缘侧滑」这个隐藏手势 -->
    <div class="topbar">
      <div class="back" @click="onBack">
        <text class="back__text">‹ 返回</text>
      </div>
    </div>

    <text class="title">设置</text>

    <!-- 游戏切换 -->
    <text class="section">游戏</text>
    <div class="rows">
      <div class="row" for="{{ gameRows }}" @click="selectGame($item.id)">
        <text class="row__label" style="color: {{ $item.current ? '#4fd6ff' : '#e8eefc' }}">{{ $item.label }}</text>
        <text class="row__mark" if="{{ $item.current }}">当前</text>
      </div>
    </div>

    <!-- 功能 -->
    <text class="section">功能</text>
    <div class="rows">
      <!--
        同步暂时关闭：后端目前是裸 IP，等换成能绑域名的服务器再放出来。
        这里不做成「点了报错」，而是**直接告诉用户暂不可用**——
        点进去再失败对用户更糟。
      -->
      <div class="row row--off" @click="explainSyncUnavailable">
        <text class="row__label row__label--off">同步到手表</text>
        <text class="row__mark">暂不可用</text>
      </div>
      <!--
        Phigros 的凭证来自 TapTap 扫码，只能在这里登一次。
        和其它源不同（落雪是服务端一把密钥，玩家不用登录），所以单列一项。
      -->
      <div class="row" @click="goPhigrosLogin">
        <text class="row__label">Phigros 登录</text>
        <text class="row__mark">{{ phigrosStatus }}</text>
      </div>
    </div>
    <text class="hint">同步功能依赖的服务端正在迁移，暂时不可用。</text>
    <text class="hint hint--warn" if="{{ syncNotice }}">{{ syncNotice }}</text>
    <text class="hint">Phigros 需要先用 TapTap 扫码登录一次，之后就不用再扫。</text>

    <text class="foot">AstraMai · 街机音游工具</text>
  </div>
</template>

<style>
  .page {
    flex-direction: column;
    padding: 14px 20px;
    background-color: #070b16;
  }

  .topbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 56px;
  }

  .back {
    padding: 8px 20px;
    border-radius: 22px;
    background-color: #1c2740;
  }

  .back__text {
    font-size: 22px;
    color: #e8eefc;
  }

  .title {
    font-size: 30px;
    font-weight: bold;
    color: #e8eefc;
    margin-top: 4px;
  }

  .section {
    font-size: 16px;
    color: #6d7fa3;
    margin-top: 20px;
    margin-bottom: 8px;
  }

  .rows {
    flex-direction: column;
    width: 100%;
    border-radius: 14px;
    background-color: #141d30;
  }

  .row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 64px;
    padding: 0 18px;
  }

  .row--static {
    height: 56px;
  }

  .row__label {
    flex: 1;
    font-size: 22px;
    color: #e8eefc;
  }

  .row__value {
    font-size: 16px;
    color: #9bacd0;
  }

  .row__mark {
    font-size: 19px;
    color: #4fd6ff;
  }

  /* 不可用的行：压暗，并且不显示「›」（它点不动，给箭头是误导） */
  .row--off {
    opacity: 0.5;
  }

  .row__label--off {
    color: #9bacd0;
  }

  .hint--warn {
    color: #f2a33c;
  }

  .hint {
    font-size: 14px;
    color: #6d7fa3;
    margin-top: 8px;
    line-height: 1.5;
  }

  .foot {
    font-size: 14px;
    color: #4a5a78;
    text-align: center;
    margin-top: 24px;
  }
</style>

<script>
  const { diag, games, navigation, store } = global.AstraMai;
  const { mark } = diag;
  const { GAMES, readCurrentGame, writeCurrentGame } = games;
  const { goBack, push } = navigation;
  const { readSetting, warmUp, writeSetting } = store;

  export default {
    private: {
      gameRows: [],
      /** 同步为何不可用——点一下会展开说明。 */
      syncNotice: '',
      /** Phigros 的登录状态。空串表示没登录过。 */
      phigrosStatus: '未登录',
    },

    onReady() {
      mark('Settings:onReady');
    },

    onInit() {
      mark('Settings:onInit');
      warmUp(['currentGame', 'qrInput', 'queryKind', 'queryValue', 'friendCode', 'phigrosSession'])
        .then(() => this.refresh())
        .catch((error) => console.error('[AstraMai] Settings 初始化失败：', error));
    },

    refresh() {
      const current = readCurrentGame(readSetting);
      // 做成可直接渲染的行，模板里就不用再算
      this.gameRows = GAMES.map((game) => ({
        id: game.id,
        label: game.label,
        current: game.id === current,
      }));

      // 只是「有没有登录」这一个比特，**不读出来展示**——
      // 凭证不该出现在界面上，截图分享时也安全
      this.phigrosStatus = readSetting('phigrosSession', '') ? '已登录' : '未登录';
    },

    /**
     * 切换游戏。
     *
     * 切换后**停在本页**而不是自动返回：让玩家看到「当前」标记跟着变了，
     * 否则点一下什么都没发生，会以为没生效。
     */
    selectGame(id) {
      try {
        writeCurrentGame(writeSetting, id);
        this.refresh();
      } catch (error) {
        console.error('[AstraMai] 切换游戏失败：', error);
      }
    },

    /**
     * 同步暂不可用。
     *
     * 不跳转、也不弹错——只是把原因写在页面上。
     * 等后端换成能绑域名的服务器，把这里改回 push('/sync') 即可。
     */
    explainSyncUnavailable() {
      this.syncNotice = 'API 服务器问题，功能暂不可用。';
    },

    goPhigrosLogin() {
      push('/phigros-login');
    },

    onBack() {
      goBack('/');
    },
  };
</script>
