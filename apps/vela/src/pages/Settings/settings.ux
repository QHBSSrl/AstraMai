<template>
  <div class="page">
    <!-- 返回键：手表上没有可见的返回入口，用户得知道「边缘侧滑」这个隐藏手势 -->
    <div class="topbar">
      <div class="back" @click="onBack">
        <text class="back__text">‹ 返回</text>
      </div>
    </div>

    <text class="title">设置</text>

    <!-- 游戏切换 -->
    <text class="section">游戏</text>
    <div class="rows">
      <div class="row" for="{{ gameRows }}" @click="selectGame($item.id)">
        <text class="row__label" style="color: {{ $item.current ? '#4fd6ff' : '#e8eefc' }}">{{ $item.label }}</text>
        <text class="row__mark" if="{{ $item.current }}">当前</text>
      </div>
    </div>

    <!-- 功能 -->
    <text class="section">功能</text>
    <div class="rows">
      <!--
        同步暂时关闭：后端目前是裸 IP，等换成能绑域名的服务器再放出来。
        这里不做成「点了报错」，而是**直接告诉用户暂不可用**——
        点进去再失败对用户更糟。
      -->
      <div class="row row--off" @click="explainSyncUnavailable">
        <text class="row__label row__label--off">同步到手表</text>
        <text class="row__mark">暂不可用</text>
      </div>
      <!--
        Phigros 的凭证来自 TapTap 扫码，只能在这里登一次。
        和其它源不同（落雪是服务端一把密钥，玩家不用登录），所以单列一项。
      -->
      <div class="row" @click="goPhigrosLogin">
        <text class="row__label">Phigros 登录</text>
        <text class="row__mark">{{ phigrosStatus }}</text>
      </div>
    </div>
    <text class="hint">同步功能依赖的服务端正在迁移，暂时不可用。</text>
    <text class="hint hint--warn" if="{{ syncNotice }}">{{ syncNotice }}</text>
    <text class="hint">Phigros 需要先用 TapTap 扫码登录一次，之后就不用再扫。</text>

    <text class="foot">AstraMai · 街机音游工具</text>
  </div>
</template>

<style lang="less">
  @import '../../common/theme-tokens.less';

  .page {
    flex-direction: column;
    padding: 14px 20px;
    background-color: @ui-surface;
  }

  .topbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 56px;
  }

  .back {
    padding: 8px 20px;
    border-radius: 22px;
    background-color: @ui-surface-container;
  }

  .back__text {
    font-size: 22px;
    color: @ui-on-surface;
  }

  .title {
    font-size: 30px;
    font-weight: bold;
    color: @ui-on-surface;
    margin-top: 4px;
  }

  .section {
    font-size: 16px;
    color: @ui-on-surface-variant;
    margin-top: 20px;
    margin-bottom: 8px;
  }

  .rows {
    flex-direction: column;
    width: 100%;
    border-radius: 14px;
    background-color: @ui-surface-card;
  }

  .row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 64px;
    padding: 0 18px;
  }

  .row--static {
    height: 56px;
  }

  .row__label {
    flex: 1;
    font-size: 22px;
    color: @ui-on-surface;
  }

  .row__value {
    font-size: 16px;
    color: @ui-on-surface-variant;
  }

  .row__mark {
    font-size: 19px;
    color: #4fd6ff;
  }

  /* 不可用的行：压暗，并且不显示「›」（它点不动，给箭头是误导） */
  .row--off {
    opacity: 0.5;
  }

  .row__label--off {
    color: @ui-on-surface-variant;
  }

  .hint--warn {
    color: @ui-warning;
  }

  .hint {
    font-size: 14px;
    color: @ui-on-surface-variant;
    margin-top: 8px;
    line-height: 1.5;
  }

  .foot {
    font-size: 14px;
    color: @ui-outline;
    text-align: center;
    margin-top: 24px;
  }

  /*
   * ── 圆形屏适配 ─────────────────────────────────────────────────
   * 依据官方《多屏适配 · 页面标题栏》：
   *   「在圆屏、胶囊屏等存在边缘剪切的设备上，标题栏会使用多行设计，
   *     保证顶部的展示内容长度不会超出屏幕；而在矩形屏幕上则做单行左右布局。」
   *
   * 圆屏四角是物理裁掉的：466×466 的屏，顶栏中心 y≈44 处可用宽度只有约 272px，
   * 而「标题在左 + 设置在右」需要整幅 466px，两端必然被切。
   * 所以这里改竖排居中，并加左右内边距把内容压进圆内接矩形。
   *
   * **只影响 shape: circle**，矩形屏样式与行为完全不变。
   */
  @media (shape: circle) {
    .page {
      padding-left: 40px;
      padding-right: 40px;
    }

    /* 顶栏改竖排居中：单行左右布局在圆屏上两端必被裁 */
    .topbar {
      flex-direction: column;
      align-items: center;
      height: auto;
    }

    /* 返回键/标题不再靠边，改为居中并留出上下间距 */
    .back {
      margin-bottom: 8px;
    }
  }
</style>

<script>
  const { diag, games, navigation, store } = global.AstraMai;
  const { mark } = diag;
  const { GAMES, readCurrentGame, writeCurrentGame } = games;
  const { goBack, push } = navigation;
  const { readSetting, warmUp, writeSetting } = store;

  export default {
    private: {
      gameRows: [],
      /** 同步为何不可用——点一下会展开说明。 */
      syncNotice: '',
      /** Phigros 的登录状态。空串表示没登录过。 */
      phigrosStatus: '未登录',
    },

    onReady() {
      mark('Settings:onReady');
    },

    onInit() {
      mark('Settings:onInit');
      warmUp(['currentGame', 'qrInput', 'queryKind', 'queryValue', 'friendCode', 'phigrosSession'])
        .then(() => this.refresh())
        .catch((error) => console.error('[AstraMai] Settings 初始化失败：', error));
    },

    refresh() {
      const current = readCurrentGame(readSetting);
      // 做成可直接渲染的行，模板里就不用再算
      this.gameRows = GAMES.map((game) => ({
        id: game.id,
        label: game.label,
        current: game.id === current,
      }));

      // 只是「有没有登录」这一个比特，**不读出来展示**——
      // 凭证不该出现在界面上，截图分享时也安全
      this.phigrosStatus = readSetting('phigrosSession', '') ? '已登录' : '未登录';
    },

    /**
     * 切换游戏。
     *
     * 切换后**停在本页**而不是自动返回：让玩家看到「当前」标记跟着变了，
     * 否则点一下什么都没发生，会以为没生效。
     */
    selectGame(id) {
      try {
        writeCurrentGame(writeSetting, id);
        this.refresh();
      } catch (error) {
        console.error('[AstraMai] 切换游戏失败：', error);
      }
    },

    /**
     * 同步暂不可用。
     *
     * 不跳转、也不弹错——只是把原因写在页面上。
     * 等后端换成能绑域名的服务器，把这里改回 push('/sync') 即可。
     */
    explainSyncUnavailable() {
      this.syncNotice = 'API 服务器问题，功能暂不可用。';
    },

    goPhigrosLogin() {
      push('/phigros-login');
    },

    onBack() {
      goBack('/');
    },
  };
</script>
