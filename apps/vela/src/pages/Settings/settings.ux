<template>
  <div class="page">
    <!-- 返回键：手表上没有可见的返回入口，用户得知道「边缘侧滑」这个隐藏手势 -->
    <div class="topbar">
      <div class="back" @click="onBack">
        <text class="back__text">‹ 返回</text>
      </div>
    </div>

    <text class="title">设置</text>

    <!-- 游戏切换 -->
    <text class="section">游戏</text>
    <div class="rows">
      <div class="row" for="{{ gameRows }}" @click="selectGame($item.id)">
        <text class="row__label" style="color: {{ $item.current ? '#4fd6ff' : '#e8eefc' }}">{{ $item.label }}</text>
        <text class="row__mark" if="{{ $item.current }}">当前</text>
      </div>
    </div>

    <!-- 功能 -->
    <text class="section">功能</text>
    <div class="rows">
      <!--
        同步到手表：在电脑上敲好友码，手表取过来。
        手表上没有好用的输入法，所以这是唯一舒服的填法。
      -->
      <div class="row" @click="goSync">
        <text class="row__label">同步到手表</text>
        <text class="row__mark">›</text>
      </div>
      <!--
        Phigros 的凭证来自 TapTap 扫码，只能在这里登一次。
        和其它源不同（落雪是服务端一把密钥，玩家不用登录），所以单列一项。
      -->
      <div class="row" @click="goPhigrosLogin">
        <text class="row__label">Phigros 登录</text>
        <text class="row__mark">{{ phigrosStatus }}</text>
      </div>
    </div>
    <text class="hint">同步：在电脑上填好友码，手表取过来。手表上不用打字。</text>
    <text class="hint hint--warn" if="{{ syncNotice }}">{{ syncNotice }}</text>
    <text class="hint">Phigros 需要先用 TapTap 扫码登录一次，之后就不用再扫。</text>

    <!--
      用户群入口。
      **只在配置了群号时出现**（见 common/community.js）——
      没配就显示一个空群号，比不显示更糟。

      引导页里也有一步，但引导可以跳过，而且老版本装上的用户没有引导，
      所以设置页必须留一个长期入口。
    -->
    <block if="{{ groupNumber }}">
      <text class="section">反馈</text>
      <div class="rows">
        <div class="row" @click="showGroup">
          <text class="row__label">加入用户群</text>
          <text class="row__mark">{{ groupNumber }}</text>
        </div>
      </div>
    </block>

    <!--
      网桥：没有网络的设备（手环）靠 AstroBox 插件中转上网。
      手表自己能上网，用不上这个 —— 所以只在连不上时才有意义。

      这里放一行「测试连接」，是因为网桥涉及三个东西：
        Vela App ↔ AstroBox 插件 ↔ 我们的服务器
      任何一环断了，用户看到的现象都是"查不出成绩"，
      没有这个诊断入口就只能靠猜。
    -->
    <text class="section">网桥</text>
    <div class="rows">
      <div class="row" @click="testBridge">
        <text class="row__label">测试连接</text>
        <text class="row__mark">{{ bridgeState }}</text>
      </div>
      <div class="row" @click="toggleBridgeMode">
        <text class="row__label">传输方式</text>
        <text class="row__mark">{{ bridgeModeLabel }}</text>
      </div>
    </div>
    <text class="hint" if="{{ bridgeNotice }}">{{ bridgeNotice }}</text>
    <text class="hint" if="{{ bridgeHint }}">{{ bridgeHint }}</text>

    <!--
      重看引导。
      两个用处：
        1. 用户想再看一遍协议 —— 这是正经需求，不是调试后门
        2. **开发时要反复看引导页** —— 不然只能在设备上刷数据才能再看到
    -->
    <text class="section">关于</text>
    <div class="rows">
      <div class="row" @click="replayOnboarding">
        <text class="row__label">重看新手引导</text>
        <text class="row__mark">›</text>
      </div>
    </div>

    <text class="foot">AstraMai · 街机音游工具</text>
  </div>
</template>

<style lang="less">
  @import '../../common/theme-tokens.less';

  .page {
    flex-direction: column;
    padding: 14px 20px;
    background-color: @ui-surface;
  }

  .topbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 56px;
  }

  .back {
    padding: 8px 20px;
    border-radius: 22px;
    background-color: @ui-surface-container;
  }

  .back__text {
    font-size: 22px;
    color: @ui-on-surface;
  }

  .title {
    font-size: 30px;
    font-weight: bold;
    color: @ui-on-surface;
    margin-top: 4px;
  }

  .section {
    font-size: 16px;
    color: @ui-on-surface-variant;
    margin-top: 20px;
    margin-bottom: 8px;
  }

  .rows {
    flex-direction: column;
    width: 100%;
    border-radius: 14px;
    background-color: @ui-surface-card;
  }

  .row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 64px;
    padding: 0 18px;
  }

  .row--static {
    height: 56px;
  }

  .row__label {
    flex: 1;
    font-size: 22px;
    color: @ui-on-surface;
  }

  .row__value {
    font-size: 16px;
    color: @ui-on-surface-variant;
  }

  .row__mark {
    font-size: 19px;
    color: #4fd6ff;
  }

  /* 不可用的行：压暗，并且不显示「›」（它点不动，给箭头是误导） */
  .row--off {
    opacity: 0.5;
  }

  .row__label--off {
    color: @ui-on-surface-variant;
  }

  .hint--warn {
    color: @ui-warning;
  }

  .hint {
    font-size: 14px;
    color: @ui-on-surface-variant;
    margin-top: 8px;
    line-height: 1.5;
  }

  .foot {
    font-size: 14px;
    color: @ui-outline;
    text-align: center;
    margin-top: 24px;
  }

  /*
   * ── 圆形屏适配 ─────────────────────────────────────────────────
   * 依据官方《多屏适配 · 页面标题栏》：
   *   「在圆屏、胶囊屏等存在边缘剪切的设备上，标题栏会使用多行设计，
   *     保证顶部的展示内容长度不会超出屏幕；而在矩形屏幕上则做单行左右布局。」
   *
   * 圆屏四角是物理裁掉的：466×466 的屏，顶栏中心 y≈44 处可用宽度只有约 272px，
   * 而「标题在左 + 设置在右」需要整幅 466px，两端必然被切。
   * 所以这里改竖排居中，并加左右内边距把内容压进圆内接矩形。
   *
   * **只影响 shape: circle**，矩形屏样式与行为完全不变。
   */
  @media (shape: circle) {
    .page {
      padding-left: 40px;
      padding-right: 40px;
    }

    /* 顶栏改竖排居中：单行左右布局在圆屏上两端必被裁 */
    .topbar {
      flex-direction: column;
      align-items: center;
      height: auto;
    }

    /* 返回键/标题不再靠边，改为居中并留出上下间距 */
    .back {
      margin-bottom: 8px;
    }
  }
</style>

<script>
  const { bridge, community, diag, games, navigation, store } = global.AstraMai;
  const { mark } = diag;
  const { groupNumber } = community;
  const { GAMES, readCurrentGame, writeCurrentGame } = games;
  const { goBack, push } = navigation;
  const { clearSetting, readSetting, warmUp, writeSetting } = store;

  export default {
    private: {
      gameRows: [],
      /** 同步为何不可用——点一下会展开说明。 */
      syncNotice: '',
      /** Phigros 的登录状态。空串表示没登录过。 */
      phigrosStatus: '未登录',
      /** 群号。没配置时为空串，模板里那一整块就不渲染。 */
      groupNumber: '',
      /**
       * 网桥状态，显示在「测试连接」右边。
       * 空串表示还没测过。
       */
      bridgeState: '',
      /** 网桥测试的详细结果 / 失败原因。 */
      bridgeNotice: '',
      /** 传输方式的显示文本（「完整」/「分片」）。 */
      bridgeModeLabel: '',
      /** 网桥的固定提示。手环上才显示，说明这东西是干什么的。 */
      bridgeHint: '',
    },

    onReady() {
      mark('Settings:onReady');
    },

    onInit() {
      mark('Settings:onInit');
      warmUp([
        'currentGame',
        'qrInput',
        'queryKind',
        'queryValue',
        'friendCode',
        'phigrosSession',
        'bridgeMode',
      ])
        .then(() => this.refresh())
        .catch((error) => console.error('[AstraMai] Settings 初始化失败：', error));
    },

    refresh() {
      const current = readCurrentGame(readSetting);
      // 群号是编译期常量，但每次 refresh 都重算一遍，免得漏掉
      this.groupNumber = groupNumber();
      // 做成可直接渲染的行，模板里就不用再算
      this.gameRows = GAMES.map((game) => ({
        id: game.id,
        label: game.label,
        current: game.id === current,
      }));

      /*
       * 网桥：手环没有 @system.fetch，只能靠手机上的 AstroBox 插件。
       *
       * 这里做两件事：
       *   · 刷新「传输方式」那行的文字（完整 / 分片）
       *   · 手环上给一句固定提示，告诉用户这东西是干什么的
       */
      this.refreshBridgeModeLabel();

      try {
        // eslint-disable-next-line global-require
        require('@system.fetch');
        this.bridgeHint = '';
      } catch (error) {
        // 没有 fetch = 手环 = 需要网桥
        this.bridgeHint =
          '这个设备没有网络模块，查成绩要靠手机上的 AstroBox 装「AstraMai 网桥」插件。'
          + '装好启用后点上面的「测试连接」确认。';
      }

      // 只是「有没有登录」这一个比特，**不读出来展示**——
      // 凭证不该出现在界面上，截图分享时也安全
      this.phigrosStatus = readSetting('phigrosSession', '') ? '已登录' : '未登录';
    },

    /**
     * 切换游戏。
     *
     * 切换后**停在本页**而不是自动返回：让玩家看到「当前」标记跟着变了，
     * 否则点一下什么都没发生，会以为没生效。
     */
    selectGame(id) {
      try {
        writeCurrentGame(writeSetting, id);
        this.refresh();
      } catch (error) {
        console.error('[AstraMai] 切换游戏失败：', error);
      }
    },

    /**
     * 同步暂不可用。
     *
     * 不跳转、也不弹错——只是把原因写在页面上。
     * 等后端换成能绑域名的服务器，把这里改回 push('/sync') 即可。
     */
    explainSyncUnavailable() {
      this.syncNotice = 'API 服务器问题，功能暂不可用。';
    },

    /**
     * 去同步页。
     *
     * 放在设置里而不是首页：它是**一次性配置**，不是日常功能。
     * 首页那几个（B50 / 搜索 / 二维码）天天用，同步一个月用一次，
     * 摆在一起只会把常用的挤下去。
     */
    goSync() {
      push('/sync');
    },

    goPhigrosLogin() {
      push('/phigros-login');
    },

    /**
     * 测试网桥。
     *
     * 发一个 `ping` —— 插件**不碰网络**就回 `pong`，
     * 所以这一条能把「链路通不通」和「服务器通不通」分开：
     *
     *   ping 成功          → Vela ↔ AstroBox 通了
     *   ping 成功但查不到   → 链路通，服务器或插件那边的问题
     *   ping 失败          → 插件没装 / 没启用 / 设备没连
     *
     * 没有这个入口的话，用户看到的现象都是"查不出成绩"，只能靠猜。
     */
    testBridge() {
      /*
       * 网桥是**手环唯一的联网方式** —— 手环没有 @system.fetch，
       * 只能靠手机上的 AstroBox 插件转发。
       *
       * 所以这个按钮是排查的核心入口：任何一环断了，用户看到的现象
       * 都是「查不出成绩」，没有它就只能靠猜。
       *
       * ⚠️ 用的是**官方 FetchBridge 的协议**（fetchbridge.js），
       * 不是我们自己那个 Python 插件（那个会弹浏览器窗口，已作废）。
       */
      const mode = fetchbridge.MODE
        ? fetchbridge.readBridgeMode()
        : fetchbridge.MODE.SINGLE;

      this.bridgeState = '测试中…';
      this.bridgeNotice = '';

      const client = fetchbridge.createFetchBridge({ mode });

      client.ping().then(
        () => {
          this.bridgeState = '已连通';
          this.bridgeNotice =
            '网桥正常。这个设备查成绩会走「手环 → 手机插件 → 服务器」这条链路。';
        },
        (error) => {
          this.bridgeState = '失败';
          /*
           * 把原因原样显示出来 —— 这类问题光说「失败」没法排查：
           *   · 插件没装 / 没启用 → 握手超时
           *   · 手机不在蓝牙范围   → 握手超时
           *   · 插件装了但连不上网 → 插件那边报的错
           */
          this.bridgeNotice = String(error && error.message ? error.message : error);
        },
      );
    },

    /**
     * 切换传输方式。
     *
     * 「完整」= 单消息，快，但单次响应不能超过 16 KB
     *          （我们用服务端的 /compact 端点把 B50 压到 12 KB）
     * 「分片」= v4 开放长度流，没有长度限制，但要处理重传和乱序
     *
     * 这是**用户可感知的取舍**，所以做成可切换的，不写死。
     */
    toggleBridgeMode() {
      const current = fetchbridge.readBridgeMode();
      const next =
        current === fetchbridge.MODE.STREAM
          ? fetchbridge.MODE.SINGLE
          : fetchbridge.MODE.STREAM;

      writeSetting('bridgeMode', next);
      this.refreshBridgeModeLabel();

      this.bridgeState = '待重测';
      this.bridgeNotice =
        next === fetchbridge.MODE.STREAM
          ? '已切到「分片」。响应不再受 16 KB 限制，但慢一些。点「测试连接」确认能通。'
          : '已切到「完整」。更快，但单次响应不能超过 16 KB。点「测试连接」确认能通。';
    },

    /** 刷新「传输方式」那一行显示的文字。 */
    refreshBridgeModeLabel() {
      const mode = fetchbridge.readBridgeMode();
      this.bridgeModeLabel = mode === fetchbridge.MODE.STREAM ? '分片' : '完整';
    },

    /**
     * 点群号时给出提示。
     *
     * 手表上**没法跳转到 QQ**（没有浏览器、没有深链支持），
     * 所以能做的是把群号显示清楚，让用户用手机去搜。
     * 假装能跳转只会让人点了没反应。
     */
    showGroup() {
      if (!this.groupNumber) return;
      // 复用同步功能的提示位，避免为一行字再开一个状态
      this.syncNotice = `群号 ${this.groupNumber} · 用手机搜群号即可加入`;
    },

    /**
     * 重看新手引导。
     *
     * 先清掉 `oobeShown`，再跳过去——不清的话下次启动不会再弹，
     * 但用户现在就要看，所以直接 push 过去。
     *
     * **这同时是开发时的调试入口**：`@system.storage` 在设备上
     * 没有暴露成文件，没法用 adb 删键，只能从界面上清。
     */
    replayOnboarding() {
      try {
        clearSetting('oobeShown');
      } catch (error) {
        console.warn('[AstraMai] 清除引导标记失败：', error);
      }
      push('/welcome');
    },

    onBack() {
      goBack('/');
    },
  };
</script>
