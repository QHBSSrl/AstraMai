<template>
  <div class="page-root">
    <div class="page">
      <!-- 进度用文字而不是圆点：小屏上圆点几乎看不见 -->
      <text class="progress">{{ step + 1 }} / {{ total }}</text>

      <!-- ── 1. 欢迎 ─────────────────────────────────────────────── -->
      <block if="{{ page === 'welcome' }}">
        <text class="hero">AstraMai</text>
        <text class="lead">功能全面的腕上音游工具</text>
        <text class="body">舞萌 DX · 中二节奏 · Phigros</text>
        <text class="body body--dim">欢迎加入用户群</text>
        <text class="group group--inline">{{ groupNumber }}</text>
      </block>

      <!-- ── 2. 用户协议 ─────────────────────────────────────────── -->
      <block if="{{ page === 'terms' }}">
        <text class="lead">用户协议</text>
        <text class="body body--dim">{{ termsSummary }}</text>
        <!-- 协议必须可滚动：手表一屏放不下任何一份协议 -->
        <scroll class="terms" scroll-y="true">
          <div class="terms__section" for="{{ termsSections }}">
            <text class="terms__title">{{ $item.title }}</text>
            <text class="terms__body">{{ $item.body }}</text>
          </div>
        </scroll>
      </block>

      <!-- ── 3. 配对 ─────────────────────────────────────────────── -->
      <block if="{{ page === 'pairing' }}">
        <text class="lead">要不要配对？</text>
        <text class="body">
          eSIM 手表（比如 REDMI Watch 5 eSIM）自己能联网，
          <text class="body--strong">不需要配对</text>。
        </text>
        <text class="body body--dim">
          其它设备要靠手机中转，这个功能还在做。
          现在可以先去用，以后能补。
        </text>
      </block>

      <!-- ── 4. 教程 ─────────────────────────────────────────────── -->
      <block if="{{ page === 'tutorial' }}">
        <text class="lead">三步上手</text>
        <scroll class="tutorial" scroll-y="true">
          <div class="tutorial__step" for="{{ tutorialSteps }}">
            <!-- 有图就显示图，没图自动退化成纯文字 -->
            <image class="tutorial__image" if="{{ $item.image }}" src="{{ $item.image }}"></image>
            <text class="tutorial__title">{{ $item.title }}</text>
            <text class="tutorial__body">{{ $item.body }}</text>
          </div>
        </scroll>
      </block>

      <!-- ── 5. 群二维码 ─────────────────────────────────────────── -->
      <block if="{{ page === 'community' }}">
        <text class="lead">加个群吧</text>
        <!--
          二维码必须白底黑码，深色底上扫不出来。
          没配 QQ_GROUP_KEY 时这一块不渲染，只显示群号。
        -->
        <div class="qr" if="{{ groupQr }}">
          <qrcode value="{{ groupQr }}"></qrcode>
        </div>
        <text class="group">{{ groupNumber }}</text>
        <text class="body body--dim">更新、修复、新功能都会发在群里</text>
      </block>

      <!-- ── 6. 完成 ─────────────────────────────────────────────── -->
      <block if="{{ page === 'done' }}">
        <text class="hero hero--small">准备就绪</text>
        <text class="body">去首页点「Best 50」，填一次好友码或 QQ 号</text>
        <text class="body body--dim">填过一次就会记住，下次直接看</text>
      </block>

      <div class="actions">
        <div class="action" @click="next">
          <text class="action__text action__text--filled">{{ primaryLabel }}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style lang="less">
  @import '../../common/theme-tokens.less';

  /*
   * 首次启动引导（OOBE）。**六步，没有跳过键。**
   *
   * ── 为什么每一屏只讲一件事 ──────────────────────────────────────
   *
   * 手表屏幕 466px，一屏塞两段话就没人看。所以：
   *   欢迎 → 协议 → 配对 → 教程 → 群 → 完成
   * 每屏一个大标题 + 最多三行正文。
   */

  .page-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    background-color: @ui-surface;
  }

  .page {
    flex: 1;
    width: 100%;
    flex-direction: column;
    padding: @ui-space-4 @ui-space-5;
    background-color: @ui-surface;
  }

  .progress {
    font-size: @ui-font-caption;
    color: @ui-on-surface-muted;
    text-align: center;
    margin-bottom: @ui-space-2;
  }

  .hero {
    font-size: 38px;
    font-weight: bold;
    color: @ui-primary;
    text-align: center;
    lines: 1;
    margin-top: @ui-space-3;
  }

  .hero--small {
    font-size: 30px;
  }

  .lead {
    font-size: @ui-font-title;
    color: @ui-on-surface;
    text-align: center;
    margin-top: @ui-space-3;
    lines: 2;
  }

  .body {
    font-size: @ui-font-label;
    color: @ui-on-surface-variant;
    text-align: center;
    margin-top: @ui-space-2;
    lines: 3;
  }

  .body--dim {
    color: @ui-on-surface-muted;
  }

  .body--strong {
    color: @ui-primary;
  }

  .group {
    font-size: @ui-font-headline;
    font-weight: bold;
    color: @ui-primary;
    text-align: center;
    margin-top: @ui-space-2;
    lines: 1;
  }

  .group--inline {
    margin-top: @ui-space-1;
  }

  /* 协议：可滚动，高度吃满剩余空间 */
  .terms {
    flex: 1;
    width: 100%;
    margin-top: @ui-space-2;
  }

  .terms__section {
    flex-direction: column;
    margin-bottom: @ui-space-3;
  }

  .terms__title {
    font-size: @ui-font-label;
    font-weight: bold;
    color: @ui-primary;
    lines: 1;
  }

  .terms__body {
    font-size: @ui-font-caption;
    color: @ui-on-surface-variant;
    margin-top: 2px;
  }

  /* 教程 */
  .tutorial {
    flex: 1;
    width: 100%;
    margin-top: @ui-space-2;
  }

  .tutorial__step {
    flex-direction: column;
    margin-bottom: @ui-space-3;
    padding: @ui-space-2;
    border-radius: @ui-radius-md;
    background-color: @ui-surface-card;
  }

  .tutorial__image {
    width: 100%;
    height: 120px;
    border-radius: @ui-radius-sm;
    margin-bottom: @ui-space-1;
  }

  .tutorial__title {
    font-size: @ui-font-label;
    font-weight: bold;
    color: @ui-on-surface;
    lines: 1;
  }

  .tutorial__body {
    font-size: @ui-font-caption;
    color: @ui-on-surface-variant;
    margin-top: 2px;
  }

  /* 二维码：白底 + 静区，深色底上扫不出来 */
  .qr {
    width: 180px;
    height: 180px;
    padding: 8px;
    margin-top: @ui-space-2;
    border-radius: @ui-radius-md;
    background-color: #ffffff;
    align-self: center;
  }

  .actions {
    flex-direction: row;
    justify-content: center;
    margin-top: auto;
    padding-top: @ui-space-3;
  }
</style>

<script>
  const { community, games, legal, navigation, store, tutorial } = global.AstraMai;
  const { groupNumber, groupUrl } = community;
  const { TERMS_SECTIONS, TERMS_SUMMARY, TERMS_VERSION, TERMS_KEY } = legal;
  const { TUTORIAL_STEPS } = tutorial;
  const { GAMES, gameById, readCurrentGame, writeCurrentGame } = games;
  const { push } = navigation;
  const { readSetting, warmUp, writeSetting } = store;

  /**
   * 六步，写死顺序。
   *
   * **和上一版的区别：没有"跳过"，也不再有动态生成的步骤。**
   * 上一版会根据有没有配群号增减步骤，结果两个用户看到的流程不一样，
   * 出问题时很难判断他在第几步。现在固定六步。
   */
  const STEPS = ['welcome', 'terms', 'pairing', 'tutorial', 'community', 'done'];

  /**
   * ⚠️ **引导"弹过"的标记，不是"走完"的标记。**
   *
   * 上一版只在最后一步（或跳过）才写 `oobeDone`，于是：
   * 用户中途退出 / 杀掉应用 / 走不完六步 → 标记没写 → 下次又弹。
   * **这正是"每次打开都跳出来"的原因。**
   *
   * 现在改成在页面加载时就写 `oobeShown`——
   * 语义是「已经给他看过引导了」，而不是「他看完了」。
   * 想再看到只需要清掉这一个键。
   */
  const SHOWN_KEY = 'oobeShown';

  /** 走完了的标记，只用于统计/以后判断要不要补看。 */
  const COMPLETED_KEY = 'oobeCompleted';

  /** 每一步的主按钮文案。都带动作，不是状态确认。 */
  const PRIMARY_LABELS = {
    welcome: '继续',
    terms: '同意并继续',
    pairing: '我的手表能自己联网',
    tutorial: '看完了',
    community: '加好了',
    done: '开始使用',
  };

  export default {
    private: {
      step: 0,
      total: STEPS.length,
      page: STEPS[0],
      selected: 'maimai',
      groupNumber: '',
      groupQr: '',
      termsSummary: TERMS_SUMMARY,
      termsSections: TERMS_SECTIONS,
      tutorialSteps: TUTORIAL_STEPS,
      primaryLabel: PRIMARY_LABELS.welcome,
    },

    onInit() {
      console.debug('[AstraMai] Welcome onInit');

      /*
       * **第一件事就是写下"已经看过"。**
       *
       * 放在最前面、在做任何异步操作之前——
       * 这样即使用户在这之后立刻杀进程，下次也不会再弹。
       */
      try {
        writeSetting(SHOWN_KEY, '1');
      } catch (error) {
        console.warn('[AstraMai] 写引导标记失败：', error);
      }

      warmUp(['currentGame', SHOWN_KEY])
        .then(() => {
          const current = readCurrentGame(readSetting);
          this.selected = current;
          this.groupNumber = groupNumber();
          this.groupQr = groupUrl();
        })
        .catch((error) => console.error('[AstraMai] Welcome 初始化失败：', error));
    },

    next() {
      const current = this.page;

      // 在协议页点「同意」时把版本号记下来
      if (current === 'terms') {
        try {
          writeSetting(TERMS_KEY, TERMS_VERSION);
        } catch (error) {
          console.warn('[AstraMai] 写协议标记失败：', error);
        }
      }

      if (this.step >= STEPS.length - 1) {
        this.finish();
        return;
      }

      this.step += 1;
      this.page = STEPS[this.step];
      this.primaryLabel = PRIMARY_LABELS[this.page] || '继续';
    },

    finish() {
      try {
        writeSetting(COMPLETED_KEY, '1');
        writeCurrentGame(writeSetting, this.selected);
      } catch (error) {
        console.warn('[AstraMai] 保存引导结果失败：', error);
      }
      // push 而不是 replace：引导页不留在返回栈里，返回就直接回桌面
      push('/');
    },
  };
</script>
