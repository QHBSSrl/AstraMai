<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="search-page">
    <div class="query">
      <text class="query__text">{{ keyword ? keyword : '输入曲名 / 别名 / 艺术家' }}</text>
      <text class="query__hint">{{ statusText }}</text>
    </div>

    <!--
      返回键放在按钮行里，不额外占竖直空间——下面是全屏输入法键盘，
      页面可用高度本来就紧。
      存在的理由：手表上没有可见的返回入口，用户得知道「边缘侧滑」这个隐藏手势。
    -->
    <div class="actions">
      <div class="action action--ghost" @click="onBack">
        <text class="action__text">‹ 返回</text>
      </div>
      <div class="action {{ keyword ? '' : 'action--disabled' }}" @click="runSearch">
        <text class="action__text">搜索</text>
      </div>
      <div class="action action--ghost" @click="clearAll">
        <text class="action__text">清空</text>
      </div>
      <div class="action action--ghost" @click="toggleKeyboard">
        <text class="action__text">{{ keyboardHidden ? '输入' : '收起' }}</text>
      </div>
    </div>

    <!-- <list> 必须显式给高度（官方文档要求），否则高度为 0、一条都画不出来 -->
    <list class="list" if="{{ results.length > 0 }}" onscrollbottom="onScrollBottom">
      <list-item class="row" type="item" for="{{ results }}">
        <image class="row__cover" src="{{ $item.jacketUrl }}"></image>
        <div class="row__main">
          <text class="row__title">{{ $item.title }}</text>
          <text class="row__sub">{{ $item.sub }}</text>
          <text class="row__version">版本 {{ $item.versionTitle }}</text>

          <!--
            定数逐难度列出，用游戏内的难度配色。
            之前只显示定数最高的那条，而最高的永远是 MST / Re:M，
            等于把 BASIC / ADV / EXP 全遮住了。
            STD 与 DX 各一行——同一首歌两套谱面的定数经常不一样。
          -->
          <!--
            两行难度定数。标签与内容都按游戏动态给：
            舞萌是 STD / DX 两套谱面；中二只有一套、但有 6 档（含 WORLD'S END）。
            写死 STD/DX 的话中二玩家会看到两个不存在的分类。
          -->
          <div class="row__set" if="{{ $item.set1Cells.length > 0 }}">
            <text class="set__label">{{ $item.set1Label }}</text>
            <text class="set__cell" for="{{ cell in $item.set1Cells }}" style="color: {{ cell.color }}">{{ cell.text }}</text>
          </div>
          <div class="row__set" if="{{ $item.set2Cells.length > 0 }}">
            <text class="set__label">{{ $item.set2Label }}</text>
            <text class="set__cell" for="{{ cell in $item.set2Cells }}" style="color: {{ cell.color }}">{{ cell.text }}</text>
          </div>
        </div>

        <!-- ▸ 进详情：试听 + 完整谱面（定数 / 物量 / 谱师） -->
        <div class="row__more" @click="openSong($idx)">
          <text class="row__more-text">▸</text>
        </div>
      </list-item>
    </list>

    <!--
      完整输入法：支持中文拼音、英文、日文罗马字。
      日文是刚需——maimai 的曲名大量是日文，没有它就搜不了歌。
    -->
    <input-method
      hide="{{ keyboardHidden }}"
      keyboardtype="QWERTY"
      screentype="rect"
      vibratemode="short"
      maxlength="5"
      @complete="onComplete"
      @delete="onDelete"
    ></input-method>
  </div>
</template>

<style>
  .search-page {
    flex-direction: column;
    padding: 14px;
    background-color: #070b16;
  }

  .query {
    flex-direction: column;
    align-items: center;
    padding: 14px;
    border-radius: 14px;
    background-color: #141d30;
  }

  .query__text {
    font-size: 28px;
    color: #e8eefc;
    text-align: center;
  }

  .query__hint {
    font-size: 16px;
    color: #6d7fa3;
    margin-top: 6px;
  }

  .actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
  }

  /* 一行要放下 4 个按钮（返回 / 搜索 / 清空 / 收起），所以做得紧凑些 */
  .action {
    height: 60px;
    padding: 0 16px;
    margin: 0 4px;
    border-radius: 30px;
    background-color: #ff5f9e;
    align-items: center;
    justify-content: center;
  }

  .action--ghost {
    background-color: #1c2740;
  }

  .action--disabled {
    background-color: #2a2f42;
  }

  .action__text {
    font-size: 21px;
    color: #1a0710;
  }

  .action--ghost .action__text {
    color: #e8eefc;
  }

  .action--disabled .action__text {
    color: #6d7fa3;
  }

  .list {
    width: 100%;
    /* <list> 必须显式给高度，否则高度为 0，一条都画不出来。
       320px 是按 432x514 的屏幕倒推的：去掉页边距、查询框、按钮行之后的余量。
       搜索完成后键盘会自动收起，这块地方能整个用上。 */
    height: 320px;
    margin-top: 12px;
  }

  .row {
    flex-direction: row;
    align-items: center;
    /* 最多 5 行内容：曲名 / 别名 / 版本 / STD / DX。
       定死高度，避免列表项高度随内容变化而抖动。 */
    height: 128px;
    padding: 6px 8px;
  }

  /* 封面。定死尺寸，避免图片加载前后布局跳动。 */
  .row__cover {
    width: 68px;
    height: 68px;
    background-color: #1c2740;
  }

  .row__main {
    flex: 1;
    flex-direction: column;
    margin-left: 10px;
  }

  /* 一行定数：STD / DX + 各难度定数（颜色由数据带过来） */
  .row__set {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
  }

  .set__label {
    width: 34px;
    font-size: 14px;
    color: #6d7fa3;
  }

  .set__cell {
    font-size: 18px;
    margin-right: 8px;
    font-weight: bold;
  }

  /* ▸ 进详情的入口。做够大，手表上要好点。 */
  .row__more {
    width: 44px;
    height: 100%;
    align-items: center;
    justify-content: center;
  }

  .row__more-text {
    font-size: 28px;
    color: #6d7fa3;
  }

  .row__title {
    font-size: 21px;
    color: #e8eefc;
  }

  .row__sub {
    font-size: 16px;
    color: #6d7fa3;
  }

  /* 版本单独一行并带标签。之前混在副标题里，用户反馈「版本显示呢」——
     实际是有的，只是认不出来。 */
  .row__version {
    font-size: 16px;
    color: #f2a33c;
    margin-top: 2px;
  }
</style>

<script>
  // 共享模块从 global 取，不再 import（官方内存优化建议）。
  // 页面各自 import 会让每个页面都打一份，手表内存扛不住。
  const { api, core, games, navigation, store } = global.AstraMai;
  const { searchChunithmSongs, searchSongs } = api;
  const { chunithmDifficultyColor } = core;
  const { gameById, readCurrentGame } = games;

  /**
   * 原始搜索结果。
   *
   * 刻意放在脚本作用域而不是 viewModel：这是纯数据、不需要响应式，
   * 塞进 viewModel 只会白白多一层 observer 和数据代理
   * （官方《内存优化》第 1 条）。
   */
  let rawResults = [];

  /**
   * 每页条数。
   * 官方《常用业务优化》：list 内容超过 10 条建议分页渲染。
   */
  const PAGE_SIZE = 10;

  /** 已转换好的展示行（纯数据，同样不进 viewModel）。 */
  let rowCache = [];
  let shownCount = 0;
  const { goBack, push } = navigation;
  const { warmUp, writeSetting } = store;

  /**
   * 难度配色，与游戏内一致：绿 / 黄 / 红 / 紫 / 白。
   *
   * 用颜色而不是文字区分难度，是因为手表一行放不下「BASIC 7.0 ADVANCED 10.5 …」，
   * 而定数本身才是玩家要看的数字，难度靠颜色一眼就能认出来。
   */
  const DIFFICULTY_COLOR = ['#7ee081', '#f5d547', '#f2564b', '#b06fe8', '#f2f2f2'];

  /** 定数展示：整数不带小数（5 而不是 5.0），小数保留一位。 */
  function formatConstant(value) {
    return Number.isInteger(value) ? String(value) : value.toFixed(1);
  }

  /**
   * 把一组谱面转成可直接渲染的单元格。
   *
   * 只保留有定数的谱面（上游偶尔缺），并按难度序号排序，
   * 保证显示顺序恒为 BAS → Re:M。
   */
  function toCells(charts, isChunithm) {
    return (charts || [])
      .filter((chart) => typeof chart.level_value === 'number')
      .sort((a, b) => a.difficulty - b.difficulty)
      .map((chart) => ({
        text: formatConstant(chart.level_value),
        // 中二是 6 档，而且 ULTIMA 官方是黑、WE 是特殊谱面，
        // 配色规则和舞萌完全不同，必须用各自的函数而不是共用一张表
        color: isChunithm
          ? chunithmDifficultyColor(chart.difficulty)
          : DIFFICULTY_COLOR[chart.difficulty] || '#9bacd0',
      }));
  }

  /** 副标题：只放别名（没别名就用艺术家）。
   *  版本单独一行并带标签，混在这里会看不出来。 */
  function buildSub(item) {
    return item.aliases && item.aliases.length > 0
      ? item.aliases.slice(0, 3).join(' / ')
      : item.artist;
  }

  /** 详情数据由曲目搜索页写进本地存储，详情页读出来渲染。 */
  const STORAGE_KEY = 'songDetail';

  export default {
    private: {
      keyword: '',
      keyboardHidden: true,
      /** 当前游戏 id。决定查哪个接口、用哪套难度配色。 */
      gameId: 'maimai',
      statusText: '支持日文曲名、中文别名与罗马音',
      results: [],
    },

    onReady() {
      mark('Search:onReady');
    },

    onInit() {
      mark('Search:onInit');
      console.debug('[AstraMai] Search onInit');
      // 详情数据要写进本地存储，先把存储模块热起来
      this.gameId = gameById(readCurrentGame(readSetting)).id;
      warmUp([STORAGE_KEY]).catch((error) =>
        console.warn('[AstraMai] 存储预热失败：', error),
      );
    },

    /**
     * 打开曲目详情。
     *
     * 详情数据走本地存储而不是路由参数：一是路由只能带字符串，
     * 二是手表上再发一次请求拿同样的数据不划算。
     * 用下标而不是整个对象，避免把大对象塞进事件参数。
     */
    openSong(index) {
      const song = rawResults[index];
      if (!song) return;
      try {
        // 把当前游戏一并带过去：详情页要用对应那套难度配色
        writeSetting(STORAGE_KEY, JSON.stringify({ ...song, game: this.gameId }));
      } catch (error) {
        console.error('[AstraMai] 写入曲目数据失败：', error);
        return;
      }
      push('/song');
    },

    /** 返回上一页。 */
    onBack() {
      goBack('/');
    },

    /**
     * 只监听 complete。
     *
     * keyDown 在拼音 / 罗马字模式下会把「正在输入的字母」也报上来，
     * 两个都监听会导致重复输入；complete 才是真正提交的文本。
     */
    onComplete(evt) {
      const content = evt && evt.detail ? evt.detail.content : '';
      if (!content) return;
      this.keyword += content;
      this.statusText = `${this.keyword.length} 字 · 点「搜索」`;
    },

    onDelete() {
      this.keyword = this.keyword.slice(0, -1);
      this.statusText = this.keyword ? `${this.keyword.length} 字 · 点「搜索」` : '支持日文曲名、中文别名与罗马音';
    },

    clearAll() {
      this.keyword = '';
      this.results = [];
      this.statusText = '支持日文曲名、中文别名与罗马音';
    },

    toggleKeyboard() {
      this.keyboardHidden = !this.keyboardHidden;
    },

    runSearch() {
      const keyword = this.keyword.trim();
      if (!keyword) return;

      this.keyboardHidden = true;
      this.statusText = '搜索中…';

      const isChunithm = this.gameId === 'chunithm';
      const search = isChunithm ? searchChunithmSongs : searchSongs;
      search(keyword, 30)
        .then((payload) => {
          const list = payload && payload.results ? payload.results : [];
          // 详情页要用完整字段，所以原始结果单独留一份
          rawResults = list;

          // 先转换成一页能用的行，其余等触底再取
          // （官方《常用业务优化》：超过 10 条建议分页渲染）
          rowCache = list.map((item) => {
            const charts = item.difficulties || [];

            if (isChunithm) {
              // 中二只有一套谱面（没有 standard/dx 之分），6 档全排一行。
              // WE 靠金色区分，不单独拆出来——它本来就是同一张谱面列表里的一项。
              return {
                title: item.title,
                sub: buildSub(item),
                versionTitle: item.versionTitle || '未知',
                set1Label: '定数',
                set1Cells: toCells(charts, true),
                set2Label: '',
                set2Cells: [],
                jacketUrl: item.jacketUrl || '',
              };
            }

            return {
              title: item.title,
              sub: buildSub(item),
              // 版本单独占一行，并带「版本」二字——混在副标题里认不出来
              versionTitle: item.versionTitle || '未知',
              set1Label: 'STD',
              set1Cells: toCells(charts.filter((chart) => chart.type === 'standard'), false),
              set2Label: 'DX',
              set2Cells: toCells(charts.filter((chart) => chart.type === 'dx'), false),
              jacketUrl: item.jacketUrl || '',
            };
          });

          // 原地清空再追加，不整份重新赋值（官方《内存优化》第 2 条）
          this.results.length = 0;
          shownCount = 0;
          this.appendPage();

          // 结果对象较多，主动回收一次（官方《内存优化》建议的手动触发点）
          if (typeof global.runGC === 'function') global.runGC();

          this.statusText =
            list.length === 0
              ? `没有匹配「${keyword}」的曲目`
              : `${list.length} 条结果 · 继续输入可缩小范围`;
        })
        .catch((error) => {
          this.results.length = 0;
          rowCache = [];
          shownCount = 0;
          this.statusText = error && error.message ? error.message : '搜索失败';
          this.keyboardHidden = false;
        });
    },

    /** 追加一页。触底时也会调这里。 */
    appendPage() {
      const next = rowCache.slice(shownCount, shownCount + PAGE_SIZE);
      for (const item of next) this.results.push(item);
      shownCount += next.length;
    },

    /** 触底加载下一页。 */
    onScrollBottom() {
      if (shownCount < rowCache.length) this.appendPage();
    },
  };
</script>
