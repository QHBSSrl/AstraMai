
<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="search-page">
    <div class="query">
      <text class="query__text">{{ keyword ? keyword : '输入曲名 / 别名 / 艺术家' }}</text>
      <text class="query__hint">{{ statusText }}</text>
    </div>

    <div class="actions">
      <div class="action action--ghost" @click="runSearch">
        <text class="action__text">重搜</text>
      </div>
      <div class="action action--ghost" @click="clearAll">
        <text class="action__text">清空</text>
      </div>
      <div class="action action--ghost" @click="toggleKeyboard">
        <text class="action__text">{{ keyboardHidden ? '输入' : '收起' }}</text>
      </div>
    </div>

    <!--
      <list> 必须显式给高度（官方文档明确要求），否则高度为 0、一条都画不出来。
      输入法键盘占掉底部一大块，所以键盘开着时列表矮一些，收起后铺满。
    -->
    <list class="list" style="height: {{ keyboardHidden ? '320px' : '120px' }};" if="{{ results.length > 0 }}">
      <list-item class="row" type="item" for="{{ results }}">
        <div class="row__main">
          <text class="row__title">{{ $item.title }}</text>
          <text class="row__sub">{{ $item.sub }}</text>
        </div>
        <text class="row__badge">{{ $item.badge }}</text>
      </list-item>
    </list>

    <!--
      完整输入法：支持中文拼音、英文、日文罗马字。
      日文是刚需——maimai 的曲名大量是日文，没有它就搜不了歌。
    -->
    <input-method
      hide="{{ keyboardHidden }}"
      keyboardtype="QWERTY"
      screentype="rect"
      vibratemode="short"
      maxlength="5"
      @complete="onComplete"
      @delete="onDelete"
    ></input-method>
  </div>
</template>

<style>
  .search-page {
    flex-direction: column;
    padding: 14px;
    background-color: #070b16;
  }

  .query {
    flex-direction: column;
    align-items: center;
    padding: 14px;
    border-radius: 14px;
    background-color: #141d30;
  }

  .query__text {
    font-size: 28px;
    color: #e8eefc;
    text-align: center;
  }

  .query__hint {
    font-size: 16px;
    color: #6d7fa3;
    margin-top: 6px;
  }

  .actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 12px;
  }

  .action {
    height: 64px;
    padding: 0 26px;
    margin: 0 5px;
    border-radius: 32px;
    background-color: #ff5f9e;
    align-items: center;
    justify-content: center;
  }

  .action--ghost {
    background-color: #1c2740;
  }

  .action--disabled {
    background-color: #2a2f42;
  }

  .action__text {
    font-size: 24px;
    color: #1a0710;
  }

  .action--ghost .action__text {
    color: #e8eefc;
  }

  .action--disabled .action__text {
    color: #6d7fa3;
  }

  .list {
    width: 100%;
    margin-top: 12px;
  }

  .row {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding: 6px 8px;
  }

  .row__main {
    flex: 1;
    flex-direction: column;
  }

  .row__title {
    font-size: 21px;
    color: #e8eefc;
  }

  .row__sub {
    font-size: 16px;
    color: #6d7fa3;
  }

  .row__badge {
    font-size: 16px;
    color: #9bacd0;
    margin-left: 8px;
  }
</style>

<script>
  import { searchSongs } from '../../common/api.js';

  /** 命中维度的展示名。 */
  const MATCH_LABEL = {
    title: '曲名',
    alias: '别名',
    artist: '艺术家',
  };

  export default {
    private: {
      keyword: '',
      keyboardHidden: false,
      statusText: '支持日文曲名、中文别名与罗马音',
      results: [],
      /** 防抖定时器句柄。 */
      searchTimer: null,
      /** 请求序号，用来丢弃乱序返回的旧结果。 */
      searchSeq: 0,
    },

    onInit() {
      console.log('[AstraMai] Search onInit');
    },

    /**
     * 只监听 complete。
     *
     * keyDown 在拼音 / 罗马字模式下会把「正在输入的字母」也报上来，
     * 两个都监听会导致重复输入；complete 才是真正提交的文本。
     */
    onComplete(evt) {
      const content = evt && evt.detail ? evt.detail.content : '';
      if (!content) return;
      this.keyword += content;
      this.scheduleSearch();
    },

    onDelete() {
      this.keyword = this.keyword.slice(0, -1);
      this.scheduleSearch();
    },

    /**
     * 边打边搜，不要求用户去点「搜索」。
     *
     * 之前是需要点按钮才搜，但输入法是**全屏键盘**、盖住了页面，
     * 那个按钮根本点不到——用户打完字只看到输入框在变，以为坏了。
     * 现在打字就触发，按钮只作为「立刻重搜」的兜底。
     *
     * 防抖 400ms：拼音 / 罗马字输入过程中会连续提交字符，
     * 不防抖会每敲一个字就打一次接口。
     */
    scheduleSearch() {
      if (this.searchTimer) clearTimeout(this.searchTimer);
      const keyword = this.keyword.trim();

      if (!keyword) {
        this.results = [];
        this.statusText = '支持日文曲名、中文别名与罗马音';
        return;
      }

      this.statusText = '输入中…';
      this.searchTimer = setTimeout(() => {
        this.searchTimer = null;
        this.runSearch();
      }, 400);
    },

    clearAll() {
      if (this.searchTimer) {
        clearTimeout(this.searchTimer);
        this.searchTimer = null;
      }
      // 让在途请求的结果作废
      this.searchSeq += 1;
      this.keyword = '';
      this.results = [];
      this.statusText = '支持日文曲名、中文别名与罗马音';
    },

    toggleKeyboard() {
      this.keyboardHidden = !this.keyboardHidden;
    },

    runSearch() {
      const keyword = this.keyword.trim();
      if (!keyword) return;

      // 不收起键盘：用户是边打边看结果的，收起反而要多点一次
      this.statusText = '搜索中…';

      // 请求序号：拼音输入时请求可能乱序返回，只认最后一次
      this.searchSeq += 1;
      const seq = this.searchSeq;

      searchSongs(keyword, 30)
        .then((payload) => {
          if (seq !== this.searchSeq) return;
          const list = payload && payload.results ? payload.results : [];
          this.results = list.map((item) => ({
            title: item.title,
            sub: item.aliases && item.aliases.length > 0 ? item.aliases.slice(0, 3).join(' / ') : item.artist,
            badge: MATCH_LABEL[item.matchedBy] || '',
          }));
          this.statusText =
            list.length === 0
              ? `没有匹配「${keyword}」的曲目`
              : `${list.length} 条结果 · 继续输入可缩小范围`;
        })
        .catch((error) => {
          if (seq !== this.searchSeq) return;
          this.results = [];
          this.statusText = error && error.message ? error.message : '搜索失败';
        });
    },
  };
</script>
