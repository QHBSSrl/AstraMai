<template>
  <div class="phi-page">
    <!-- 返回键：手表上没有可见的返回入口，用户得知道「边缘侧滑」这个隐藏手势 -->
    <div class="topbar">
      <div class="back" @click="onBack">
        <text class="back__text">‹ 返回</text>
      </div>
    </div>

    <text class="title">用 TapTap 扫码登录</text>

    <!-- 有二维码就画出来。内容是 verificationUrl，交给原生 qrcode 组件渲染 -->
    <div class="qr-box" if="{{ verificationUrl }}">
      <qrcode class="qr" value="{{ verificationUrl }}"></qrcode>
    </div>

    <text class="status" style="color: {{ statusColor }}">{{ statusText }}</text>
    <text class="hint" if="{{ hint }}">{{ hint }}</text>

    <div class="actions">
      <div class="action" if="{{ !success && qrId }}" @click="refreshNow">
        <text class="action__text action__text--filled">刷新</text>
      </div>
      <div class="action action--ghost" if="{{ !success }}" @click="restart">
        <text class="action__text action__text--ghost">重新获取</text>
      </div>
      <div class="action action--ghost" @click="onBack">
        <text class="action__text action__text--ghost">{{ success ? '完成' : '返回' }}</text>
      </div>
    </div>
  </div>
</template>

<style lang="less">
  @import '../../common/theme-tokens.less';

  .phi-page {
    flex-direction: column;
    align-items: center;
    padding: 14px;
    background-color: @ui-surface;
  }

  .topbar {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 56px;
  }

  .back {
    padding: 8px 20px;
    border-radius: 22px;
    background-color: @ui-surface-container;
  }

  .back__text {
    font-size: 22px;
    color: @ui-on-surface;
  }

  .title {
    font-size: 24px;
    color: @ui-on-surface;
    margin-top: 2px;
  }

  /* 二维码给足尺寸，手机才好对焦 */
  .qr-box {
    margin-top: 12px;
    padding: 8px;
    border-radius: 12px;
    background-color: #ffffff;
  }

  .qr {
    width: 220px;
    height: 220px;
  }

  .status {
    font-size: 18px;
    text-align: center;
    margin-top: 12px;
    line-height: 1.5;
  }

  .hint {
    font-size: 14px;
    color: @ui-on-surface-variant;
    text-align: center;
    margin-top: 6px;
    line-height: 1.6;
  }

  .actions {
    flex-direction: row;
    justify-content: center;
    margin-top: 16px;
  }

  .action {
    height: 56px;
    padding: 0 18px;
    margin: 0 4px;
    border-radius: 28px;
    background-color: @ui-primary;
    align-items: center;
    justify-content: center;
  }

  .action--ghost {
    background-color: @ui-surface-container;
  }

  .action__text {
    /* 只留尺寸。**颜色必须拆到变体类上**——
       写在基类里会和变体规则打架，谁赢取决于编译顺序。 */
    font-size: 20px;
  }

  /* 主按钮上的文字：深色，压在粉色底上 */
  .action__text--filled {
    color: @ui-on-primary;
  }

  /* 次要按钮上的文字：浅色，压在深色底上 */
  .action__text--ghost {
    color: @ui-on-surface;
  }

  /* 禁用态：中间灰。**不再借用 opacity**，手表上小字号容易糊 */
  .action__text--disabled {
    color: @ui-on-surface-variant;
  }


  /*
   * ── 圆形屏适配 ─────────────────────────────────────────────────
   * 依据官方《多屏适配 · 页面标题栏》：
   *   「在圆屏、胶囊屏等存在边缘剪切的设备上，标题栏会使用多行设计，
   *     保证顶部的展示内容长度不会超出屏幕；而在矩形屏幕上则做单行左右布局。」
   *
   * 圆屏四角是物理裁掉的：466×466 的屏，顶栏中心 y≈44 处可用宽度只有约 272px，
   * 而「标题在左 + 设置在右」需要整幅 466px，两端必然被切。
   * 所以这里改竖排居中，并加左右内边距把内容压进圆内接矩形。
   *
   * **只影响 shape: circle**，矩形屏样式与行为完全不变。
   */
  @media (shape: circle) {
    .phi-page {
      padding-left: 40px;
      padding-right: 40px;
    }

    /* 顶栏改竖排居中：单行左右布局在圆屏上两端必被裁 */
    .topbar {
      flex-direction: column;
      align-items: center;
      height: auto;
    }

    /* 返回键/标题不再靠边，改为居中并留出上下间距 */
    .back {
      margin-bottom: 8px;
    }
  }
</style>

<script>
  const { api, diag, navigation, store } = global.AstraMai;
  const { createPhigrosQr, pollPhigrosQr } = api;
  const { mark } = diag;
  const { goBack } = navigation;
  const { warmUp, writeSetting } = store;

  /** 凭证存这里的键。B50 页查 Phigros 时会读它。 */
  const SESSION_KEY = 'phigrosSession';

  /** 自动轮询间隔。平台建议 1 秒，服务端还缓存 1 秒，1.5 秒足够。 */
  const POLL_MS = 1500;

  /**
   * 自动轮询的**硬上限**。
   *
   * 这条是刻意的：扫码轮询虽然是有界的（用户扫完就停），
   * 但如果用户拿了码就走开，没人管的话它会一直打下去。
   * 两分钟足够扫完，超了就停下让用户手动点刷新——
   * **宁可让用户多点一下，也不给服务端制造无界负载。**
   */
  const POLL_MAX_MS = 2 * 60 * 1000;

  export default {
    private: {
      qrId: '',
      verificationUrl: '',
      statusText: '正在获取二维码…',
      statusColor: '#9bacd0',
      hint: '',
      success: false,
      timer: null,
      startedAt: 0,
    },

    onReady() {
      mark('PhigrosLogin:onReady');
    },

    onInit() {
      mark('PhigrosLogin:onInit');
      warmUp([SESSION_KEY])
        .then(() => this.begin())
        .catch((error) => {
          console.error('[AstraMai] Phigros 登录页初始化失败：', error);
          this.statusText = '存储不可用，无法保存登录状态';
          this.statusColor = '#f2564b';
        });
    },

    /** 离开就停轮询——省电，也顺带把负载收掉。 */
    onHide() {
      this.stopPolling();
    },

    /**
     * **回到页面必须把轮询接上。**
     *
     * 玩家扫二维码的动作是：拿起手机 → 切到 TapTap → 扫 → 确认 → 切回手表。
     * 这一来一回，手表上的 App **进过后台**（触发 onHide，轮询被停），
     * 回来时如果不重新启动，就再也不会去查状态了 ——
     * 表现就是「扫了没反应」，而且界面上还停在那句
     * 「用手机 TapTap 扫上面的二维码」，看着像它还在等。
     *
     * 所以这里要：
     *   · 已经登录成功 → 什么都不做
     *   · 还没生成二维码 → 也不做（等 begin 自己启动）
     *   · 其余情况 → 立刻查一次 + 重新开轮询 + 顺延计时窗口
     *
     * 顺延计时很关键：原来的两分钟窗口是按「进页面」算的，
     * 玩家在手机上磨蹭一会儿回来就超时了，非得点刷新才继续，很别扭。
     */
    onShow() {
      if (this.success || !this.qrId) return;
      this.startedAt = Date.now();
      this.startPolling();
      this.pollOnce();
    },

    onDestroy() {
      this.stopPolling();
    },

    begin() {
      createPhigrosQr('cn')
        .then((data) => {
          this.qrId = data.qrId || '';
          this.verificationUrl = data.verificationUrl || '';
          this.statusText = '用手机 TapTap 扫上面的二维码';
          this.hint = '扫完会自动完成，不用手动确认。';
          this.statusColor = '#9bacd0';
          this.startedAt = Date.now();
          this.startPolling();
        })
        .catch((error) => {
          console.error('[AstraMai] 获取 Phigros 二维码失败：', error);
          this.statusText = error && error.message ? error.message : '获取二维码失败';
          this.statusColor = '#f2564b';
        });
    },

    startPolling() {
      this.stopPolling();
      this.timer = setInterval(() => this.tick(), POLL_MS);
    },

    stopPolling() {
      if (this.timer) {
        clearInterval(this.timer);
        this.timer = null;
      }
    },

    /** 定时器每轮：到点就停，否则查一次。 */
    tick() {
      if (this.success) {
        this.stopPolling();
        return;
      }
      if (Date.now() - this.startedAt > POLL_MAX_MS) {
        this.stopPolling();
        this.statusText = '超过两分钟没扫，已停止自动检查';
        this.hint = '扫完后点「刷新」即可。';
        this.statusColor = '#f2a33c';
        return;
      }
      this.pollOnce();
    },

    /**
     * 手动刷新：查一次，并把计时窗口顺延，让自动轮询继续。
     * 玩家从手机上切回来时点一下能马上看到结果。
     */
    refreshNow() {
      if (this.success || !this.qrId) return;
      this.statusText = '正在检查…';
      this.statusColor = '#9bacd0';
      this.startedAt = Date.now();
      this.startPolling();
      this.pollOnce();
    },

    /** 真正发查询的那一处。 */
    pollOnce() {
      pollPhigrosQr(this.qrId)
        .then((data) => {
          const status = String(data.status || '');

          if (data.sessionToken) {
            this.onLoggedIn(data.sessionToken);
            return;
          }
          if (status === 'Pending' || status === 'pending') {
            // 还在等，保持原提示，不刷屏
            return;
          }
          // 其它状态原样显示——不猜它是什么意思，能看到原文比瞎翻译强
          this.statusText = '登录状态：' + status;
          this.statusColor = '#f2a33c';
        })
        .catch((error) => {
          console.warn('[AstraMai] 轮询扫码状态失败：', error);
          this.statusText = '网络不太好，正在重试…';
          this.statusColor = '#f2a33c';
        });
    },

    /** 拿到凭证：存下来、停轮询、提示成功。 */
    onLoggedIn(sessionToken) {
      try {
        writeSetting(SESSION_KEY, sessionToken);
      } catch (error) {
        console.error('[AstraMai] 保存 Phigros 凭证失败：', error);
        this.statusText = '登录成功但保存失败';
        this.statusColor = '#f2564b';
        return;
      }

      this.success = true;
      this.stopPolling();
      this.statusText = '登录成功';
      this.statusColor = '#58d68d';
      this.hint = '回到首页即可查看 RKS 与 B30。';
      this.verificationUrl = '';
    },

    /** 换一张二维码重新开始。 */
    restart() {
      this.stopPolling();
      this.qrId = '';
      this.verificationUrl = '';
      this.statusText = '正在获取二维码…';
      this.hint = '';
      this.success = false;
      this.statusColor = '#9bacd0';
      this.begin();
    },

    onBack() {
      this.stopPolling();
      goBack('/settings');
    },
  };
</script>
