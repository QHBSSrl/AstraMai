# ==============================================================================
# ORhythm 官方网站构建期与客户端动态发版环境变量配置
# ==============================================================================
# 本地开发时请复制为 .env，CI/CD (GitHub Actions) 构建时通过 Secrets 注入。
# Astro 会自动将 PUBLIC_ 前缀的环境变量暴露给构建期与客户端。
# 若留空或使用占位域名，将自动平滑降级使用系统内置的 v0.1.3 兜底版本配置。

# Cloudflare R2 最新发布清单 URL（必须配置公共读且允许 CORS GET）
PUBLIC_RELEASE_MANIFEST_URL=https://dl.orhythm.example/latest.json
