{
  "name": "@astramai/server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "AstraMai 测试站服务端：持有落雪开发者密钥，向浏览器只暴露聚合后的结果。",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@astramai/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3"
  }
}
