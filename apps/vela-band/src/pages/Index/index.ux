<template>
  <!--
    首页 · 小米手环（跑道型 192×490）

    ── 和手表版的区别 ───────────────────────────────────────────────
    手环屏幕太窄（192px），手表那套「一行两个卡片」在这里会挤成一团。
    所以这版：

      · **竖向单列**，每个入口一整行，右边一个箭头
      · **选项下面不放说明文字**（用户明确要求）——
        说明文字在 192px 上只能排一两行、字号还得缩到 12，
        结果就是主标题和说明一样大，谁也看不清。全给主标题。
      · 行高 56，是手指能压准的尺寸
      · 游戏卡片保留分数，但排版压扁：名字、Rating、一行统计

    ── 数据 ─────────────────────────────────────────────────────────
    和手表版完全一样（共用 src/common）：缓存读的是 B50 页写下的那份，
    首页不发请求。动态键必须先 warmUp，否则 readSetting 读到空。
  -->
  <div class="page">
    <div class="topbar">
      <text class="brand">ORhythm</text>
      <div class="settings-btn" @click="goSettings">
        <text class="settings-btn__text">设置</text>
      </div>
    </div>

    <!-- 分数卡片。整块可点：有成绩去 Best 50，没成绩去设置 -->
    <div class="game" @click="onGameCardTap">
      <text class="game__name">{{ gameLabel }}</text>
      <text class="game__rating" if="{{ hasScore }}">{{ ratingText }}</text>
      <text class="game__rating-label" if="{{ hasScore }}">DX Rating</text>
      <text class="game__hint" if="{{ !hasScore }}">还没查过成绩</text>
      <text class="game__stats" if="{{ hasScore }}">{{ statsText }}</text>
    </div>

    <text class="section" if="{{ hasItems }}">快捷</text>

    <div class="list" if="{{ hasItems }}">
      <div class="item" for="{{ items }}" @click="go($item.key)">
        <text class="item__title">{{ $item.title }}</text>
        <text class="item__arrow">›</text>
      </div>
    </div>

    <text class="empty" if="{{ !hasItems }}">这个游戏还没有可用功能</text>
  </div>
</template>

<style lang="less">
  @import '../../common/theme-tokens.less';

  /*
   * 手环的可用宽度只有 192px（designWidth 也是 192，所以这里写的 px
   * 就是屏上的实际比例）。左右各留 14px，内容区 164px。
   *
   * 跑道屏的左右两端是圆弧，贴边会被切，所以内边距不能省。
   */
  .page {
    flex-direction: column;
    width: 100%;
    padding: 14px;
    background-color: @ui-surface;
  }

  /* ── 顶栏 ──────────────────────────────────────────────────── */
  .topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 44px;
  }

  .brand {
    font-size: 24px;
    font-weight: bold;
    color: @ui-primary;
  }

  /* 设置按钮：正方形，点击区域 44×44 —— 手环上手指压不准，不能太小 */
  .settings-btn {
    align-items: center;
    justify-content: center;
    min-width: 52px;
    height: 40px;
    padding: 0 10px;
    border-radius: @ui-radius-full;
    background-color: @ui-surface-container;
  }

  .settings-btn__text {
    font-size: 15px;
    color: @ui-on-surface;
  }

  /* ── 分数卡片 ──────────────────────────────────────────────── */
  .game {
    flex-direction: column;
    width: 100%;
    padding: 14px;
    margin-top: 8px;
    border-radius: @ui-radius-md;
    background-color: @ui-surface-emphasis;
  }

  .game__name {
    font-size: 20px;
    color: @ui-on-surface;
  }

  /* Rating 是这张卡唯一的主角，字号拉开 */
  .game__rating {
    font-size: 42px;
    font-weight: bold;
    color: @ui-primary;
    margin-top: 2px;
  }

  .game__rating-label {
    font-size: 13px;
    color: @ui-on-surface-variant;
  }

  .game__stats {
    font-size: 12px;
    color: @ui-on-surface-variant;
    margin-top: 6px;
  }

  .game__hint {
    font-size: 14px;
    color: @ui-on-surface-variant;
    margin-top: 4px;
  }

  /* ── 快捷列表 ──────────────────────────────────────────────── */
  .section {
    font-size: 13px;
    color: @ui-on-surface-variant;
    margin-top: 14px;
    margin-bottom: 6px;
  }

  .list {
    flex-direction: column;
    width: 100%;
  }

  /*
   * 一行一个入口。
   *
   * 行高 56：Vela 的手环可用触摸区建议不小于 48，56 留了点余量。
   * 标题统一 22px，**下面不放说明** —— 用户要求的。
   */
  .item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 56px;
    padding: 0 14px;
    margin-bottom: 8px;
    border-radius: @ui-radius-md;
    background-color: @ui-surface-card;
  }

  .item__title {
    font-size: 22px;
    color: @ui-on-surface;
  }

  .item__arrow {
    font-size: 24px;
    color: @ui-on-surface-muted;
  }

  .empty {
    font-size: 15px;
    color: @ui-on-surface-variant;
    text-align: center;
    margin-top: 20px;
  }
</style>

<script>
  // 和手表版一样：首页不需要网络，刻意不 import api.js。
  const { core, diag, games, keys, navigation, store, validate } = global.AstraMai;
  const { describeValidity, parseWahlapQrPayload } = core;
  const { mark } = diag;
  const { gameById, gameHasFeature, readCurrentGame } = games;
  const { push } = navigation;
  const { readSetting, warmUp } = store;
  const { summarizeTarget } = validate;

  export default {
    private: {
      qrSummary: '未导入',
      targetSummary: '',
      gameLabel: '',
      /** 单列列表：[{ key, title }] */
      items: [],
      hasItems: false,
      /* ── 顶部分数卡片 ── */
      hasScore: false,
      ratingText: '',
      statsText: '',
    },

    onReady() {
      mark('Index:onReady');
    },

    onInit() {
      mark('Index:onInit');
      warmUp(['qrInput', 'serverBase', 'queryKind', 'queryValue', 'friendCode', 'currentGame', 'oobeShown'])
        .then(() => {
          this.refresh();
          if (!readSetting('oobeShown', '')) push('/welcome');
        })
        .catch((error) => console.error('[ORhythm] Index 初始化失败：', error));
    },

    onShow() {
      this.refresh();
    },

    refresh() {
      try {
        const game = gameById(readCurrentGame(readSetting));
        this.gameLabel = game.label;

        const showB50 = gameHasFeature(game, 'b50');
        const showSearch = gameHasFeature(game, 'search');
        const showQr = gameHasFeature(game, 'qr');

        const kind = readSetting('queryKind', 'friendCode') === 'qq' ? 'qq' : 'friendCode';
        const value = readSetting('queryValue', '') || readSetting('friendCode', '');
        this.targetSummary = summarizeTarget(kind, value) || '';

        const saved = readSetting('qrInput', '');
        if (!saved) {
          this.qrSummary = '未导入';
        } else {
          const payload = parseWahlapQrPayload(saved);
          if (!payload || !payload.content) this.qrSummary = '内容无法识别';
          else if (!payload.recognized) this.qrSummary = '已导入';
          else {
            const validity = describeValidity(payload);
            this.qrSummary = validity.state === 'valid' ? '有效' : '已过期';
          }
        }

        // 手环只有一列，说明文字统统不要，只留主标题
        const items = [];
        if (showB50) items.push({ key: 'b50', title: 'Best 50' });
        if (showSearch) items.push({ key: 'search', title: '曲目搜索' });
        if (showQr) items.push({ key: 'qr', title: '二维码' });

        this.items = items;
        this.hasItems = items.length > 0;

        /*
         * 顶部卡片要先 warmUp 这个**动态键**。
         *
         * `store.readSetting` 只读内存，而内存只有 `warmUp()` 预热过的键；
         * `b50Cache:maimai:3687236844` 是拼出来的，固定列表里不可能有它。
         */
        const cacheKey = keys.b50CacheKey(game.id, value);
        warmUp(value ? [cacheKey] : []).then(() => {
          this.loadScoreCard(game.id, value);
        });
      } catch (error) {
        console.error('[ORhythm] Index refresh 失败：', error);
      }
    },

    loadScoreCard(gameId, code) {
      this.hasScore = false;
      this.ratingText = '';
      this.statsText = '';
      if (!code) return;

      try {
        const raw = readSetting(keys.b50CacheKey(gameId, code), '');
        if (!raw) return;

        const view = JSON.parse(raw);
        const player = (view && view.player) || {};
        const stats = (view && view.stats) || {};

        const rating = Number(player.rating) || 0;
        if (rating <= 0) return;

        const oldCount = Number(stats.standardCount) || 0;
        const newCount = Number(stats.dxCount) || 0;
        const avg =
          typeof stats.averageLevelValue === 'number'
            ? stats.averageLevelValue.toFixed(2)
            : '';

        this.hasScore = true;
        this.ratingText = String(rating);
        this.statsText = oldCount + ' 旧曲 ' + newCount + ' 新曲' + (avg ? ' ' + avg + ' 平均定数' : '');
      } catch (error) {
        this.hasScore = false;
      }
    },

    onGameCardTap() {
      if (this.hasScore) push('/b50');
      else push('/settings');
    },

    go(name) {
      push('/' + name);
    },

    goSettings() {
      push('/settings');
    },
  };
</script>
