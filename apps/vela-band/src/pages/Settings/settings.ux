<template>
  <!--
    设置 · 小米手环（跑道型 192×490）

    ── 正式版只留两块 ──────────────────────────────────────────────
    设计稿：node-id=37-2

        y=43    设置            字号 23，居中
        y=67    游戏            字号 18
        y=94    ┌ 舞萌 DX        ┐  179×150  #213052 圆角 15
        y=101     ∟ 字号 22
        y=136     Phigros
        y=172     中二节奏
        y=208     osu!
        y=246   关于软件        字号 18
        y=270   ┌ 关于        ›  ┐  179×40
        y=277     ∟ 字号 18

    ── 正式版删掉了什么，为什么 ────────────────────────────────────
    用户：「你正式上线你设置要那么多功能干嘛」

        Phigros 登录    删 —— 改成手机查完通过网桥推给手环，手环上不登录
        加入用户群      删 —— 关于软件里有
        字号            删 —— 「没卵用」
        服务器线路      删 —— 正式版不该让用户选，出问题我们自己查
        测试连接/传输方式/强制走网桥/设备信息/测试服务器
                        移到 **debug 区**，正式构建里整块不渲染

    这些能力没有丢，只是从「用户能看到的设置」变成「开发排查用」，
    由 `DEBUG_BUILD` 控制显隐（见 script 里的常量）。

    ── 选中态 ──────────────────────────────────────────────────────
    游戏选中只靠**颜色 + 加粗**表示，不写「当前」两个字 ——
    192 宽下那两个字会把游戏名挤掉一截。
  -->
  <div class="page-root">
    <div class="settings-page">
      <text class="title">设置</text>

      <text class="section">游戏</text>
      <div class="card">
        <div class="game" for="{{ gameRows }}" @click="selectGame($item.id)">
          <text class="game__label" style="color: {{ $item.current ? '#ff5f9e' : '#ffffff' }}; font-weight: {{ $item.current ? 'bold' : 'normal' }}">{{ $item.label }}</text>
        </div>
      </div>

      <text class="section">关于软件</text>
      <div class="card card--tight">
        <div class="row" @click="goAbout">
          <text class="row__label">关于</text>
          <text class="row__mark">›</text>
        </div>
      </div>

      <!--
        ⚠️ 下面整块只在 DEBUG_BUILD 为 true 时渲染。
        正式包里 `debugBuild` 是 false，这些节点根本不进组件树。
      -->
      <block if="{{ debugBuild }}">
        <text class="section">调试</text>
        <div class="card card--tight">
          <div class="row" @click="testServer">
            <text class="row__label">测试服务器</text>
            <text class="row__mark">{{ serverState }}</text>
          </div>
          <div class="row" @click="toggleLine">
            <text class="row__label">服务器线路</text>
            <text class="row__mark">{{ lineLabel }}</text>
          </div>
          <div class="row" @click="toggleForceBridge">
            <text class="row__label">强制走网桥</text>
            <text class="row__mark">{{ forceBridgeOn ? '开' : '关' }}</text>
          </div>
          <div class="row" @click="toggleDeviceInfo">
            <text class="row__label">设备信息</text>
            <text class="row__mark">{{ deviceInfoOpen ? '收起' : '查看' }}</text>
          </div>
        </div>
        <text class="hint" if="{{ serverNotice }}">{{ serverNotice }}</text>
        <text class="hint" if="{{ deviceInfoText && deviceInfoOpen }}">{{ deviceInfoText }}</text>
      </block>
    </div>
  </div>
</template>

<style lang="less">
  @import '../../common/theme-tokens.less';

  .page-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    background-color: #000000;
  }

  /* 左右 13 是设计稿的边距，内容宽 179 */
  .settings-page {
    flex: 1;
    width: 100%;
    flex-direction: column;
    padding: 24px 13px 0;
  }

  /* 标题：字号 23，居中 */
  .title {
    width: 100%;
    font-size: 23px;
    color: #ffffff;
    text-align: center;
  }

  /* 分区标签：字号 18 */
  .section {
    width: 100%;
    font-size: 18px;
    color: #ffffff;
    margin-top: 14px;
    margin-bottom: 6px;
  }

  /* ── 卡片 ──────────────────────────────────────────────────── */
  .card {
    flex-direction: column;
    width: 100%;
    padding: 6px 0;
    border-radius: 15px;
    background-color: #213052;
  }

  /* 关于那张卡只有一行，40 高 */
  .card--tight {
    padding: 0;
  }

  /* ── 游戏行 ────────────────────────────────────────────────── */
  /*
   * 每行 36 高：设计稿 y=101/136/172/208，正好 35~36 的间距。
   * 字号 22 —— 从左边 x=22 开始，和卡片 13 + 内边距 9 对齐。
   */
  .game {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 36px;
    padding: 0 9px;
  }

  .game__label {
    font-size: 22px;
    lines: 1;
    text-overflow: ellipsis;
  }

  /* ── 普通行（关于 / 调试项）───────────────────────────────── */
  .row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 40px;
    padding: 0 9px;
  }

  .row__label {
    font-size: 18px;
    color: #ffffff;
    lines: 1;
    text-overflow: ellipsis;
  }

  .row__mark {
    font-size: 18px;
    color: #9bacd0;
    lines: 1;
    text-overflow: ellipsis;
  }

  .hint {
    font-size: 12px;
    color: #9bacd0;
    margin-top: 6px;
    lines: 3;
    text-overflow: ellipsis;
  }
</style>

<script>
  /**
   * ⚠️ 这里原本解构的是 ridge —— 那是**已废弃**的 Python 插件客户端，
   * 而下面用的是 pi.activeTransport()。结果 api 一直是 undefined，
   * 被 try/catch 吞掉，网桥提示从来没显示过。现在改成解构 api。
   */

/*
 * 两条线路。
 *
 * 正式：HTTPS 域名，走 Cloudflare → 甲骨文 → frp 隧道 → 机房。
 * 阿里云：明文直连，不过 Cloudflare 也不走隧道，用来单独验证网络。
 */
const LINE_OFFICIAL = 'https://api-orhythm.astranexus.cn';
const LINE_ALIYUN = 'http://101.132.148.117:8787';
/* 甲骨文 IP + 80 端口：不经过 DNS，用来区分「解析坏了」和「路由不通」。 */
const LINE_ORACLE_IP = 'http://161.33.15.92';
const { api, community, config, diag, fetchbridge, fontScale, games, navigation, screenSize, store } = global.AstraMai;

  /** 手表上的 toast。用 try/require 是因为有些设备不提供。 */
  let prompt = null;
  try { prompt = require('@system.prompt'); } catch (error) { prompt = null; }
  const { mark } = diag;
  const { groupNumber } = community;
  const { GAMES, readCurrentGame, writeCurrentGame } = games;
  const { goBack, push } = navigation;
  const { clearSetting, readSetting, warmUp, writeSetting } = store;

  /**
   * 正式构建为 false —— 调试区整块不进组件树。
   *
   * 需要排查线上问题时改成 true 重新打包，排查完改回去。
   * **不要靠「隐藏」**：用户说过藏起来不省内存，JS 节点和渲染开销都还在。
   */
  const DEBUG_BUILD = false;

  export default {
    private: {
      /** 调试区显不显示。见文件里的 DEBUG_BUILD。 */
      debugBuild: DEBUG_BUILD,
      gameRows: [],
      /** 同步为何不可用——点一下会展开说明。 */
      syncNotice: '',
      /** Phigros 的登录状态。空串表示没登录过。 */
      phigrosStatus: '未登录',
      /** 群号。没配置时为空串，模板里那一整块就不渲染。 */
      groupNumber: '',
      /**
       * 网桥状态，显示在「测试连接」右边。
       * 空串表示还没测过。
       */
      bridgeState: '',
      /** 网桥测试的详细结果 / 失败原因。 */
      bridgeNotice: '',
      /** 「测试服务器」那一行的状态文本。 */
      serverState: '点此测试',
      /** 失败时的原始错误，排查用，不做美化。 */
      serverNotice: '',
      /** 当前线路的显示文本（「正式」/「阿里云」）。 */
      lineLabel: '',
      /** 传输方式的显示文本（「完整」/「分片」）。 */
      bridgeModeLabel: '',
      /** 网桥的固定提示。手环上才显示，说明这东西是干什么的。 */
      bridgeHint: '',

      /** 这台设备是不是真的需要网桥。自带 fetch 的就不需要，整块不显示。 */
      bridgeNeeded: false,

      /** 字号档位显示文本（「标准」/「大」）。 */
      fontScaleLabel: '',

      /** 切完字号后的提示。 */
      fontNotice: '',

      /** 设备信息面板是不是展开着。 */
      deviceInfoOpen: false,
      /** 设备信息的多行文本。 */
      deviceInfoText: '',

      /** 强制走网桥开关的状态。 */
      forceBridgeOn: false,
      /** 切换强制网桥后的提示。 */
      forceBridgeNotice: '',
    },

    onReady() {
      mark('Settings:onReady');
    },

    onInit() {
      // 线路显示要跟存储同步 —— 不然切过之后重进设置又显示旧的
      this.refreshLine();
      mark('Settings:onInit');
      warmUp([
        'currentGame',
        'qrInput',
        'queryKind',
        'queryValue',
        'friendCode',
        'phigrosSession',
        'bridgeMode',
      ])
        .then(() => this.refresh())
        .catch((error) => console.error('[AstraMai] Settings 初始化失败：', error));
    },

    refresh() {
      const current = readCurrentGame(readSetting);
      // 群号是编译期常量，但每次 refresh 都重算一遍，免得漏掉
      this.groupNumber = groupNumber();
      // 做成可直接渲染的行，模板里就不用再算
      this.gameRows = GAMES.map((game) => ({
        id: game.id,
        label: game.label,
        current: game.id === current,
      }));

      /*
       * 网桥：手环没有 @system.fetch，只能靠手机上的 AstroBox 插件。
       *
       * 这里做两件事：
       *   · 刷新「传输方式」那行的文字（完整 / 分片）
       *   · 手环上给一句固定提示，告诉用户这东西是干什么的
       */
      /*
       * 显示「这个设备实际会走哪条路」。
       *
       * 为什么值得显示：手环用户最困惑的就是「我到底该装插件还是不该装」。
       * 直接把判断结果摆出来，比让他们猜快得多。
       */
      /*
       * 网桥入口一律显示。
       *
       * 原来按 `activeTransport()` 在「直连」的设备上整块隐藏，理由是
       * 手表用不上。但那样有两个问题：
       *
       *   1. 直连失败时用户没法切到网桥，也没有入口做诊断
       *   2. **没法在手表上验协议** —— 端口都看不见
       *
       * 改成常驻，文案按能力区分：直连的设备说清「这是备用通道」。
       */
      this.bridgeNeeded = true;

      // 强制网桥开关的状态也要读回来
      try {
        this.forceBridgeOn = api.isForceBridge();
      } catch (error) {
        this.forceBridgeOn = false;
      }

      this.refreshBridgeHint();

      // 字号
      this.fontScaleLabel = fontScale.label(fontScale.current(readSetting));

      this.refreshBridgeModeLabel();

      // 只是「有没有登录」这一个比特，**不读出来展示**——
      // 凭证不该出现在界面上，截图分享时也安全
      this.phigrosStatus = readSetting('phigrosSession', '') ? '已登录' : '未登录';
    },

    /**
     * 切换游戏。
     *
     * 切换后**停在本页**而不是自动返回：让玩家看到「当前」标记跟着变了，
     * 否则点一下什么都没发生，会以为没生效。
     */
    selectGame(id) {
      try {
        writeCurrentGame(writeSetting, id);
        this.refresh();
      } catch (error) {
        console.error('[AstraMai] 切换游戏失败：', error);
      }
    },

    /**
     * 同步暂不可用。
     *
     * 不跳转、也不弹错——只是把原因写在页面上。
     * 等后端换成能绑域名的服务器，把这里改回 push('/sync') 即可。
     */
    explainSyncUnavailable() {
      this.syncNotice = 'API 服务器问题，功能暂不可用。';
    },

    goPhigrosLogin() {
      push('/phigros-login');
    },

    /**
     * 测试网桥。
     *
     * 发一个 `ping` —— 插件**不碰网络**就回 `pong`，
     * 所以这一条能把「链路通不通」和「服务器通不通」分开：
     *
     *   ping 成功          → Vela ↔ AstroBox 通了
     *   ping 成功但查不到   → 链路通，服务器或插件那边的问题
     *   ping 失败          → 插件没装 / 没启用 / 设备没连
     *
     * 没有这个入口的话，用户看到的现象都是"查不出成绩"，只能靠猜。
     */
    testBridge() {
      /*
       * 网桥是**手环唯一的联网方式** —— 手环没有 @system.fetch，
       * 只能靠手机上的 AstroBox 插件转发。
       *
       * 所以这个按钮是排查的核心入口：任何一环断了，用户看到的现象
       * 都是「查不出成绩」，没有它就只能靠猜。
       *
       * ⚠️ 用的是**官方 FetchBridge 的协议**（fetchbridge.js），
       * 不是我们自己那个 Python 插件（那个会弹浏览器窗口，已作废）。
       */
      /*
       * ⚠️ 这里原来直接 `fetchbridge.MODE` —— 但 fetchbridge 没被解构进来，
       * 一点就 ReferenceError，被 Vela 静默吞掉，表现就是「点了没反应」。
       *
       * 现在整段包 try/catch，任何错误都摆到界面上。
       */
      try {
        const mode = fetchbridge.readBridgeMode();
        const client = fetchbridge.createFetchBridge({ mode });

        client.ping().then(
          () => {
            this.bridgeState = '已连通';
            this.bridgeNotice =
              '网桥正常。';
          },
          (error) => {
            this.bridgeState = '失败';
            // 原因原样显示 —— 光说「失败」没法排查
            this.bridgeNotice = String(error && error.message ? error.message : error);
          },
        );
      } catch (error) {
        this.bridgeState = '失败';
        this.bridgeNotice = '发起测试失败：'
          + (error && error.message ? error.message : error);
      }
    },

    /**
     * 切换传输方式。
     *
     * 「完整」= 单消息，快，但单次响应不能超过 16 KB
     *          （我们用服务端的 /compact 端点把 B50 压到 12 KB）
     * 「分片」= v4 开放长度流，没有长度限制，但要处理重传和乱序
     *
     * 这是**用户可感知的取舍**，所以做成可切换的，不写死。
     */
    /**
     * 切换字号。
     *
     * 手环屏幕小，默认给「大」。改完立刻写回存储，下次进来还是这个档。
     */
    /**
     * 显示官网地址。
     *
     * 手表上没有浏览器，点了也打不开 —— 所以只把网址摆出来让人抄。
     */
    showWebsite() {
      this.fontNotice = '官网：orhythm.astranexus.cn';
      try {
        if (prompt && typeof prompt.showToast === 'function') {
          prompt.showToast({ message: 'orhythm.astranexus.cn', duration: 3000 });
        }
      } catch (error) {
        console.warn('[ORhythm] toast 不可用：', error);
      }
    },

    /**
     * 重新算「网桥提示」。
     *
     * 抽出来是因为两处要用：进页面时（refresh）和切完强制开关后。
     */
    refreshBridgeHint() {
      try {
        const transport = api.activeTransport();

        if (transport === 'bridge') {
          this.bridgeHint = this.forceBridgeOn
            ? '已强制走网桥。查成绩会经过手机中转。'
            : '这台设备没有网络模块，查成绩靠手机中转。'
              + '在手机上装「ORhythm」并打开「手机网桥」，'
              + '然后点「测试连接」确认。';
        } else if (transport === 'none') {
          this.bridgeHint =
            '没检测到可用的网络。请在手机上装「ORhythm」，打开「手机网桥」。';
        } else {
          this.bridgeHint =
            '这台设备能直接联网，平时用不上网桥。'
            + '只有直连失败时才需要打开手机上的「手机网桥」，'
            + '这里可以点「测试连接」验证通道。';
        }
      } catch (error) {
        this.bridgeHint = '';
      }
    },

    /**
     * 切换「强制走网桥」。
     *
     * 打开后即使设备能直接联网也改走手机中转 —— 用来：
     *   · 排查「直连不通」是不是网络问题
     *   · 在手表上验证网桥协议（手表平时永远走不到网桥）
     *
     * 改完必须让 api 丢掉缓存的客户端，否则还用着旧的那条路。
     */
    toggleForceBridge() {
      const next = !this.forceBridgeOn;

      try {
        writeSetting('forceBridge', next ? '1' : '');
      } catch (error) {
        this.forceBridgeNotice =
          '保存失败：' + (error && error.message ? error.message : error);
        return;
      }

      this.forceBridgeOn = next;

      // 让下一次请求重新建客户端
      try {
        if (typeof api.resetClient === 'function') api.resetClient();
      } catch (error) {
        // 没有就算了，最坏是下一次请求还用旧客户端
      }

      this.forceBridgeNotice = next
        ? '已强制走网桥。返回首页查一次成绩试试。'
        : '已恢复自动选择（能直连就直连）。';

      this.refreshBridgeHint();
    },

    /**
     * 展开 / 收起设备信息。
     *
     * 把算字号用到的几个字段摆出来 —— 真机拿不到 console，
     * 只能靠界面确认。
     */
    toggleDeviceInfo() {
      this.deviceInfoOpen = !this.deviceInfoOpen;
      if (!this.deviceInfoOpen) return;

      const info = screenSize.cachedInfo();
      if (!info) {
        this.deviceInfoText = '还没读到设备信息，退出重进一次试试。';
        return;
      }

      const scale = Math.round(screenSize.autoScale() * 100);
      this.deviceInfoText =
        `类型 ${info.deviceType || '?'}｜型号 ${info.model || '?'}\n`
        + `屏宽 ${info.screenWidth || '?'}｜屏高 ${info.screenHeight || '?'}\n`
        + `密度 ${info.screenDensity || '?'}｜形状 ${info.screenShape || '?'}\n`
        + `APILv ${info.APILevel || '?'}｜平台 ${info.platformVersionCode || '?'}\n`
        + `字号倍率 ${scale}%`;
    },
    toggleFontScale() {
      try {
        const next = fontScale.next(fontScale.current(readSetting));
        fontScale.save(writeSetting, next);
        this.fontScaleLabel = fontScale.label(next);
        const pct = Math.round(fontScale.scaleOf(next) * 100);
        this.fontNotice = `已切到「${this.fontScaleLabel}」（${pct}%），返回首页生效。`;
      } catch (error) {
        this.fontNotice = '切换失败：' + (error && error.message ? error.message : error);
      }
    },
    toggleBridgeMode() {
      const current = fetchbridge.readBridgeMode();
      const next =
        current === fetchbridge.MODE.STREAM
          ? fetchbridge.MODE.SINGLE
          : fetchbridge.MODE.STREAM;

      fetchbridge.writeBridgeMode(next);
      /*
       * 显示「这个设备实际会走哪条路」。
       *
       * 为什么值得显示：手环用户最困惑的就是「我到底该装插件还是不该装」。
       * 直接把判断结果摆出来，比让他们猜快得多。
       */
      try {
        const transport = api.activeTransport();
        if (transport === 'direct') {
          this.bridgeHint = '这个设备能直接联网，不需要网桥。';
        } else if (transport === 'bridge') {
          this.bridgeHint =
            '这个设备没有网络模块，查成绩会走网桥。需要在手机上的 AstroBox 里'
            + '装「AstraMai 网桥」插件并启用，然后点上面的「测试连接」确认。';
        } else {
          this.bridgeHint =
            '这个设备没有网络模块，而且没检测到 AstroBox 的连接。'
            + '请在手机上的 AstroBox 里装「AstraMai 网桥」插件。';
        }
      } catch (error) {
        this.bridgeHint = '';
      }

      this.refreshBridgeModeLabel();

      this.bridgeState = '待重测';
      this.bridgeNotice =
        next === fetchbridge.MODE.STREAM
          ? '已切到「分片」。响应不再受 16 KB 限制，但慢一些。点「测试连接」确认能通。'
          : '已切到「完整」。更快，但单次响应不能超过 16 KB。点「测试连接」确认能通。';
    },

    /** 刷新「传输方式」那一行显示的文字。 */
    refreshBridgeModeLabel() {
      const mode = fetchbridge.readBridgeMode();
      this.bridgeModeLabel = mode === fetchbridge.MODE.STREAM ? '分片' : '完整';
    },

    /**
     * 点群号时给出提示。
     *
     * 手表上**没法跳转到 QQ**（没有浏览器、没有深链支持），
     * 所以能做的是把群号显示清楚，让用户用手机去搜。
     * 假装能跳转只会让人点了没反应。
     */
    showGroup() {
      if (!this.groupNumber) return;
      // 复用同步功能的提示位，避免为一行字再开一个状态
      this.syncNotice = `群号 ${this.groupNumber} · 用手机搜群号即可加入`;
    },

    /**
     * 重看新手引导。
     *
     * 先清掉 `oobeShown`，再跳过去——不清的话下次启动不会再弹，
     * 但用户现在就要看，所以直接 push 过去。
     *
     * **这同时是开发时的调试入口**：`@system.storage` 在设备上
     * 没有暴露成文件，没法用 adb 删键，只能从界面上清。
     */
    replayOnboarding() {
      try {
        clearSetting('oobeShown');
      } catch (error) {
        console.warn('[AstraMai] 清除引导标记失败：', error);
      }
      push('/welcome');
    },

    /*
     * 换页到「关于软件」。
     *
     * 用 push 而不是 replace：看完能返回设置，符合直觉。
     */
    goAbout() {
      push('/about');
    },

    /**
     * 直接打一次 /api/health，把结果摊开给人看。
     *
     * 和 `testBridge` 的区别：那个测的是**网桥通道**，只在手环上出现；
     * 这个测的是**普通网络请求**，任何设备都能用，是排查「连不上」的入口。
     */
    /**
     * 在两条线路之间切换（排查用）。
     *
     *   正式       https://api-orhythm.astranexus.cn   （HTTPS，走甲骨文+隧道）
     *   阿里云直连 http://101.132.148.117:8787         （明文，不过 Cloudflare）
     *
     * 明文能通而 HTTPS 不通，说明问题出在设备的 TLS 栈，而不是网络。
     */
    toggleLine() {
      let current = "";
      try {
        current = config.getServerBase() || "";
      } catch (error) {
        current = "";
      }

      /* 三条线路轮换：正式 HTTPS → 阿里云明文 → 甲骨文 IP */
      let nextBase = LINE_OFFICIAL;
      if (/^https:/i.test(current)) nextBase = LINE_ALIYUN;
      else if (/101\.132\.148\.117/.test(current)) nextBase = LINE_ORACLE_IP;
      try {
        store.writeSetting("serverBase", nextBase);
        api.resetClient();
      } catch (error) {
        // 写不进去就算了，下面的 refreshLine 会显示旧值
      }
      this.refreshLine();
      this.serverState = "点此测试";
      this.serverNotice = `已切到 ${nextBase}`;
    },

    /** 刷新线路显示文本。 */
    refreshLine() {
      let current = "";
      try {
        current = config.getServerBase() || "";
      } catch (error) {
        current = "";
      }
      if (/^https:/i.test(current)) this.lineLabel = "正式(HTTPS)";
      else if (/161\.33\.15\.92/.test(current)) this.lineLabel = "甲骨文IP";
      else this.lineLabel = "阿里云";
    },

    testServer() {
      const started = Date.now();
      this.serverState = '测试中…';

      /*
       * 先把**实际用的地址**显示出来。
       *
       * 这一步很关键：如果存储里留着一个旧的 serverBase（比如早先调试时
       * 填的 emulator 地址），请求根本不会打到线上，光看「失败」猜不到。
       */
      let base = "";
      try {
        base = config.getServerBase() || "";
      } catch (error) {
        base = "";
      }
      this.serverNotice = base ? `地址：${base}` : "地址：读不到";

      try {
        api
          .fetchHealth()
          .then(() => {
            this.serverState = `通 · ${Date.now() - started}ms`;
          })
          .catch((error) => {
            this.serverState = `失败 · ${Date.now() - started}ms`;
            /*
             * 错误对象有时候是空的（message 为空串），
             * 那样界面上只会显示「失败」，什么都查不出来。
             * 所以把 name / message / 原始字符串都拼上。
             */
            let detail = "";
            try {
              if (error && error.message) detail = String(error.message);
              else if (error && error.name) detail = String(error.name);
              else detail = String(error);
              if (!detail || detail === "[object Object]") {
                detail = JSON.stringify(error).slice(0, 200);
              }
            } catch (nested) {
              detail = "（错误信息读不出来）";
            }
            this.serverNotice = `${base || "?"} → ${detail}`.slice(0, 240);
          });
      } catch (error) {
        this.serverState = "失败";
        this.serverNotice = `${base || "?"} → 发不出请求：${String(error)}`.slice(0, 240);
      }
    },
    onBack() {
      goBack('/');
    },
  };
</script>