<template>
  <!--
    首页 · 小米 Watch（圆形 466×466）

    ── 为什么用 <list> 滚动 ──────────────────────────────────────────
    圆屏的可用宽度随高度剧烈变化（实测）：

        y=16    170px      y=100   383px
        y=44    273px      y=150   435px
        y=60    312px      y=233   466px   ← 圆心最宽

    想在一屏里塞下「品牌 + 分数卡 + 4 个入口」，顶部那一行必然被裁。
    所以整页做成可滚动 —— 顶部内容在窄处只放居中的品牌字（约 120px，
    y=16 都放得下），越往下越宽。

    用 `<list>` 而不是 `<scroll>`：`welcome.ux` 里记过，
    `<scroll>` 没有明确高度会把父容器撑开；`<list>` 配 `.list { flex: 1 }`
    自动吃剩余高度，而且 `b50.ux` 已经在用它。

    ── 底部彩蛋 ─────────────────────────────────────────────────────
    滚动到底时，圆形屏幕下方还剩一块弧形空白。放一张看板娘图把它填掉，
    视觉上「到此为止是有意的」，而不是内容没写完。

    图是 `/common/mascot.png`。**团队真图做好后直接覆盖同名文件即可**，
    不用改代码。要求透明背景、内容居中留白（圆屏四角会被裁）。

    现在放的是占位图（先拿 icon.png 顶替），所以要看清版式还得换真图。
  -->
  <div class="page-root">
    <div class="page-body">
    <list class="list">
      <!-- 品牌：圆屏最窄处也只放这一行，居中，宽度约 120px -->
      <list-item class="brand-item" type="item">
        <text class="brand">ORhythm</text>
      </list-item>

      <!-- 分数卡片。整块可点：有成绩去 Best 50，没成绩去设置 -->
      <list-item class="card-item" type="item">
        <div class="game" @click="onGameCardTap">
          <div class="game__head">
            <text class="game__name">{{ gameLabel }}</text>
            <text class="game__tier" if="{{ tier }}">{{ tier }}</text>
          </div>
          <text class="game__rating" if="{{ hasScore }}">{{ ratingText }}</text>
          <text class="game__rating-label" if="{{ hasScore }}">DX Rating</text>
          <text class="game__hint" if="{{ !hasScore }}">还没查过成绩 · 点此去设置</text>
          <text class="game__stats" if="{{ hasScore }}">{{ statsText }}</text>
        </div>
      </list-item>

      <list-item class="section-item" type="item">
        <text class="section">快捷</text>
      </list-item>

      <list-item class="entry-item" type="item" for="{{ items }}" @click="go($item.key)">
        <div class="item">
          <text class="item__title">{{ $item.title }}</text>
          <text class="item__arrow">›</text>
        </div>
      </list-item>

      <list-item class="entry-item" type="item" @click="goSettings">
        <div class="item">
          <text class="item__title">设置</text>
          <text class="item__arrow">›</text>
        </div>
      </list-item>

      <!-- 彩蛋：填掉圆形底部那块弧 -->
      <list-item class="egg-item" type="item">
        <div class="egg">
          <image class="egg__art" src="/common/mascot.png"></image>
          <text class="egg__hint">ORhythm · NowMes Software</text>
        </div>
      </list-item>
    </list>
  </div>
    </div>
</template>

<style lang="less">
  @import '../../common/theme-tokens.less';

  /*
   * 三层结构与 `b50.ux` 保持一致 —— 它的 `<list>` 在实机上是好的。
   *
   *   .page-root  显式 height: 100%（Vela 的 div 默认是 row，必须写 column）
   *   .page-body  flex: 1 吃掉剩余高度
   *   .list       flex: 1 + **min-height** 兜底
   *
   * ⚠️ `min-height` 不能省。上一版我只写了 flex: 1，如果父级高度没定死，
   * 列表会被压成 0 —— 表现就是整页空白，一条都画不出来。
   */
  .page-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
  }

  .page-body {
    flex: 1;
    width: 100%;
    flex-direction: column;
    background-color: @ui-surface;
  }

  /*
   * 滚动容器。
   *
   * ⚠️ **不在 <list> 上写 padding** —— b50.ux 的列表没写，实机正常；
   * 给列表加内边距在 Vela 上行为不确定。左右的 40px 改到每个 item 上。
   */
  .list {
    flex: 1;
    min-height: 120px;
    width: 100%;
  }

  /* ── 品牌 ──────────────────────────────────────────────────── */
  /*
   * 顶部内边距 34px：让品牌字的**中心**落到 y≈60 附近。
   * 那里可用宽度 312px，放 120px 的文字绰绰有余。
   * 贴到 y=16 就只有 170px 了。
   */
  .brand-item {
    padding-left: 40px;
    padding-right: 40px;
    width: 100%;
    padding-top: 34px;
    padding-bottom: 10px;
    justify-content: center;
    align-items: center;
  }

  .brand {
    font-size: 32px;
    font-weight: bold;
    color: @ui-primary;
  }

  /* ── 分数卡片 ──────────────────────────────────────────────── */
  .card-item {
    padding-left: 40px;
    padding-right: 40px;
    width: 100%;
  }

  .game {
    flex-direction: column;
    width: 100%;
    padding: 16px 20px;
    border-radius: @ui-radius-card;
    background-color: @ui-surface-emphasis;
  }

  .game__head {
    flex-direction: row;
    align-items: center;
  }

  .game__name {
    font-size: 26px;
    font-weight: bold;
    color: @ui-on-surface;
  }

  .game__tier {
    font-size: 15px;
    color: @ui-on-surface;
    opacity: 0.7;
    margin-left: 8px;
    padding: 2px 10px;
    border-radius: @ui-radius-full;
    background-color: @ui-surface-container;
  }

  .game__rating {
    font-size: 46px;
    font-weight: bold;
    color: @ui-primary;
    margin-top: 4px;
  }

  .game__rating-label {
    font-size: 15px;
    color: @ui-on-surface-variant;
    margin-top: -2px;
  }

  .game__stats {
    font-size: 13px;
    color: @ui-on-surface-variant;
    margin-top: 8px;
  }

  .game__hint {
    font-size: 15px;
    color: @ui-on-surface-variant;
    margin-top: 4px;
  }

  /* ── 快捷 ──────────────────────────────────────────────────── */
  .section-item {
    padding-left: 40px;
    padding-right: 40px;
    width: 100%;
    padding-top: 18px;
    padding-bottom: 8px;
  }

  .section {
    font-size: 15px;
    color: @ui-on-surface-variant;
  }

  .entry-item {
    padding-left: 40px;
    padding-right: 40px;
    width: 100%;
  }

  .item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 60px;
    padding: 0 20px;
    margin-bottom: 10px;
    border-radius: @ui-radius-card;
    background-color: @ui-surface-card;
  }

  .item__title {
    font-size: 24px;
    color: @ui-on-surface;
  }

  .item__arrow {
    font-size: 26px;
    color: @ui-on-surface-muted;
  }

  /* ── 彩蛋 ──────────────────────────────────────────────────── */
  /*
   * 高度给足 200px —— 它要盖住圆形底部那段弧。
   * 内容全部居中，长文本会被圆角裁掉，所以只放一行短的。
   */
  .egg-item {
    padding-left: 40px;
    padding-right: 40px;
    width: 100%;
  }

  .egg {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 200px;
    padding-bottom: 30px;
  }

  /* 96×96：够显眼，又不会被圆角切到 */
  .egg__art {
    width: 96px;
    height: 96px;
    border-radius: @ui-radius-full;
  }

  .egg__hint {
    font-size: 13px;
    color: @ui-on-surface-muted;
    margin-top: 10px;
    text-align: center;
  }
</style>

<script>
  // 首页不需要网络，刻意不 import api.js。
  const { core, diag, games, keys, navigation, store, validate } = global.AstraMai;
  const { describeValidity, parseWahlapQrPayload } = core;
  const { mark } = diag;
  const { gameById, gameHasFeature, readCurrentGame } = games;
  const { push } = navigation;
  const { readSetting, warmUp } = store;
  const { summarizeTarget } = validate;

  export default {
    private: {
      qrSummary: '未导入',
      targetSummary: '',
      gameLabel: '',
      items: [],
      /* ── 顶部分数卡片 ── */
      hasScore: false,
      ratingText: '',
      tier: '',
      statsText: '',
    },

    onReady() {
      mark('Index:onReady');
    },

    onInit() {
      mark('Index:onInit');
      warmUp(['qrInput', 'serverBase', 'queryKind', 'queryValue', 'friendCode', 'currentGame', 'oobeShown'])
        .then(() => {
          this.refresh();
          if (!readSetting('oobeShown', '')) push('/welcome');
        })
        .catch((error) => console.error('[ORhythm] Index 初始化失败：', error));
    },

    onShow() {
      this.refresh();
    },

    refresh() {
      try {
        const game = gameById(readCurrentGame(readSetting));
        this.gameLabel = game.label;

        const showB50 = gameHasFeature(game, 'b50');
        const showSearch = gameHasFeature(game, 'search');
        const showQr = gameHasFeature(game, 'qr');

        const kind = readSetting('queryKind', 'friendCode') === 'qq' ? 'qq' : 'friendCode';
        const value = readSetting('queryValue', '') || readSetting('friendCode', '');
        this.targetSummary = summarizeTarget(kind, value) || '';

        const saved = readSetting('qrInput', '');
        if (!saved) {
          this.qrSummary = '未导入';
        } else {
          const payload = parseWahlapQrPayload(saved);
          if (!payload || !payload.content) this.qrSummary = '内容无法识别';
          else if (!payload.recognized) this.qrSummary = '已导入';
          else {
            const validity = describeValidity(payload);
            this.qrSummary = validity.state === 'valid' ? '有效' : '已过期';
          }
        }

        const items = [];
        if (showB50) items.push({ key: 'b50', title: 'Best 50' });
        if (showSearch) items.push({ key: 'search', title: '曲目搜索' });
        if (showQr) items.push({ key: 'qr', title: '二维码' });
        this.items = items;

        /*
         * 顶部卡片要先 warmUp 这个**动态键**。
         *
         * `store.readSetting` 只读内存，而内存只有 `warmUp()` 预热过的键；
         * `b50Cache:maimai:3687236844` 是拼出来的，固定列表里不可能有它。
         */
        const cacheKey = keys.b50CacheKey(game.id, value);
        warmUp(value ? [cacheKey] : []).then(() => {
          this.loadScoreCard(game.id, value);
        });
      } catch (error) {
        console.error('[ORhythm] Index refresh 失败：', error);
      }
    },

    loadScoreCard(gameId, code) {
      this.hasScore = false;
      this.ratingText = '';
      this.tier = '';
      this.statsText = '';
      if (!code) return;

      try {
        const raw = readSetting(keys.b50CacheKey(gameId, code), '');
        if (!raw) return;

        const view = JSON.parse(raw);
        const player = (view && view.player) || {};
        const stats = (view && view.stats) || {};

        const rating = Number(player.rating) || 0;
        if (rating <= 0) return;

        const oldCount = Number(stats.standardCount) || 0;
        const newCount = Number(stats.dxCount) || 0;
        const avg =
          typeof stats.averageLevelValue === 'number'
            ? stats.averageLevelValue.toFixed(2)
            : '';

        this.hasScore = true;
        this.ratingText = String(rating);
        this.tier = player.tier ? String(player.tier) : '';
        this.statsText = oldCount + ' 旧曲 ' + newCount + ' 新曲' + (avg ? ' ' + avg + ' 平均定数' : '');
      } catch (error) {
        this.hasScore = false;
      }
    },

    onGameCardTap() {
      if (this.hasScore) push('/b50');
      else push('/settings');
    },

    go(name) {
      push('/' + name);
    },

    goSettings() {
      push('/settings');
    },
  };
</script>
