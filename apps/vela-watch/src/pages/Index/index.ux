<template>
  <!--
    首页 · 小米 Watch（圆形 466×466）

    ── 为什么用 <scroll> 而不是 <list> ──────────────────────────────
    试过 `<list>` + `<list-item>`，实机上**整页空白**。
    对照下来两个可疑点：

      ① b50.ux 的 `<list-item>` 每一个都是**固定高度**（.row height: 82px），
         而我这几项高度各不相同（品牌/卡片/标题/入口/彩蛋）
      ② `<list>` 在 APILevel 2 上对 flex 高度的支持不可靠

    `<scroll>` 是 InputMethod 组件里实机验证过的写法：

        <scroll scroll-y="{{true}}" style="width:100%;height:100%">

    **必须给明确高度**，否则它会把父容器撑开（welcome.ux 里记过这个坑）。

    ── 圆屏几何 ─────────────────────────────────────────────────────
    可用宽度随高度剧变（实测 466 圆）：

        y=16  170px    y=60  312px    y=150  435px
        y=44  273px    y=100 383px    y=233  466px

    所以顶部只放居中的品牌字（约 120px，y=16 都放得下），
    越往下越宽，卡片保持方的，不跟弧度变形。
    滚到底用看板娘图填掉下方那块弧。

    ── 彩蛋 ─────────────────────────────────────────────────────────
    `/common/mascot.png` —— **团队真图做好后直接覆盖同名文件**，不用改代码。
    要求透明背景、内容居中留白（圆屏四角会被裁）。
  -->
  <div class="page-root">
    <scroll class="scroll" scroll-y="{{true}}">
      <div class="inner">
        <!-- 品牌：圆屏最窄处也只放这一行，居中 -->
        <text class="brand">ORhythm</text>

        <!-- 分数卡片。整块可点：有成绩去 Best 50，没成绩去设置 -->
        <div class="game" @click="onGameCardTap">
          <div class="game__head">
            <text class="game__name">{{ gameLabel }}</text>
            <text class="game__tier" if="{{ tier }}">{{ tier }}</text>
          </div>
          <text class="game__rating" if="{{ hasScore }}">{{ ratingText }}</text>
          <text class="game__rating-label" if="{{ hasScore }}">DX Rating</text>
          <text class="game__hint" if="{{ !hasScore }}">还没查过成绩 · 点此去设置</text>
          <text class="game__stats" if="{{ hasScore }}">{{ statsText }}</text>
        </div>

        <text class="section">快捷</text>

        <div class="item" for="{{ items }}" @click="go($item.key)">
          <text class="item__title">{{ $item.title }}</text>
          <text class="item__arrow">›</text>
        </div>

        <div class="item" @click="goSettings">
          <text class="item__title">设置</text>
          <text class="item__arrow">›</text>
        </div>

        <!-- 彩蛋：填掉圆形底部那块弧 -->
        <div class="egg">
          <image class="egg__art" src="/common/mascot.png"></image>
          <text class="egg__hint">ORhythm · NowMes Software</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<style lang="less">

  /*
   * 三层：page-root（撑满）→ scroll（明确高度）→ inner（内容列）
   *
   * ⚠️ Vela 的 div 默认是 `flex-direction: row`，每一层都要显式写 column，
   * 否则内容会被摆成横向一排。
   */
  .page-root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    background-color: #070b16;
  }

  /*
   * 滚动容器必须是明确高度。
   *
   * `height: 100%` 在这里能解析，因为父级 .page-root 有 height: 100%
   * 而再上一层是页面根节点（满屏）。InputMethod 里也是这么写的。
   */
  .scroll {
    width: 100%;
    height: 100%;
  }

  /* 内容列。左右 40px 给圆屏留白 —— 内容区 386px */
  .inner {
    flex-direction: column;
    width: 100%;
    padding: 34px 40px 40px;
  }

  /* ── 品牌 ──────────────────────────────────────────────────── */
  /* 顶部 34px：让品牌字中心落到 y≈60，那里可用宽度 312px，放 120px 很宽裕 */
  .brand {
    width: 100%;
    text-align: center;
    font-size: 32px;
    font-weight: bold;
    color: #ff5f9e;
    margin-bottom: 14px;
  }

  /* ── 分数卡片 ──────────────────────────────────────────────── */
  .game {
    flex-direction: column;
    width: 100%;
    padding: 16px 20px;
    border-radius: 20px;
    background-color: #223050;
  }

  .game__head {
    flex-direction: row;
    align-items: center;
  }

  .game__name {
    font-size: 26px;
    font-weight: bold;
    color: #e8eefc;
  }

  .game__tier {
    font-size: 15px;
    color: #e8eefc;
    opacity: 0.7;
    margin-left: 8px;
    padding: 2px 10px;
    border-radius: 999px;
    background-color: #1c2740;
  }

  .game__rating {
    font-size: 46px;
    font-weight: bold;
    color: #ff5f9e;
    margin-top: 4px;
  }

  .game__rating-label {
    font-size: 15px;
    color: #9bacd0;
    margin-top: -2px;
  }

  .game__stats {
    font-size: 13px;
    color: #9bacd0;
    margin-top: 8px;
  }

  .game__hint {
    font-size: 15px;
    color: #9bacd0;
    margin-top: 4px;
  }

  /* ── 快捷 ──────────────────────────────────────────────────── */
  .section {
    width: 100%;
    font-size: 15px;
    color: #9bacd0;
    margin-top: 18px;
    margin-bottom: 8px;
  }

  .item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 60px;
    padding: 0 20px;
    margin-bottom: 10px;
    border-radius: 20px;
    background-color: #141d30;
  }

  .item__title {
    font-size: 24px;
    color: #e8eefc;
  }

  .item__arrow {
    font-size: 26px;
    color: #6d7fa3;
  }

  /* ── 彩蛋 ──────────────────────────────────────────────────── */
  /* 高度 200px 盖住圆形底部那段弧；内容全居中，只放一行短文本 */
  .egg {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 200px;
    padding-bottom: 30px;
  }

  .egg__art {
    width: 96px;
    height: 96px;
    border-radius: 999px;
  }

  .egg__hint {
    font-size: 13px;
    color: #6d7fa3;
    margin-top: 10px;
    text-align: center;
  }
</style>

<script>
  // 首页不需要网络，刻意不 import api.js。
  const { core, diag, games, keys, navigation, store, validate } = global.AstraMai;
  const { describeValidity, parseWahlapQrPayload } = core;
  const { mark } = diag;
  const { gameById, gameHasFeature, readCurrentGame } = games;
  const { push } = navigation;
  const { readSetting, warmUp } = store;
  const { summarizeTarget } = validate;

  export default {
    private: {
      qrSummary: '未导入',
      targetSummary: '',
      gameLabel: '',
      items: [],
      /* ── 顶部分数卡片 ── */
      hasScore: false,
      ratingText: '',
      tier: '',
      statsText: '',
    },

    onReady() {
      mark('Index:onReady');
    },

    onInit() {
      mark('Index:onInit');
      warmUp(['qrInput', 'serverBase', 'queryKind', 'queryValue', 'friendCode', 'currentGame', 'oobeShown'])
        .then(() => {
          this.refresh();
          if (!readSetting('oobeShown', '')) push('/welcome');
        })
        .catch((error) => console.error('[ORhythm] Index 初始化失败：', error));
    },

    onShow() {
      this.refresh();
    },

    refresh() {
      try {
        const game = gameById(readCurrentGame(readSetting));
        this.gameLabel = game.label;

        const showB50 = gameHasFeature(game, 'b50');
        const showSearch = gameHasFeature(game, 'search');
        const showQr = gameHasFeature(game, 'qr');

        const kind = readSetting('queryKind', 'friendCode') === 'qq' ? 'qq' : 'friendCode';
        const value = readSetting('queryValue', '') || readSetting('friendCode', '');
        this.targetSummary = summarizeTarget(kind, value) || '';

        const saved = readSetting('qrInput', '');
        if (!saved) {
          this.qrSummary = '未导入';
        } else {
          const payload = parseWahlapQrPayload(saved);
          if (!payload || !payload.content) this.qrSummary = '内容无法识别';
          else if (!payload.recognized) this.qrSummary = '已导入';
          else {
            const validity = describeValidity(payload);
            this.qrSummary = validity.state === 'valid' ? '有效' : '已过期';
          }
        }

        const items = [];
        if (showB50) items.push({ key: 'b50', title: 'Best 50' });
        if (showSearch) items.push({ key: 'search', title: '曲目搜索' });
        if (showQr) items.push({ key: 'qr', title: '二维码' });
        this.items = items;

        /*
         * 顶部卡片要先 warmUp 这个**动态键**。
         *
         * `store.readSetting` 只读内存，而内存只有 `warmUp()` 预热过的键；
         * `b50Cache:maimai:3687236844` 是拼出来的，固定列表里不可能有它。
         */
        const cacheKey = keys.b50CacheKey(game.id, value);
        warmUp(value ? [cacheKey] : []).then(() => {
          this.loadScoreCard(game.id, value);
        });
      } catch (error) {
        console.error('[ORhythm] Index refresh 失败：', error);
      }
    },

    loadScoreCard(gameId, code) {
      this.hasScore = false;
      this.ratingText = '';
      this.tier = '';
      this.statsText = '';
      if (!code) return;

      try {
        const raw = readSetting(keys.b50CacheKey(gameId, code), '');
        if (!raw) return;

        const view = JSON.parse(raw);
        const player = (view && view.player) || {};
        const stats = (view && view.stats) || {};

        const rating = Number(player.rating) || 0;
        if (rating <= 0) return;

        const oldCount = Number(stats.standardCount) || 0;
        const newCount = Number(stats.dxCount) || 0;
        const avg =
          typeof stats.averageLevelValue === 'number'
            ? stats.averageLevelValue.toFixed(2)
            : '';

        this.hasScore = true;
        this.ratingText = String(rating);
        this.tier = player.tier ? String(player.tier) : '';
        this.statsText = oldCount + ' 旧曲 ' + newCount + ' 新曲' + (avg ? ' ' + avg + ' 平均定数' : '');
      } catch (error) {
        this.hasScore = false;
      }
    },

    onGameCardTap() {
      if (this.hasScore) push('/b50');
      else push('/settings');
    },

    go(name) {
      push('/' + name);
    },

    goSettings() {
      push('/settings');
    },
  };
</script>
