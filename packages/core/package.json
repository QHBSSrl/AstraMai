{
  "name": "@astramai/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AstraMai 核心层：落雪 API 类型、DX Rating 计算、B50 组装。零运行时依赖，可移植到 Vela QuickApp。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.6.3"
  }
}
