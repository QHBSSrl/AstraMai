# ── 落雪查分器对接配置 ────────────────────────────────────────────────
# 复制本文件为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交真实密钥。

# 开发者 API 密钥（落雪「开发者面板」申请所得）。
# 请求时会以 `Authorization: <key>` 头发送，仅保存在服务端，不会下发到浏览器。
LXNS_API_KEY=

# 数据模式：
#   auto  —— 有密钥走 live，没有则自动降级为 mock（默认）
#   live  —— 强制真实接口，缺少密钥直接报错
#   mock  —— 强制模拟数据（曲库仍来自落雪公共接口，真实无需鉴权）
LXNS_MODE=auto

# 服务端监听端口
PORT=8787
HOST=127.0.0.1

# ── 访问门禁 ──────────────────────────────────────────────────────────
# 共享访问令牌。**一旦要把服务暴露到公网（例如通过 frp），必须设置**，
# 否则任何知道地址的人都能拿你的落雪密钥和配额查分。
# 客户端用 Authorization 或 X-API-Key 头带上同样的值。
API_TOKEN=

# 每个来源 IP 每分钟允许的请求数；0 表示不限流
RATE_LIMIT_PER_MINUTE=120

# 是否允许浏览器在页面上临时填入开发者密钥（仅建议本地测试站开启）
ALLOW_CLIENT_KEY=true

# 曲库缓存时长（秒）
SONG_CACHE_TTL=21600
